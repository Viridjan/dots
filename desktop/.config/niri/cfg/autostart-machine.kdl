// Main workspace
spawn-at-startup "thunderbird"

// Social workspace
spawn-sh-at-startup "steam"

// Media workspace
spawn-at-startup "kitty" "--title" "dgop-monitor" "-e" "dgop"
spawn-at-startup "kitty" "--title" "spotify-player" "-e" "spotify_player"
spawn-at-startup "alacritty" "--title" "gomuks" "-e" "gomuks"

// Background daemons
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-at-startup "udiskie"
