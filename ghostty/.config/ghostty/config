# ────────────── Ghostty Terminal Configuration ──────────────
# Full reference: ghostty +help  or  man 5 ghostty

# ── Font ──────────────────────────────────────────────────────────────────────

# Font size in points. Fractional sizes are allowed (e.g. 11.5).
font-size = 12

# To set a specific font family (must be installed):
# font-family = "JetBrains Mono"
# font-family-bold = "JetBrains Mono"
# font-family-italic = "JetBrains Mono"

# ── Window ────────────────────────────────────────────────────────────────────

# Disable OS window decorations (title bar, borders). Niri draws its own.
# Set to true if you want a native title bar.
window-decoration = false

# Inner padding in pixels (horizontal and vertical independently).
window-padding-x = 12
window-padding-y = 12

# Background opacity: 0.0 = fully transparent, 1.0 = fully opaque.
# Values below 1.0 require a Wayland compositor with blur support.
background-opacity = 0.85

# Blur radius for the transparent background. Higher = softer blur.
# 0 disables blur. Requires compositor support (niri supports this).
background-blur-radius = 32

# ── Cursor ────────────────────────────────────────────────────────────────────

# Cursor shape: block | bar | underline
cursor-style = block

# Whether the cursor blinks. true | false
cursor-style-blink = true

# ── Scrollback ────────────────────────────────────────────────────────────────

# Number of lines to keep in the scrollback buffer.
# 0 = unlimited (uses unlimited memory — use with care).
scrollback-limit = 3023

# ── Terminal Behaviour ────────────────────────────────────────────────────────

# Hide the mouse cursor while typing. Reappears on mouse movement.
mouse-hide-while-typing = true

# Automatically copy selected text to the clipboard. false = copy only on Ctrl+C.
copy-on-select = false

# Ask for confirmation before closing a tab or window that has a running process.
confirm-close-surface = false

# ── Notifications ─────────────────────────────────────────────────────────────

# Suppress specific in-app notifications. Comma-separated list.
# no-clipboard-copy  — suppress "Copied to clipboard" toast.
# no-config-reload   — suppress "Config reloaded" toast.
app-notifications = no-clipboard-copy,no-config-reload

# ── Keybindings ───────────────────────────────────────────────────────────────
# Format: keybind = <modifier+key>=<action>
# Common actions: copy_to_clipboard, paste_from_clipboard, new_window, new_tab,
#   new_split:right, new_split:down, close_surface, increase_font_size:<N>,
#   decrease_font_size:<N>, reset_font_size, toggle_fullscreen, quit

keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ── Splits ────────────────────────────────────────────────────────────────────

# Opacity of the inactive (unfocused) split pane: 0.0–1.0.
unfocused-split-opacity = 0.7

# Background fill color for inactive splits (shown through the opacity).
unfocused-split-fill = #44464f

# ── GTK / Window Chrome ───────────────────────────────────────────────────────

# Show the GTK native tab bar / title bar. false = use Ghostty's own chrome.
gtk-titlebar = false

# ── Shell Integration ─────────────────────────────────────────────────────────

# Automatically detect the running shell and inject integration hooks.
# Values: detect | fish | bash | zsh | none
shell-integration = detect

# Features to enable as part of shell integration. Comma-separated list.
# cursor      — change cursor shape based on shell mode (insert vs. normal).
# sudo        — preserve shell integration when running sudo.
# title       — set the window title to the current command / directory.
# no-cursor   — disable the shell-driven cursor override specifically.
shell-integration-features = cursor,sudo,title,no-cursor

# Send a literal newline when Shift+Enter is pressed (useful in some REPLs).
keybind = shift+enter=text:\n

# ── Instance Management ───────────────────────────────────────────────────────

# Run as a single process. New `ghostty` invocations open a window in the
# existing instance instead of starting a new process. Faster and lighter.
gtk-single-instance = true

# ── Theme ─────────────────────────────────────────────────────────────────────

# Color theme. Looks in ~/.config/ghostty/themes/<name> first, then built-ins.
# Run `ghostty +list-themes` to see all available themes.
# DMS regenerates the dankcolors theme automatically via `dms matugen`.
theme = dankcolors
