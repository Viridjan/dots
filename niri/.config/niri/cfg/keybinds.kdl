// ────────────── Keybindings ──────────────
/*
https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings
https://docs.noctalia.dev/getting-started/keybinds/

Keys consist of modifiers separated by + signs, followed by an XKB key name
in the end. To find an XKB name for a particular key, you may use a program
like wev.

"Mod" is a special modifier equal to Super when running on a TTY, and to Alt
when running as a winit window.

Most actions that you can bind here can also be invoked programmatically with
`niri msg action do-something`.

Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.
Note: the entire command goes as a single argument. It's passed verbatim to `sh -c`.
For example, this is a standard bind to toggle the screen reader (orca).

Per-bind attributes:
  hotkey-overlay-title="..." — label shown in the hotkey overlay (Mod+Shift+Escape).
  repeat=false               — do not fire repeatedly while the key is held down.
  allow-when-locked=true     — fire even while the screen is locked.
  allow-inhibiting=false     — fire even when a fullscreen app has inhibited shortcuts.
*/


binds {

	// ─── noctalia-shell keybinds ───
	Mod+Shift+Escape			{ show-hotkey-overlay; }

	// ─── Applications ───
	Mod+Return					hotkey-overlay-title="Open Terminal" { spawn "alacritty"; }
	Mod+Space					hotkey-overlay-title="Open App Launcher" { spawn "dms" "ipc" "spotlight" "toggle"; }
	Mod+E						hotkey-overlay-title="File Manager" { spawn "dolphin"; }
	Mod+B						hotkey-overlay-title="Open Browser" { spawn "brave-browser"; }
	Mod+Alt+L					hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "lock" "lock"; }
	Mod+Shift+Q					hotkey-overlay-title="Session Menu" { spawn "dms" "ipc" "powermenu" "toggle"; }

	// ─── Window Movement and Focus ───
	Mod+Q						repeat=false { close-window; }

	Mod+Left					{ focus-column-left; }
	Mod+Right					{ focus-column-right; }
	Mod+Up						{ focus-window-up; }
	Mod+Down					{ focus-window-down; }

	Mod+Ctrl+Left				{ move-column-left; }
	Mod+Ctrl+Right				{ move-column-right; }
	Mod+Ctrl+Up					{ move-window-up-or-to-workspace-up; }
	Mod+Ctrl+Down				{ move-window-down-or-to-workspace-down; }

	Mod+Home					{ focus-column-first; }
	Mod+End						{ focus-column-last; }
	Mod+Ctrl+Home				{ move-column-to-first; }
	Mod+Ctrl+End				{ move-column-to-last; }

	/*
	Move focus or windows across monitors.
	Requires a multi-monitor setup; monitor positions must be configured in outputs.
	*/
	Mod+Shift+Left				{ focus-monitor-left; }
	Mod+Shift+Right				{ focus-monitor-right; }
	Mod+Shift+Up				{ focus-monitor-up; }
	Mod+Shift+Down				{ focus-monitor-down; }

	// Mod+Shift+Ctrl+Left			{ move-column-to-monitor-left; }
	// Mod+Shift+Ctrl+Right			{ move-column-to-monitor-right; }
	// Mod+Shift+Ctrl+Up			{ move-column-to-monitor-up; }
	// Mod+Shift+Ctrl+Down			{ move-column-to-monitor-down; }

	// ─── Workspace Switching ───
	Mod+1						{ focus-workspace 1; }
	Mod+2						{ focus-workspace 2; }
	Mod+3						{ focus-workspace 3; }
	Mod+4						{ focus-workspace 4; }
	Mod+5						{ focus-workspace 5; }
	Mod+6						{ focus-workspace 6; }
	Mod+7						{ focus-workspace 7; }
	Mod+8						{ focus-workspace 8; }
	Mod+9						{ focus-workspace 9; }

	/* Move the focused column (with its windows) to a numbered workspace. */
	Mod+Ctrl+1					{ move-column-to-workspace 1; }
	Mod+Ctrl+2					{ move-column-to-workspace 2; }
	Mod+Ctrl+3					{ move-column-to-workspace 3; }
	Mod+Ctrl+4					{ move-column-to-workspace 4; }
	Mod+Ctrl+5					{ move-column-to-workspace 5; }
	Mod+Ctrl+6					{ move-column-to-workspace 6; }
	Mod+Ctrl+7					{ move-column-to-workspace 7; }
	Mod+Ctrl+8					{ move-column-to-workspace 8; }
	Mod+Ctrl+9					{ move-column-to-workspace 9; }

	/* Jump back to the previously focused workspace (like Alt+Tab for workspaces). */
	Mod+TAB						{ focus-workspace-previous; }

	/*
	The following binds move the focused window in and out of a column.
	If the window is alone, they will consume it into the nearby column to the side.
	If the window is already in a column, they will expel it out.
	*/
	// Mod+BracketLeft  { consume-or-expel-window-left; }
	// Mod+BracketRight { consume-or-expel-window-right; }

	/* Consume one window from the right to the bottom of the focused column. */
	// Mod+Comma  { consume-window-into-column; }
	/* Expel the bottom window from the focused column to the right. */
	// Mod+Period { expel-window-from-column; }

	/* Cycling through the presets. */
	// Mod+R { switch-preset-column-width; }
	// Mod+R { switch-preset-column-width-back; }
	// Mod+Shift+R { switch-preset-window-height; }
	// Mod+Ctrl+R { reset-window-height; }

	/* Center all fully visible columns on screen. */
	// Mod+Ctrl+C { center-visible-columns; }

	// ─── Layout Controls ───
	// Mod+Ctrl+F					{ expand-column-to-available-width; }
	// Mod+C						{ center-column; }
	// Mod+Ctrl+C					{ center-visible-columns; }

	/* Resize the focused column by 10% increments. */
	Mod+Minus					{ set-column-width "-10%"; }
	Mod+Equal					{ set-column-width "+10%"; }

	/* Resize the focused window's height by 10% increments within a column. */
	Mod+Shift+Minus				{ set-window-height "-10%"; }
	Mod+Shift+Equal				{ set-window-height "+10%"; }

	// ─── Modes ───
	/* Toggle the focused window between tiled and floating. */
	Mod+T						{ toggle-window-floating; }

	/* Expand the focused column to fill the monitor width (keeps gaps/borders). */
	Mod+F						{ maximize-column; }

	/* True fullscreen — window fills the entire screen, no gaps or borders. */
	Mod+Shift+F					{ fullscreen-window; }

	/* Expand the focused column to space not taken up by other fully visible columns. */
	// Mod+Ctrl+F { expand-column-to-available-width; }

	/*
	While maximize-column leaves gaps and borders around the window,
	maximize-window-to-edges doesn't: the window expands to the edges of the screen.
	This bind corresponds to normal window maximizing,
	e.g. by double-clicking on the titlebar.
	*/
	// Mod+M { maximize-window-to-edges; }

	/* Group the windows in the focused column into tabs (stacked display). */
	Mod+W						{ toggle-column-tabbed-display; }

	// ─── Screenshots ───
	/* Interactive region screenshot — select area, saves to ~/Pictures/Screenshots/. */
	Print						{ screenshot; }

	/* Capture the entire screen immediately. */
	Ctrl+Print					{ screenshot-screen; }

	/* Capture only the focused window. */
	Shift+Print					{ screenshot-window; }

	// ─── Emergency Escape Key ───
	/*
	Use this when a fullscreen app blocks your keybinds.
	It disables any active keyboard shortcut inhibitor, restoring control.
	*/
	Mod+Escape					allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

	// ─── Exit / Power ───
	CTRL+ALT+Delete				{ quit; } // Also quits Niri
	// Mod+Shift+P					{ power-off-monitors; } // Turn off screens (useful for OLED or privacy)

	/* Toggle the overview (bird's-eye view of all workspaces). */
	Mod+O						repeat=false { toggle-overview; }

	// ─── Media Controls ───
	/*
	`dms ipc audio` controls the default audio sink via DMS.
	`allow-when-locked=true` lets these fire even on the lock screen.
	*/
	XF86AudioRaiseVolume		allow-when-locked=true { spawn "dms" "ipc" "audio" "increment" "5"; }
	XF86AudioLowerVolume		allow-when-locked=true { spawn "dms" "ipc" "audio" "decrement" "5"; }
	XF86AudioMute				allow-when-locked=true { spawn "dms" "ipc" "audio" "mute"; }
	XF86AudioMicMute			allow-when-locked=true { spawn "dms" "ipc" "audio" "micmute"; }

	/* playerctl targets spotify_player directly to avoid DMS picking Brave/WhatSie when paused. */
	XF86AudioNext				allow-when-locked=true { spawn "playerctl" "--player=spotify_player" "next"; }
	XF86AudioPrev				allow-when-locked=true { spawn "playerctl" "--player=spotify_player" "previous"; }
	XF86AudioPlay				allow-when-locked=true { spawn "playerctl" "--player=spotify_player" "play-pause"; }
	XF86AudioPause				allow-when-locked=true { spawn "playerctl" "--player=spotify_player" "play-pause"; }

	// ─── Brightness Controls ───
	/* `dms ipc brightness` adjusts backlight via DMS (uses brightnessctl or similar). */
	XF86MonBrightnessUp			allow-when-locked=true { spawn "dms" "ipc" "brightness" "increment" "5" ""; }
	XF86MonBrightnessDown		allow-when-locked=true { spawn "dms" "ipc" "brightness" "decrement" "5" ""; }

	// ─── Gaming: keyboard shortcut inhibit ───
	/* Toggle shortcut inhibition — when active, all keys pass through to the focused app (e.g. games).
	   allow-inhibiting=false ensures this bind always works, even while inhibiting is active. */
	Mod+Escape	allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
