// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

// Named workspaces — these persist even when empty, so apps that open on them
// always find a workspace ready. Without a name, workspaces are created and
// destroyed dynamically as windows open/close.
// Optionally assign a static index: workspace "social" { idx 1 }
workspace "social"
workspace "media"

// Spawn processes at startup. Two variants:
//
//   spawn-at-startup "cmd" "arg1" "arg2"
//     Runs the command directly via execvp — fastest, no shell overhead.
//     Use this for apps that don't need shell features.
//
//   spawn-sh-at-startup "shell command here"
//     Runs via sh -c, so you can use pipes, redirection, env vars, etc.
//     Slightly slower due to shell startup.
//
// Note: running niri as a session supports xdg-desktop-autostart
// (~/.config/autostart/*.desktop), which may be more convenient for
// apps that already have desktop entries.

// spawn-at-startup "waybar" // waybar — a popular Wayland status bar

// Social apps — open on the "social" workspace (see rules.kdl).
// spawn-sh used here so shell PATH resolution picks up the command.
spawn-sh-at-startup "Discord"
spawn-sh-at-startup "Steam"

// Media apps — open on the "media" workspace (see rules.kdl).
spawn-at-startup "Spotify"
spawn-at-startup "whatsie"
spawn-at-startup "Telegram"

// spawn-sh-at-startup "/usr/lib/polkit-kde-authentication-agent-1 &" // Polkit

// hotkey-overlay and screenshot-path are set in misc.kdl
