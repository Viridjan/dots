// ────────────── Window Rules ──────────────
/*
Window rules let you adjust behavior for individual windows.
Find more information on the wiki:
https://niri-wm.github.io/niri/Configuration:-Window-Rules

Matching:
  match app-id="regex"   — matches the window's app-id (Wayland) or WM_CLASS (XWayland).
  match title="regex"    — matches the window title. Both support full regex syntax.
  match is-active=true   — only match the currently active (focused) window.
  match is-floating=true — only match floating windows.
  match at-startup=true  — only apply when the window first opens at niri startup.
  Multiple match lines in the same rule are OR'd (any one match is enough).

Rules apply in order — later rules override earlier ones for the same property.
*/

/*
Global rule — applies to every window.
geometry-corner-radius rounds the corners of all windows (in logical pixels).
clip-to-geometry clips window content to the rounded shape (prevents sharp corners bleeding through).
default-column-width {} lets each app decide its own initial width (overridden per-app below).
open-floating false ensures windows open tiled by default unless a more specific rule says otherwise.
*/
window-rule {
	geometry-corner-radius 15
	clip-to-geometry true
	open-floating false
}

// Thunderbird — opens on main workspace (workspace 1), doesn't steal focus.
window-rule {
	match app-id="thunderbird"
	open-on-workspace "main"
	open-focused false
	default-column-width { proportion 0.5; }
}

/*
Social workspace — Discord and Ferdium open on the "social" workspace automatically.
open-focused false prevents them from stealing focus when they open at startup.
*/
window-rule {
	match title="Ferdium"
	match title="Discord"
	open-on-workspace "social"
	open-focused false
	default-column-width { proportion 0.5; }
}

/*
Media workspace — Spotify, Steam, and Dota 2 open on the "media" workspace.
open-focused false keeps the focus on whatever you were doing when they launch.
*/
window-rule {
	match app-id="Spotify"
	match title="Steam"
	match app-id="BambuStudio"
	open-on-workspace "media"
	open-focused false
	default-column-width { proportion 0.5; }
}

// dgop system monitor — opens on media workspace at 75% width.
window-rule {
	match title="dgop-monitor"
	open-on-workspace "media"
	open-focused false
	default-column-width { proportion 0.75; }
}

// spotify-player TUI — opens on media workspace at 50% width.
window-rule {
	match title="spotify-player"
	open-on-workspace "media"
	open-focused false
	default-column-width { proportion 0.5; }
}

/*
Common apps — default to half the monitor width.
app-id is used where apps set it reliably (GTK/Qt apps on Wayland);
title is used as fallback for XWayland apps that don't set app-id.
*/
window-rule {
	match title="Brave"
	match app-id="brave-browser"
	match title="Kitty"
	default-column-width { proportion 0.5; }
}

// Narrow apps — terminal clients open at 30% width.
window-rule {
	match app-id="Alacritty"
	default-column-width { proportion 0.3; }
}

// gomuks — Matrix TUI, slightly wider for chat readability.
window-rule {
	match app-id="Alacritty" title="^gomuks$"
	default-column-width { proportion 0.4; }
}

// Vesktop — 40% width. Workspace placement still comes from the social rule above.
window-rule {
	match app-id="vesktop"
	match title="Vesktop"
	default-column-width { proportion 0.4; }
}

// Steam games — all apps launched from Steam open on media workspace, fullscreen.
// variable-refresh-rate reduces tearing/stutter under niri's compositor fullscreen (no exclusive mode).
// Matches XWayland games (WM_CLASS = steam_app_NNNN). Native Wayland games set their
// OWN app-id (the game name) and are matched in the rule below instead.
window-rule {
	match app-id="^steam_app_"
	open-on-workspace "media"
	open-focused true
	open-fullscreen true
	variable-refresh-rate true
}

// Native Wayland games — set their own app-id (game name), NOT steam_app_NNNN, so the
// rule above never matches them. niri can't regex-detect "is a game" generically, so
// list each one here. Find a game's app-id with: niri msg windows | grep -A1 Title
// Universal fallback for anything not listed: focus the window, press Mod+Shift+F.
window-rule {
	match app-id="^Slay the Spire 2$"
	open-on-workspace "media"
	open-focused true
	open-fullscreen true
	variable-refresh-rate true
}

// LibreOffice — every component (writer/calc/impress/...) opens at 50% width.
window-rule {
	match app-id="libreoffice"
	default-column-width { proportion 0.5; }
}

/*
Layer rule for the noctalia wallpaper layer.
place-within-backdrop renders it behind all windows but above the desktop background.
The namespace regex matches the layer surface name set by noctalia-wallpaper.
*/
layer-rule {
	match namespace="^noctalia-wallpaper*"
	place-within-backdrop true
}


/* The following is a list of all option available for window rules. */
