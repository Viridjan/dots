// ────────────── Animation Settings ──────────────
/*
The wiki explains how to configure individual animations:
https://niri-wm.github.io/niri/Configuration:-Animations

Each animation can use one of two drivers:

  spring — physics-based, duration emerges from the parameters.
    damping-ratio: 1.0 = critically damped (no bounce, fastest settle).
                   < 1.0 = underdamped (bouncy). > 1.0 = overdamped (sluggish).
    stiffness:     higher = faster / snappier. lower = slower / floatier.
    epsilon:       threshold at which the spring is considered done (smaller = more precise).

  easing — fixed-duration curve-based animation.
    duration-ms <N>  how long the animation lasts.
    curve "<name>"   shape of the easing. Available curves:
                       linear, ease, ease-in, ease-out, ease-in-out,
                       ease-in-quad, ease-out-quad, ease-in-cubic, ease-out-cubic,
                       ease-in-expo, ease-out-expo, ease-in-back, ease-out-back

To disable a specific animation entirely, add `off` inside its block.
To disable all animations at once, add `animations { off }` (single line).
*/

animations {

	/*
	Triggered when switching between workspaces (Mod+1-9 or swipe gesture).
	Spring works well here — gives a snappy but smooth lateral slide.
	*/
	workspace-switch {
		spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
	}

	/*
	Triggered when a new window opens.
	Easing with ease-out curves gives a natural "pop in" feel.
	*/
	window-open {
		duration-ms 200
		curve "ease-out-quad"
	}

	/*
	Triggered when a window closes.
	*/
	window-close {
		duration-ms 200
		curve "ease-out-cubic"
	}

	/*
	Triggered when the view scrolls horizontally within a workspace
	(e.g. focusing a column that's off-screen, or moving columns).
	*/
	horizontal-view-movement {
		spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
	}

	/*
	Triggered when a window is moved within or between columns.
	*/
	window-movement {
		spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
	}

	/*
	Triggered when a window is resized (including column width changes).
	*/
	window-resize {
		spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
	}

	/*
	Triggered when the config-reloaded notification slides in/out.
	Lower damping-ratio gives a slight bounce that draws the eye.
	*/
	config-notification-open-close {
		spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
	}

	/*
	Triggered when the screenshot selection UI appears.
	*/
	screenshot-ui-open {
		duration-ms 300
		curve "ease-out-quad"
	}

	/*
	Triggered when the overview (Mod+O) opens or closes.
	*/
	overview-open-close {
		spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
	}
}
