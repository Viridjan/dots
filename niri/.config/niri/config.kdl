// ────────────── Niri Main Config ──────────────
/*
This is the entry point. It uses `include` to load modular config files.
Edit the individual files under cfg/ for your settings — do not put
settings directly here.

cfg/ files are stow-managed (committed to ~/dots) and safe to edit.
dms/ files are auto-generated by DankMaterialShell — do not edit manually;
use `dms config` or `dms setup` instead.

Include order matters: later files can override settings from earlier ones.
*/

/* ── User config ── */
include "cfg/autostart.kdl"
include "cfg/keybinds.kdl"
include "cfg/input.kdl"
// cfg/display.kdl is commented out because dms/outputs.kdl overrides it
// with the full 3440x1440@165Hz + VRR config generated by DMS.
// Uncomment and disable dms/outputs.kdl if you want to manage outputs manually.
//include "cfg/display.kdl"
include "cfg/layout.kdl"
include "cfg/rules.kdl"
include "cfg/misc.kdl"

/* ── DankMaterialShell overrides ── */
// dms/colors.kdl sets focus-ring and border colors from the Material theme.
include "dms/colors.kdl"
// dms/layout.kdl overrides gaps and border width — commented out to use cfg/layout.kdl values.
include "dms/layout.kdl"
include "dms/alttab.kdl"
include "dms/outputs.kdl"
include "dms/cursor.kdl"

include "dms/windowrules.kdl"
// dms/binds.kdl is included last so its keybinds take precedence over cfg/keybinds.kdl
// where there are conflicts (e.g. DMS system shortcuts).
include "dms/binds.kdl"
