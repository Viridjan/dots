#!/usr/bin/env bash
# ponytail: block commits on shellcheck ERRORS only; style noise stays advisory.
# No-op when shellcheck is absent so a fresh clone can still commit.
command -v shellcheck >/dev/null || exit 0

files=()
while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    # Match by shebang, not path, so non-shell files (Python, KDL, binaries)
    # are never fed to shellcheck.
    # head -c bounds the read so a multi-MB binary is never slurped; tr strips
    # NULs so command substitution doesn't warn on every binary file staged.
    case "$(head -c 64 "$f" 2>/dev/null | tr -d '\0' | head -1)" in
        '#!'*bash*|'#!'*sh) files+=("$f") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM)

[[ ${#files[@]} -eq 0 ]] && exit 0
shellcheck -S error "${files[@]}"
