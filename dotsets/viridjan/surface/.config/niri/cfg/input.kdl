// ────────────── Surface Pro 9 Input ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input
// Optimised for Surface Pro 9: Type Cover, touchscreen, and Surface Pen.

input {
    keyboard {
        xkb {
            layout "us"
            variant "intl"
        }
        // numlock off — no numpad on Type Cover
    }

    touchpad {
        tap
        dwt                          // disable while typing
        natural-scroll
        scroll-method "two-finger"
        accel-speed 0.1
    }

    // Map touchscreen events to the internal display
    touch {
        map-to-output "eDP-1"
    }

    // Surface Pen (Wacom protocol tablet)
    tablet {
        map-to-output "eDP-1"
    }

    // No mouse{} block: `natural-scroll` is a bare flag node and takes no
    // argument, so `natural-scroll false` is a parse error, not an "off"
    // switch — it aborted the whole surface config. Omitting it is how you
    // get natural scrolling off, which is already the default.
}
