[Unit]
Description=Stoatcord: Discord <-> Stoat message bridge (~/Projects/stoatcord-bot)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/stoatcord-bot
# Tokens live here (chmod 600, not in git); until both are filled in the unit is skipped, not failed.
ExecCondition=/bin/sh -c 'grep -q "^DISCORD_TOKEN=." %h/.config/stoatcord/env && grep -q "^STOAT_TOKEN=." %h/.config/stoatcord/env'
EnvironmentFile=-%h/.config/stoatcord/env
Environment=DB_PATH=%h/.local/share/stoatcord/stoatcord.db
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/stoatcord
# Deps pinned by the local bun.lock (upstream's is stale; --production would force it frozen); '-' so a boot without network still starts with the installed ones.
ExecStartPre=-/usr/bin/bun install
ExecStart=/usr/bin/bun src/index.ts
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
