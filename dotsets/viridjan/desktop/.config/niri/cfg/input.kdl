// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

input {
	keyboard {
		xkb {
			/*
			You can set rules, model, layout, variant and options.
			For example:
			layout "us,ru"
			options "grp:win_space_toggle,compose:ralt,ctrl:nocaps"
			If this section is empty, niri will fetch xkb settings
			from org.freedesktop.locale1. You can control these using
			localectl set-x11-keymap.
			*/
			layout "us" // Use the American keyboard layout

			/*
			Keyboard variant — selects a sub-variant of the layout.
			Common variants for "us":
			  (empty)    — standard US layout
			  "intl"     — US International: dead keys for accented characters.
			               ' + e = é, " + u = ü, ` + a = à, ~ + n = ñ, etc.
			               Apostrophe becomes a dead key; type ' + Space for a plain '.
			  "alt-intl" — like "intl" but dead keys are on AltGr combos,
			               so the apostrophe always types immediately.
			  "dvorak"   — Dvorak layout
			  "colemak"  — Colemak layout
			  "mac"      — macOS-style US layout
			Run `localectl list-x11-keymap-variants us` to see all available variants.
			*/
			variant "intl"

			/*
			XKB options — comma-separated list of extra tweaks.
			Common examples:
			  compose:ralt        — Right Alt as Compose key (universal accent input)
			  compose:menu        — Menu key as Compose key
			  ctrl:nocaps         — CapsLock becomes Ctrl
			  ctrl:swapcaps       — Swap CapsLock and Ctrl
			  grp:win_space_toggle — Super+Space switches layout group
			  grp:alt_shift_toggle — Alt+Shift switches layout group
			*/
			// options "compose:ralt"
		}

		/* Enable numlock on startup, omitting this setting disables it. */
        numlock
    }

	/*
	Next sections include libinput settings.
	Omitting settings disables them, or leaves them at their default values.
	All commented-out settings here are examples, not defaults.
	*/
	touchpad {
		// off
		tap /* Enable tap-to-click */
		// dwt
		// dwtp
		// drag false
		// drag-lock
		natural-scroll /* Enable natural (macOS-style) scrolling */
		// accel-speed 0.2
		// accel-profile "flat"
		// scroll-method "two-finger"
		// disabled-on-external-mouse
	}

	mouse {
		// off
		// natural-scroll
		// accel-speed 0.2
		// accel-profile "flat"
		// scroll-method "no-scroll"
	}

	trackpoint {
		// off
		// natural-scroll
		// accel-speed 0.2
		// accel-profile "flat"
		// scroll-method "on-button-down"
		// scroll-button 273
		// scroll-button-lock
		// middle-emulation
	}

	/* Uncomment this to make the mouse warp to the center of newly focused windows. */
	// warp-mouse-to-focus

	/*
	Focus windows and outputs automatically when moving the mouse into them.
	Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
	focus-follows-mouse max-scroll-amount="0%"
	*/
	// focus-follows-mouse

	/* Enable workspace back & forth switching */
	// workspace-auto-back-and-forth
}
