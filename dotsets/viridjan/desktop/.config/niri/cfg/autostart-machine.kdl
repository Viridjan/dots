// Social workspace
spawn-at-startup "thunderbird"
spawn-at-startup "whatsie"
spawn-at-startup "Telegram"

// Media workspace
spawn-sh-at-startup "steam"
spawn-at-startup "alacritty" "--title" "dgop-monitor" "-e" "dgop"
spawn-sh-at-startup "flatpak run com.spotify.Client"

// Background daemons
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "wl-paste --watch cliphist store"
spawn-at-startup "udiskie"

// Force VRR off explicitly at session start. cfg/display.kdl omits the
// variable-refresh-rate node entirely (should default to off), but DMS's
// NiriService can push its own `niri msg output ... vrr ...` IPC commands
// independent of any KDL file (see NiriService.qml ~line 1403) — so this
// is belt-and-suspenders against anything re-enabling it live. This
// monitor flickers under VRR even on-demand — see cfg/display.kdl,
// 2026-08-25.
spawn-sh-at-startup "sleep 2 && niri msg output DP-1 vrr off"
