# qwen3.5 under its own name with a VRAM cap. Built over the official tag;
# setup_ollama re-applies it after every pull.
# 33 layers (~5.6 GB): 26 on GPU keeps it inside ~40% of the 12 GB VRAM, the
# rest runs on CPU (slower, ~under CPUQuota). ollama 0.40 ignores
# OLLAMA_GPU_OVERHEAD, so the cap has to be per model.
FROM qwen3.5
PARAMETER num_gpu 26
