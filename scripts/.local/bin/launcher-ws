#!/usr/bin/env bash
# Apps started from the DMS launcher (Mod+Space) open on the workspace where
# Mod+Space was pressed, even if you switched away while they loaded. Apps with
# an open-on-workspace rule (social/media/games) keep their own workspace.
# Opened that way (launcher or a shortcut), a terminal or browser also takes focus;
# everything else, and anything opened by scripts, follows niri's open-focused false.
#   launcher-ws                          remember the workspace, then toggle the launcher (Mod+Space)
#   launcher-ws run [--app-id RE] CMD…   same for a shortcut; with --app-id, an already-open
#                                        match means CMD only focuses it (nirius): no record
#   launcher-ws watch                    session daemon (config.kdl spawn-at-startup)
# The daemon also sends apps started by Claude Code or Codex to the workspace of the
# terminal the agent runs in, unfocused (rules included: the agent's workspace wins).
set -u
REC="${XDG_RUNTIME_DIR:-/tmp}/launcher-ws"
PROC=${LAUNCHER_WS_PROC:-/proc}   # override: tests
MAX_AGE=${LAUNCHER_WS_MAX_AGE:-60}   # seconds: a later window is not the launched app

_focused_ws() { niri msg --json workspaces | jq -r '.[] | select(.is_focused) | .id'; }

FOCUS_APPS='^(Alacritty|brave-.*)$'   # opened by you: take focus

_record() { printf '%s %s\n' "$(_focused_ws)" "$(date +%s)" >"$REC"; }

case "${1:-}" in
    watch) ;;
    run)
        shift
        if [[ "${1:-}" == --app-id ]]; then
            niri msg --json windows | jq -e --arg re "$2" 'any(.[]; (.app_id // "") | test($re))' >/dev/null \
                || _record
            shift 2
        else
            _record
        fi
        exec "$@" ;;
    *) _record; exec dms ipc call spotlight toggle ;;
esac

# Move window $1 to workspace id $2 without focusing it.
# shortcut: moves by the workspace's index, correct on one output only (every profile
# has one); multi-monitor needs a per-output reference.
_move() {
    local idx
    idx=$(niri msg --json workspaces | jq -r --argjson w "$2" '.[] | select(.id == $w) | .idx')
    [[ -n "$idx" ]] && niri msg action move-window-to-workspace --window-id "$1" --focus false "$idx"
}

_parent() { awk '/^PPid:/ {print $2}' "$PROC/$1/status" 2>/dev/null; }

# Real pids of a window (same as quiver-games): XWayland windows report
# xwayland-satellite's pid to niri, so ask X for _NET_WM_PID by class instead.
_pids() {
    local pid="$1" app="$2" w
    if [[ "$(cat "$PROC/$pid/comm" 2>/dev/null)" != xwayland-satell* ]]; then
        echo "$pid"; return
    fi
    for w in $(xdotool search --class "^$(printf '%s' "$app" | sed 's/[][\.*^$+?(){}|]/\\&/g')\$" 2>/dev/null); do
        xdotool getwindowpid "$w" 2>/dev/null
    done
}

# Workspace id of the terminal hosting the claude/codex process that started pid $1
# (an ancestor window of the agent), empty when no agent is among its parents.
_agent_ws() {
    local p=$1 agent='' wins
    wins=$(niri msg --json windows | jq -r '.[] | "\(.pid) \(.workspace_id // "")"')
    while [[ "$p" =~ ^[0-9]+$ && "$p" -gt 1 ]]; do
        if [[ -n "$agent" ]]; then
            awk -v p="$p" '$1 == p && $2 != "" {print $2; f = 1; exit} END {exit !f}' <<<"$wins" && return
        fi
        [[ "$(cat "$PROC/$p/comm" 2>/dev/null)" =~ ^(claude|codex)$ ]] && agent=1
        p=$(_parent "$p")
    done
}

declare -A seen
# \x1f separates fields: a tab is IFS whitespace, so an empty field would shift the rest.
niri msg --json event-stream |
  jq --unbuffered -r '.WindowOpenedOrChanged.window? // empty
    | "\(.id)\u001f\(.workspace_id // "")\u001f\(.app_id // "")\u001f\(.pid // "")"' |
  while IFS=$'\x1f' read -r id ws app pid; do
    [[ -n "${seen[$id]:-}" ]] && continue   # title changes re-send the window
    seen[$id]=1
    [[ "$app" == com.danklinux.dms ]] && continue   # the launcher's own windows
    aws=
    for p in $(_pids "$pid" "$app"); do aws=$(_agent_ws "$p"); [[ -n "$aws" ]] && break; done
    if [[ -n "$aws" ]]; then
        [[ "$aws" != "$ws" ]] && _move "$id" "$aws"
        continue   # an agent's window is not the launcher's app
    fi
    read -r want at <"$REC" 2>/dev/null || continue
    rm -f "$REC"   # only the first window after a launch
    (( $(date +%s) - at <= MAX_AGE )) || continue
    # A window not on the focused workspace was placed by a rule: leave it.
    # shortcut: a rule targeting the workspace you switched to looks rule-less and is moved
    # back; matching rules by app-id would fix it if that ever matters.
    if [[ -n "$ws" && "$ws" != "$want" && "$ws" == "$(_focused_ws)" ]]; then
        _move "$id" "$want"   # you moved on: don't pull you back by focusing it
    elif [[ "$app" =~ $FOCUS_APPS && "$ws" == "$want" ]]; then
        niri msg action focus-window --id "$id"
    fi
  done
