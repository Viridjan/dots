#!/usr/bin/env bash
# Steam launch options: gamescope-media %command%
# Runs the game in gamescope at the focused output's native size, then moves
# gamescope's windows to the "media" workspace without focusing them. Window
# rules can't do this: gamescope has no app-id and sets its title too late.
set -u
read -r w h < <(niri msg --json focused-output | jq -r '.modes[.current_mode] | "\(.width) \(.height)"')
gamescope -W "$w" -H "$h" -f --adaptive-sync --expose-wayland -- "$@" &
pid=$!
# ponytail: watches for 120s only, so it never outlives a slow-starting game; raise if windows open later
timeout 120 niri msg --json event-stream |
  jq --unbuffered -r --argjson pid "$pid" \
    '.WindowOpenedOrChanged.window? | select(.pid == $pid) | "\(.id) \(.workspace_id)"' |
  while read -r id wsid; do
    media=$(niri msg --json workspaces | jq -r '.[] | select(.name == "media") | .id')
    [ "$wsid" = "$media" ] || niri msg action move-window-to-workspace --window-id "$id" --focus false media
  done &
wait "$pid"
