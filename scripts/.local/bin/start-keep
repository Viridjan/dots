#!/usr/bin/env bash
# Open Google Keep as a standalone webapp window
set -euo pipefail

case "${HOSTNAME:-$(uname -n)}" in
    *desktop*) WIN_W=2580; WIN_H=1080 ;;  # 75% of 3440×1440
    *surface*) WIN_W=2880; WIN_H=1920 ;;  # 100% of 2880×1920
    *)         WIN_W=1440; WIN_H=810  ;;  # 75% of 1920×1080
esac

# Persistent profile (not /tmp like start-windows) so the Google login survives reboots
exec chromium --app=https://keep.google.com --window-size="${WIN_W},${WIN_H}" \
    --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/chromium-keep"
