#!/usr/bin/env bash
# Launch macOS VM (dockur/macos) and open web UI
set -euo pipefail

COMPOSE_DIR="$HOME/Projects/dots/macos"

cd "$COMPOSE_DIR"
docker compose up -d

# Wait for web UI to be ready (max 30s)
echo "Waiting for macOS VM web UI..."
timeout 30 bash -c 'until curl -sf http://localhost:8007 > /dev/null 2>&1; do sleep 1; done' \
    || echo "Web UI not ready yet — opening anyway"

case "$(hostname)" in
    *desktop*) WIN_W=2580; WIN_H=1080 ;;  # 75% of 3440×1440
    *surface*) WIN_W=2880; WIN_H=1920 ;;  # 100% of 2880×1920
    *)         WIN_W=1440; WIN_H=810  ;;  # 75% of 1920×1080
esac

chromium --app=http://localhost:8007 --window-size="${WIN_W},${WIN_H}"
