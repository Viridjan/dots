#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────
# sysup — bootstrap + maintenance for CachyOS
# Supports: desktop (tower) and surface (Surface Pro 9)
#
# Usage:
#   sysup            # full bootstrap
#   sysup --update   # system update + maintenance
#   sysup --help
# ─────────────────────────────────────────────────────────
# The `cmd && ok "..." || warn "..."` logging idiom used ~28 times below is
# deliberate. The middle command is always ok(), a plain echo, so the SC2015
# pitfall needs echo itself to fail; the worst case is a spurious warning line,
# never lost work. Verified every site has this shape before disabling.
# shellcheck disable=SC2015
set -euo pipefail

RED='\033[0;31m'; YEL='\033[0;33m'; GRN='\033[0;32m'; BLU='\033[0;34m'; CYN='\033[0;36m'; NC='\033[0m'
info()    { echo -e "${BLU}==> $*${NC}"; }
ok()      { echo -e "${GRN}    $*${NC}"; }
warn()    { echo -e "${YEL}[!] $*${NC}"; WARNINGS+=("$*"); }
die()     { echo -e "${RED}[✗] $*${NC}" >&2; exit 1; }
section() { echo -e "\n${CYN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; \
            echo -e "${CYN}  ▶  ${1^^}${NC}"; \
            echo -e "${CYN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"; }

# _banner COLOR TITLE [box]
_banner() {
    echo ""
    if [[ "${3:-}" == box ]]; then
        echo -e "$1╔═════════════════════════════════════╗${NC}"
        printf '%b║      %s%*s║%b\n' "$1" "$2" "$((31 - ${#2}))" "" "$NC"
        echo -e "$1╚═════════════════════════════════════╝${NC}"
    else
        echo -e "$1════════════════════════════════════════════${NC}"
        echo -e "$1  $2${NC}"
        echo -e "$1════════════════════════════════════════════${NC}"
    fi
}

# Prompt yes/no; returns 0 only on y/Y. Usage: _confirm "Question? [y/N]" && ...
_confirm() { local _r; read -rp "$1 " _r; [[ "$_r" =~ ^[Yy]$ ]]; }

# Print infected-package list (red, stderr) and abort. Usage: _die_infected "<header>" "${pkgs[@]}"
_die_infected() {
    local _hdr="$1"; shift
    echo -e "${RED}[✗] MALWARE GATE: $_hdr:${NC}" >&2
    for _p in "$@"; do echo -e "${RED}    - $_p${NC}" >&2; done
    die "Remove infected packages from list files before proceeding"
}

WARNINGS=()
SYUU_FAIL_DETAIL=""

DOTS_DIR="$HOME/Projects/dots"
STAMP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dots"
INTERACTIVE=true
CONFIGURE_ITEMS=""
CONFIGURE_PROMPTED=false
AUDIT_ORPHAN_REMOVAL=false
AUDIT_PYTHON_REBUILD=false
AUDIT_REBUILD=false
AUDIT_PACNEW=false
CLEAN=false
STOW_ADOPT=false
LOG_FILE="$STAMP_DIR/sysup.log"
LOCK_FILE="$STAMP_DIR/sysup.lock"

# ─── Run plan (written by sysup.py) ──────────────────────
# Package lists, projects, stow selection and the profile's features come from
# a plan directory written by the Python helper (`sysup.py plan DIR`). The
# TUI passes SYSUP_PLAN_DIR; a standalone run builds a throwaway plan from
# ~/.config/sysup/config.toml, or from the hostname when there is none.
SYSUP_PLAN_DIR="${SYSUP_PLAN_DIR:-}"
_PLAN_OWNED=false
_ensure_plan() {
    if [[ -z "$SYSUP_PLAN_DIR" ]]; then
        SYSUP_PLAN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/sysup-plan.XXXXXX")
        _PLAN_OWNED=true
        local err
        if ! err=$(_py plan "$SYSUP_PLAN_DIR" 2>&1); then
            die "${err:-could not build the run plan (sysup.py plan)}"
        fi
        # The only stderr on success: the one-time config migration notice.
        [[ -z "$err" ]] || info "$err"
    fi
    if [[ -r "$SYSUP_PLAN_DIR/env" ]]; then
        # shellcheck source=/dev/null
        source "$SYSUP_PLAN_DIR/env"
    fi
    MACHINE="${SYSUP_PROFILE:-}"
    export SYSUP_PLAN_DIR
}
# Profile switches, e.g. `_has_feature linux-surface` (profiles/<name>.toml).
_has_feature() { [[ " ${SYSUP_FEATURES:-} " == *" $1 "* ]]; }

# Never removed by sysup (conflict swaps, demotions, orphan removal), whatever
# the lists say: kernels, firmware, microcode, bootloader, base system, keyrings.
_PROTECTED_PKG_RE='^(base|base-devel|linux|linux-[a-z0-9-]+|.*-firmware.*|.*-ucode|limine.*|mkinitcpio.*|systemd|systemd-libs|glibc|pacman|paru|sudo|.*-keyring|cachyos-.*mirrorlist|networkmanager|mesa|lib32-mesa|niri|greetd)$'
_is_protected() { [[ "$1" =~ $_PROTECTED_PKG_RE ]]; }

# Print installed protected packages that any of the given targets conflicts
# with. `pacman -Qq` resolves providers on purpose: a conflict may name one.
_protected_conflicts() {
    local c owner
    while IFS= read -r c; do
        owner=$(pacman -Qq "$c" 2>/dev/null) || continue
        _is_protected "$owner" && printf '%s ' "$owner"
    done < <(paru -Si "$@" 2>/dev/null | awk '
        /^[A-Z]/ { on = /^Conflicts With/; if (on) sub(/^[^:]*:/, "") }
        on { for (i = 1; i <= NF; i++) if ($i != "None") { sub(/[<>=].*/, "", $i); print $i } }' | sort -u)
    return 0
}

# ─── Audit-dependent actions ─────────────────────────────
# Single source of truth: checklist name → flag variable. Every one of these
# only sets a flag consumed inside phase_audit, so selecting one must also
# enable that phase. Adding an action here wires up the checklist, the
# force-enable and the CLI flag at once — previously each
# lived in a separate place and `rebuild` silently did nothing when audit was
# unchecked because only two of the four lists had been updated.
declare -A AUDIT_ACTIONS=(
    [orphan-removal]=AUDIT_ORPHAN_REMOVAL
    [python-rebuild]=AUDIT_PYTHON_REBUILD
    [rebuild]=AUDIT_REBUILD
    [pacnew-merge]=AUDIT_PACNEW
)
# Enable one action by name, plus the audit phase it depends on.
_enable_audit_action() {
    local name="$1" var="${AUDIT_ACTIONS[$1]:-}"
    [[ -n "$var" ]] || die "unknown audit action: $name"
    printf -v "$var" '%s' true
    SKIP_PHASES=" ${SKIP_PHASES:-} "
    SKIP_PHASES="${SKIP_PHASES/ audit / }"
    SKIP_PHASES="${SKIP_PHASES# }"
}

# ─── Action results (see _record / print_recap) ──────────
# Parallel arrays rather than an assoc array so the recap keeps run order.
_RESULT_NAMES=(); _RESULT_STATES=(); _RESULT_NOTES=()
_FAILED=0
_RECAP_FAILURE_REPORTED=false
# _record <name> <ok|fail|skip> [reason]
_record() {
    _RESULT_NAMES+=("$1"); _RESULT_STATES+=("$2"); _RESULT_NOTES+=("${3:-}")
    [[ "$2" == fail ]] && _FAILED=1
    # Optional machine-readable copy for callers/tests: name<TAB>state per line.
    [[ -z "${SYSUP_RESULT_FILE:-}" ]] || printf '%s\t%s\n' "$1" "$2" >> "$SYSUP_RESULT_FILE"
    return 0
}
# A command the user asked for failed: record it (nonzero recap) and warn.
# Plain warn is for intentional skips (tool missing, profile, declined).
_failw() { _record "$1" fail "$2"; warn "$2"; }

# ─── Post-run fixes ──────────────────────────────────────
# Problems with a known fix are queued while the run goes; after the recap,
# _offer_fixes asks about each one (terminal runs only). Kinds = _fix_<kind>:
# stow, unlisted, conflict, aur, pacnew, orphans. Payload is one string.
_FIXES=()
_queue_fix() { _FIXES+=("$1"$'\t'"$2"); }
_fix_tty() { [[ -t 0 ]]; }
# Lowercased answer in FIX_REPLY; EOF counts as an empty answer (skip).
_ask() { local r=""; read -rp "    $1 " r || true; FIX_REPLY=${r,,}; }
# The Python helper (plan, unused report, config edits). Found next to this
# script's real path, so it works from the repo and through the stow link.
SYSUP_LIB="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../lib/sysup"
_py() { SYSUP_DOTS="$DOTS_DIR" python3 -B "$SYSUP_LIB/sysup.py" "$@"; }
# pacman/paru print "name-ver-rel" in some messages; keep the name.
_strip_ver() {
    local p="$1"
    [[ "$p" =~ ^(.+)-([0-9]+:)?[0-9r][^-]*-[0-9.]+$ ]] && p=${BASH_REMATCH[1]}
    printf '%s\n' "$p"
}

_offer_fixes() {
    (( ${#_FIXES[@]} )) || return 0
    { $INTERACTIVE && _fix_tty; } || return 0
    _banner "$CYN" "Fixes (${#_FIXES[@]}) — Enter skips"
    local f fixed=0 left=0
    local -A seen=()
    for f in "${_FIXES[@]}"; do
        [[ -v seen["$f"] ]] && continue
        seen["$f"]=1
        # Each fix handles and reports its own errors; 1 = skipped or failed.
        if "_fix_${f%%$'\t'*}" "${f#*$'\t'}"; then fixed=$((fixed + 1)); else left=$((left + 1)); fi
    done
    echo ""
    info "fixes: $fixed applied, $left left"
}

# Payload: stow dir, then the stow args (last = package), \x1f-separated.
_fix_stow() {
    local -a args; local dir pkg target="$HOME" i t live repo bak="" changed=0 targets
    IFS=$'\x1f' read -ra args <<< "$1"
    dir=${args[0]}; args=("${args[@]:1}"); pkg=${args[-1]}
    for i in "${!args[@]}"; do [[ "${args[i]}" == -t ]] && target=${args[i+1]}; done
    targets=$(cd "$dir" && LC_ALL=C stow -n "${args[@]}" 2>&1 | _conflict_paths) || true
    [[ -n "$targets" ]] || { info "stow '$pkg': no conflicts left"; return 1; }
    # fd 4: the prompts below read stdin.
    while IFS= read -r t <&4; do
        [[ -n "$t" && "$t" != /* && "/$t/" != *"/../"* ]] || continue
        live="$target/$t"; repo="$dir/$pkg/$t"
        if [[ -L "$live" || ! -f "$live" || ! -f "$repo" ]]; then
            echo "    $t: not a plain file on both sides — skipped"; continue
        fi
        if cmp -s -- "$live" "$repo"; then
            _ask "$pkg: ${live/#"$HOME"/\~} is identical to the repo copy. Replace with a link? [Y/n]"
            [[ "$FIX_REPLY" == n ]] && continue
        else
            diff -u --label "repo/$t" --label "live/$t" -- "$repo" "$live" | head -n 40
            _ask "$pkg: ${live/#"$HOME"/\~} differs. [r]epo wins / [l]ive wins (copied into the repo) / [s]kip"
            [[ "$FIX_REPLY" == r || "$FIX_REPLY" == l ]] || continue
            [[ -n "$bak" ]] || bak=$(mktemp -d "$STAMP_DIR/fix-backup-$(date '+%Y%m%d-%H%M%S')-XXXXXX") \
                || { warn "cannot create backup dir — $pkg not fixed"; return 1; }
            mkdir -p "$bak/live/$(dirname -- "$t")" "$bak/repo/$(dirname -- "$t")" \
                && cp -a -- "$live" "$bak/live/$t" && cp -a -- "$repo" "$bak/repo/$t" \
                || { warn "backup failed — $t left alone"; continue; }
            if [[ "$FIX_REPLY" == l ]]; then
                cp -- "$live" "$repo" || { warn "could not copy $t into the repo"; continue; }
            fi
        fi
        rm -f -- "$live" && changed=1
    done 4<<< "$targets"
    [[ -n "$bak" ]] && ok "backups in $bak"
    (( changed )) || return 1
    if (cd "$dir" && stow "${args[@]}"); then
        ok "stowed: $pkg"
    else
        warn "stow '$pkg' still conflicts — rerun or use: sysup --adopt"; return 1
    fi
}

_fix_unlisted() {
    local p="$1" src=flatpak
    [[ "$(pacman -Qq -- "$p" 2>/dev/null)" == "$p" ]] && src=paru
    _ask "unlisted $src package $p: [p]ackages.toml / pro[f]ile ${MACHINE:-?} / [m] this machine / [i]gnore / [u]ninstall / [s]kip"
    case "$FIX_REPLY" in
        p) _py add shared "$src" "$p" && ok "$p → packages.toml (commit it)" ;;
        f) [[ -n "${MACHINE:-}" ]] || { warn "no active profile"; return 1; }
           _py add profile "$src" "$p" "$MACHINE" && ok "$p → profiles/$MACHINE.toml (commit it)" ;;
        m) _py add local "$src" "$p" && ok "$p kept on this machine (local config)" ;;
        i) _py add ignore "$src" "$p" && ok "$p ignored on this machine" ;;
        u) if [[ "$src" == flatpak ]]; then
               flatpak uninstall -y -- "$p" && ok "uninstalled: $p"
           elif _is_protected "$p"; then
               warn "protected, not removed: $p"; return 1
           else
               sudo pacman -Rns -- "$p" && ok "uninstalled: $p"
           fi ;;
        *) return 1 ;;
    esac
}

# Payload: the installed package the install transaction conflicted with.
_fix_conflict() {
    local p="$1"
    _is_protected "$p" && return 1
    _ask "install conflict: remove installed $p (pacman -Rdd) and retry the package install? [y/N]"
    [[ "$FIX_REPLY" == y ]] || return 1
    sudo pacman -Rdd --noconfirm -- "$p" || { warn "could not remove $p"; return 1; }
    _PKG_INDEX_READY=false
    if _install_list "$SYSUP_PLAN_DIR/paru-install.list"; then
        ok "packages installed"
    else
        warn "install still failing: ${INSTALL_FAIL_DETAIL:-see output}"; return 1
    fi
}

_fix_aur() {
    local p="$1" log="$STAMP_DIR/paru-fail.log"
    _ask "AUR build failed: $p. [l]og tail / [r]etry / [s]kip"
    if [[ "$FIX_REPLY" == l ]]; then
        tail -n 40 -- "$log" 2>/dev/null || echo "    (no log)"
        echo "    full log: $log"
        _ask "retry $p? [y/N]"
        [[ "$FIX_REPLY" == y ]] && FIX_REPLY=r
    fi
    [[ "$FIX_REPLY" == r ]] || return 1
    if _paru -S --noconfirm -- "$p"; then ok "built: $p"; else warn "$p still fails to build"; return 1; fi
}

_fix_pacnew() {
    _ask "$1 .pacnew file(s) pending. Merge now with pacdiff? [y/N]"
    [[ "$FIX_REPLY" == y ]] || return 1
    AUDIT_PACNEW=true
    check_pacnew
}

_fix_orphans() {
    local o keep=()
    for o in $1; do _is_protected "$o" || keep+=("$o"); done
    (( ${#keep[@]} )) || return 1
    _ask "orphans: ${keep[*]}. Remove? [y/N]"
    [[ "$FIX_REPLY" == y ]] || return 1
    sudo pacman -Rns -- "${keep[@]}" && ok "removed: orphans"
}

# Installed packages named by a failed install log: pacman's ":: A and B are in
# conflict" and paru's indented "pkg: conflicts..." lines under "Conflicts found".
# Only exact installed names come out, so the parse can't name a wrong package.
_conflict_names() {
    local w n
    for w in $(sed -nE 's/^:: (\S+) and (\S+) are in conflict.*/\1 \2/p' "$1"
               awk '/[Cc]onflicts found:/ { on = 1; next } on && /^ +[^ ]+:/ { sub(/^ +[^ ]+: */, ""); print; next } { on = 0 }' "$1"); do
        n=$(_strip_ver "${w%.}")
        [[ "$(pacman -Qq -- "$n" 2>/dev/null)" == "$n" ]] && printf '%s\n' "$n"
    done | sort -u
}

# Stow conflict lines → target paths (stow 2.4+, then 2.3 as on Ubuntu CI).
_conflict_paths() {
    sed -n -e 's/^ *\* cannot stow .* over existing target \(.*\) since neither a link nor a directory and --adopt not specified$/\1/p' \
        -e 's/^ *\* existing target is neither a link nor a directory: \(.*\)$/\1/p'
}

# ─── Self-update check ───────────────────────────────────
# Before a terminal run: if the repo is behind its upstream, offer to pull and
# relaunch. Runs before the lock is taken, so the relaunched copy can lock.
_check_repo_current() {
    [[ -z "${SYSUP_SELF_UPDATED:-}" ]] && _fix_tty || return 0
    command -v git >/dev/null || return 0
    git -C "$DOTS_DIR" rev-parse --abbrev-ref '@{u}' &>/dev/null || return 0
    if ! timeout 15 git -C "$DOTS_DIR" fetch --quiet 2>/dev/null; then
        warn "could not reach the dots remote — update check skipped"; return 0
    fi
    local behind
    behind=$(git -C "$DOTS_DIR" rev-list --count 'HEAD..@{u}' 2>/dev/null) || return 0
    (( behind > 0 )) || return 0
    git -C "$DOTS_DIR" log --oneline 'HEAD..@{u}' | head -n 10 | sed 's/^/    /'
    _ask "dots is $behind commit(s) behind. [p]ull and relaunch / [c]ontinue with this version"
    [[ "$FIX_REPLY" == p ]] || return 0
    if git -C "$DOTS_DIR" pull --ff-only; then
        ok "pulled — relaunching"
        export SYSUP_SELF_UPDATED=1
        exec "$DOTS_DIR/scripts/.local/bin/sysup" "$@"
    fi
    warn "pull failed (local changes or diverged) — continuing with this version"
}

# ─── Cleanup ─────────────────────────────────────────────
# Installed immediately so an early failure still restores the cursor. Must not
# call exit: returning lets bash propagate the original status untouched.
_TEE_PID=""
_cleanup() {
    local _rc=$?
    [[ -n "${_SUDO_PID:-}" ]] && kill "$_SUDO_PID" 2>/dev/null
    ${_PLAN_OWNED:-false} && rm -rf "${SYSUP_PLAN_DIR:?}"
    if [[ -n "${_TEE_PID:-}" ]]; then
        exec 1>&- 2>&- || true
        wait "$_TEE_PID" 2>/dev/null || true
    fi
    return $_rc
}
trap _cleanup EXIT

# ─── Runtime init (locking + logging) ────────────────────
# Deliberately NOT run at load: --help must not rotate the log,
# create stamps, or take the lock. Every mutating entry point calls this first.
_RUNTIME_READY=false
_LOCK_FD=
_ACTIVE_PHASE=""
_runtime_error() {
    local rc=$?
    trap - ERR
    # A final recap deliberately returns failure for already-recorded errors.
    # Preserve that status without reporting the same failure a second time.
    $_RECAP_FAILURE_REPORTED && exit "$rc"
    _FIXES=()
    _record "${_ACTIVE_PHASE:-action:${ACTION:-bootstrap}}" fail "exit $rc; remaining work aborted"
    print_recap || true
    exit "$rc"
}
# Ask for the sudo password once at the start of long runs, while the user is
# still watching; a prompt minutes into an update times out unattended.
_sudo_prime() {
    case "$ACTION" in --update|-u|--yes|-y) ;; *) return 0 ;; esac
    sudo -n true 2>/dev/null && return 0
    info "Root access: enter your password once, it is kept for the whole run"
    if sudo -v -p "    sudo password for %u: "; then
        ok "root access granted"
    else
        warn "no sudo ticket: steps that need root will fail"
    fi
}

# Long-lived children must not inherit the run lock: an orphaned one (the
# keep-alive's sleep, a log tee, a launched app) holds it after sysup exits.
# Call only in a subshell or child; in the main shell it releases the lock.
_drop_lock() { [[ -z "${_LOCK_FD:-}" ]] || exec {_LOCK_FD}>&-; }

# Refresh the sudo ticket while process $1 lives; run it in the background.
_sudo_keepalive() {
    _drop_lock
    trap - ERR
    while kill -0 "$1" 2>/dev/null; do sudo -n -v 2>/dev/null || true; sleep 60 || true; done
}

_init_runtime() {
    $_RUNTIME_READY && return 0
    mkdir -p "$STAMP_DIR"

    # Lock before rotating the log — two concurrent runs would otherwise shuffle
    # each other's log files before either noticed. The fd stays open for the
    # life of the process, so the kernel releases it on any exit, including kill.
    exec {_LOCK_FD}>"$LOCK_FILE"
    if ! flock -n "$_LOCK_FD"; then
        die "another sysup is already running (lock: $LOCK_FILE) — wait for it to finish"
    fi

    for _i in 2 1; do
        [[ -f "${LOG_FILE}.$_i" ]] && mv "${LOG_FILE}.$_i" "${LOG_FILE}.$((_i+1))"
    done
    [[ -f "$LOG_FILE" ]] && mv "$LOG_FILE" "${LOG_FILE}.1"
    exec > >(_drop_lock; exec tee "$LOG_FILE") 2>&1
    _TEE_PID=$!
    _RUNTIME_READY=true
    set -E
    trap _runtime_error ERR
    # Keep an already-granted sudo ticket alive through long upgrades and
    # builds; paru's SudoLoop only covers paru itself. -n never prompts, and
    # the loop holds no stdout so the log tee can still finish on exit.
    if [[ -t 0 ]] && command -v sudo &>/dev/null; then
        _sudo_prime
        _sudo_keepalive "$$" </dev/null >/dev/null 2>&1 &
        _SUDO_PID=$!
    fi
    echo "=== sysup $(date '+%Y-%m-%d %H:%M:%S') args: ${_ARGS:-<none>} ==="
}

# Pause tee before TUI (close pipe so tee flushes), resume after.
_tui_start() {
    exec 1>/dev/tty 2>/dev/tty
    wait "$_TEE_PID" 2>/dev/null || true
}
_tui_end() {
    exec > >(_drop_lock; exec tee -a "$LOG_FILE") 2>&1
    _TEE_PID=$!
}
_skipped() { [[ " ${SKIP_PHASES:-} " == *" $1 "* ]]; }

_run_phase() {
    local name="$1"; shift
    if _skipped "$name"; then
        _record "phase:$name" skip "not selected"
        return 0
    fi
    local label="$name"
    [[ "$name" == "configure" ]] && label="configs"
    section "$label"
    # Calling a phase in `if` disables errexit throughout its entire call tree.
    # Run it bare: an unexpected failure must stop dependent work. Runtime's
    # ERR trap records it and prints the recap before exiting. Recoverable
    # failures are handled and recorded explicitly at their call sites.
    _ACTIVE_PHASE="phase:$name"
    "$@"
    _record "phase:$name" ok
    _ACTIVE_PHASE=""
    return 0
}

_ensure_dots_repo() {
    if [[ -d "$DOTS_DIR" ]]; then
        ok "found: dots repo ($DOTS_DIR)"
        return
    fi
    info "dots repo not found — cloning from GitHub..."
    mkdir -p "$(dirname "$DOTS_DIR")"
    git clone https://github.com/Viridjan/dots.git "$DOTS_DIR" \
        || die "Failed to clone dots repo — check network/git access"
    ok "cloned: $DOTS_DIR"
}

# Returns 0 (run it) if stamp is absent or older than max_age seconds (default 48h).
_needs_run() {
    local stamp="$STAMP_DIR/$1"
    local max_age="${2:-172800}"
    [[ ! -f "$stamp" ]] && return 0
    local age=$(( $(date +%s) - $(date -r "$stamp" +%s) ))
    (( age > max_age ))
}
_mark_done() { touch "$STAMP_DIR/$1"; }

# ─── Phase 1: Machine detection ──────────────────────────
detect_machine() {
    _ensure_plan
    [[ -n "$MACHINE" ]] || die "no profile chosen — run: sysup --profile NAME"
    ok "profile: $MACHINE"
}

# ─── Phase 2: Paru ───────────────────────────────────────
install_paru() {
    if command -v paru &>/dev/null; then
        ok "already installed: paru"
        return
    fi
    info "Installing paru..."
    sudo pacman -S --needed base-devel git
    local tmp; tmp=$(mktemp -d)
    git clone https://aur.archlinux.org/paru.git "$tmp/paru"
    (cd "$tmp/paru" && makepkg -si --noconfirm)
    rm -rf "$tmp"
    ok "installed: paru"
}

# ─── Known third-party repo signing keys ────────────────
# Fixes "signature from ... is unknown trust" pacman errors by
# importing + locally signing the offending repo's key, then retrying.
# Add entries as [repo]=KEYID when a third-party pacman repo is added.
declare -A _REPO_KEYS=()

# ─── Phase 2b: Keyrings ──────────────────────────────────
reset_keyrings() {
    if ! _needs_run keyrings; then
        ok "skipped: keyrings (< 48h)"
        return
    fi
    info "Resetting pacman keyrings..."
    sudo rm -rf /etc/pacman.d/gnupg/
    sudo pacman-key --init
    sudo pacman-key --populate
    sudo pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
    sudo pacman-key --lsign-key F3B607488DB35A47
    # The wipe above drops third-party repo keys too; without them the next
    # pacman -Syy dies on "unknown trust" before _syuu's auto-recovery runs.
    local key
    for key in "${_REPO_KEYS[@]}"; do
        sudo pacman-key --recv-keys "$key" --keyserver keyserver.ubuntu.com \
            && sudo pacman-key --lsign-key "$key" \
            || warn "could not trust repo key $key"
    done
    if _has_feature linux-surface; then
        curl -sf https://raw.githubusercontent.com/linux-surface/linux-surface/master/pkg/keys/surface.asc \
            | sudo pacman-key --add -
        sudo pacman-key --finger 56C464BAAC421453
        sudo pacman-key --lsign-key 56C464BAAC421453
        ok "imported: linux-surface key"
    fi
    _mark_done keyrings
    ok "reset: keyrings"
}

_fix_untrusted_keys() {
    local out="$1" pkg key fixed=1
    while IFS= read -r pkg; do
        key="${_REPO_KEYS[$pkg]:-}"
        if [[ -z "$key" ]]; then
            warn "no known key for $pkg — fix manually"
            continue
        fi
        info "Trusting $pkg signing key ($key)..."
        sudo pacman-key --recv-keys "$key" --keyserver keyserver.ubuntu.com \
            && sudo pacman-key --lsign-key "$key" \
            && fixed=0
    done < <(echo "$out" | grep -oP 'error: \K[^:]+(?=: signature from .* is unknown trust)' | sort -u)
    return "$fixed"
}

# Pull the actionable lines out of a failed paru -Syuu log, so the end-of-run
# recap names what actually broke instead of only "had warnings". A single AUR
# package failing to build is the common case and is easy to miss in 2000 lines
# of upgrade output.
# Keep the failed log for the fix prompt and queue each package that failed to build.
_queue_aur_fails() {
    local p
    cp -f -- "$1" "$STAMP_DIR/paru-fail.log" 2>/dev/null || true
    for p in $(sed -n 's/^error: packages failed to build: //p' "$1"); do
        _queue_fix aur "$(_strip_ver "$p")"
    done
}
_syuu_fail_detail() {
    local log="$1" pkgs
    pkgs=$(sed -n 's/^error: packages failed to build: //p' "$log" | tr '\n' ' ')
    pkgs="${pkgs% }"
    if [[ -n "$pkgs" ]]; then
        echo "AUR build failed: $pkgs"
        return
    fi
    # sudo never got a password: name that, not paru's generic exit.
    local su
    su=$(sed -n 's/^sudo: //p' "$log" | grep -v '^a password is required' | tail -n 1)
    if [[ -n "$su" ]]; then
        echo "sudo: $su (password not entered)"
        return
    fi
    # No build failure: fall back to the last error line paru printed.
    sed -n 's/^error: //p' "$log" | tail -n 1
}

# Why a sudo command failed, when the cause is sudo itself (no ticket left).
_sudo_cause() { sudo -n true 2>/dev/null || echo ": no sudo access (password not entered)"; }

# pacman -Syy with the same one-shot recovery as _syuu: a repo key that is
# present but not locally signed (or lost since the last keyring reset) would
# otherwise abort the whole sources phase on "unknown trust".
_syy() {
    local out rc=0
    out=$(sudo pacman -Syy 2>&1) || rc=$?
    printf '%s\n' "$out"
    if (( rc != 0 )) && grep -q "is unknown trust" <<<"$out" && _fix_untrusted_keys "$out"; then
        info "Retrying database sync..."
        sudo pacman -Syy
        return
    fi
    return "$rc"
}

# ─── AUR build-time estimate ─────────────────────────────
# makepkg logs "==> Making package: <pkg> <ver> (<date>)" several times per
# build (fetch, prepare, build) and "==> Finished making: ..." once. The span
# from the first Making to Finished is the wall time the user waits, so record
# it per package and sum the history before the next upgrade. paru runs with
# LC_TIME=C so `date -d` can parse makepkg's %c timestamps.
# Committed with the repo so every machine's history informs the estimates
# shows. Keys: aur:<pkg> (makepkg span), @pacman-per-pkg, @flatpak-per-pkg.
BUILD_TIMES="$DOTS_DIR/build-times.tsv"

# Merge "key<TAB>seconds" lines into BUILD_TIMES: latest wins, sorted, atomic.
_merge_times() {
    [[ -n "$1" ]] || return 0
    mkdir -p "$(dirname "$BUILD_TIMES")"
    { [[ -f "$BUILD_TIMES" ]] && cat "$BUILD_TIMES"; printf '%s' "$1"; } \
        | awk -F'\t' 'NF == 2 { t[$1] = $2 } END { for (k in t) print k "\t" t[k] }' \
        | LC_ALL=C sort > "$BUILD_TIMES.tmp" && mv "$BUILD_TIMES.tmp" "$BUILD_TIMES"
}
_record_time() { _merge_times "$1"$'\t'"$2"$'\n'; }

_record_build_times() {
    local log="$1" pkg start end s e new=""
    while IFS=$'\t' read -r pkg start end; do
        s=$(date -d "$start" +%s 2>/dev/null) || continue
        e=$(date -d "$end" +%s 2>/dev/null) || continue
        (( e >= s )) && new+="aur:$pkg"$'\t'"$((e - s))"$'\n'
    done < <(sed 's/\x1b\[[0-9;]*m//g' "$log" | awk '
        match($0, /^==> Making package: [^ ]+ [^ ]+ \(.*\)$/) {
            split($0, f, " "); d = $0; sub(/^[^(]*\(/, "", d); sub(/\)$/, "", d)
            if (!(f[4] in start)) start[f[4]] = d
        }
        match($0, /^==> Finished making: [^ ]+ [^ ]+ \(.*\)$/) {
            split($0, f, " "); d = $0; sub(/^[^(]*\(/, "", d); sub(/\)$/, "", d)
            if (f[4] in start) { print f[4] "\t" start[f[4]] "\t" d; delete start[f[4]] }
        }')
    _merge_times "$new"
}

# Print a rough wall-clock estimate for pending AUR upgrades from past builds.
# ponytail: last build time only, no averaging — a version bump that changes
# build size skews one run, then self-corrects.
_pending_aur() { paru -Qua 2>/dev/null || true; }

_aur_estimate_text() {
    local pending
    pending=$(_pending_aur | awk '{ print $1 }' | _without_held_packages) || true
    [[ -n "$pending" ]] || return 0
    awk -F'\t' -v times="$BUILD_TIMES" '
        BEGIN { while ((getline line < times) > 0) { split(line, f, "\t"); t[f[1]] = f[2] } }
        NF { n++; k = "aur:" $1
             if (k in t) { sum += t[k]; parts = parts sprintf("%s %dm, ", $1, (t[k] + 30) / 60) }
             else unknown = unknown " " $1 }
        END {
            msg = sprintf("%d AUR build%s pending", n, n == 1 ? "" : "s")
            if (sum) msg = msg sprintf(" — est. ~%d min", (sum + 30) / 60)
            if (parts) { sub(/, $/, "", parts); msg = msg " (" parts ")" }
            if (unknown) msg = msg "; no history:" unknown
            print msg
        }' <<< "$pending"
}

_estimate_aur_builds() {
    local msg
    msg=$(_aur_estimate_text)
    [[ -z "$msg" ]] || info "$msg"
}

# Run paru (and the makepkg/compiler tree under it) at the lowest CPU priority
# and idle I/O, so AUR builds never outrank a game. `nice -n` is relative and
# shells started from alacritty inherit ananicy-cpp's negative niceness (-4),
# so compute the step that lands on an absolute 19.
_paru() { nice -n "$(( 19 - $(nice) ))" ionice -c 3 paru "$@"; }

# paru -Syuu wrapper: auto-recovers from untrusted-signature errors once.
_syuu() {
    local held
    held=$( { _held_packages; printf '%s\n' "${_AUR_FLAGGED[@]}"; } | awk NF | tr '\n' ',')
    held=${held%,}
    local args=(-Syuu --noconfirm)
    [[ -n "$held" ]] && args+=(--ignore "$held")
    local logfile; logfile=$(mktemp)
    local rc=0
    LC_TIME=C _paru "${args[@]}" 2>&1 | tee "$logfile" || rc=$?
    if (( rc != 0 )); then
        local out; out=$(<"$logfile")
        if echo "$out" | grep -q "is unknown trust" && _fix_untrusted_keys "$out"; then
            info "Retrying upgrade..."
            rc=0
            # Retry output is tee'd too — it used to be discarded, so a failure
            # here left nothing to report.
            LC_TIME=C _paru "${args[@]}" 2>&1 | tee "$logfile" || rc=$?
        fi
    fi
    # Partial runs still recorded: every finished build is a valid data point.
    _record_build_times "$logfile" || true
    if (( rc == 0 )); then
        rm -f "$logfile"
        return 0
    fi
    SYUU_FAIL_DETAIL=$(_syuu_fail_detail "$logfile")
    _queue_aur_fails "$logfile"
    rm -f "$logfile"
    return 1
}

# ─── Phase 2c: linux-surface repo ───────────────────────
setup_linux_surface_repo() {
    _has_feature linux-surface || return 0

    if grep -q '^\[linux-surface\]' /etc/pacman.conf; then
        ok "already added: linux-surface repo"
        return
    fi

    info "Adding linux-surface pacman repository..."
    sudo tee -a /etc/pacman.conf > /dev/null <<'EOF'

[linux-surface]
Server = https://pkg.surfacelinux.com/arch/
EOF
    sudo pacman -Sy
    ok "added: linux-surface repo"
}

# ─── Phase 3: Packages ───────────────────────────────────
_pkg_list() {
    awk 'NF && $1 !~ /^#/' "$1"
}

_held_packages() {
    if [[ -f "$SYSUP_PLAN_DIR/paru-hold.list" ]]; then
        _pkg_list "$SYSUP_PLAN_DIR/paru-hold.list"
    fi
    # Pinned packages are held from -Syu too; _sync_pinned upgrades them.
    _pinned_packages | awk -F/ 'NF == 2 { print $2 }'
}

_pinned_packages() {
    if [[ -f "$SYSUP_PLAN_DIR/paru-pin.list" ]]; then
        _pkg_list "$SYSUP_PLAN_DIR/paru-pin.list"
    fi
}

# Install/upgrade each "repo/name" from its repo. --needed skips an up-to-date
# one; a build from another repo (e.g. a higher cachyos pkgrel) is replaced.
_sync_pinned() {
    local pin out
    while IFS= read -r pin; do
        [[ "$pin" == */* ]] || { _failw "pin:$pin" "pin '$pin' is not repo/name — skipped"; continue; }
        if out=$(sudo pacman -S --needed --noconfirm "$pin" 2>&1); then
            _record "pin:${pin#*/}" ok
        else
            _failw "pin:${pin#*/}" "pinned $pin failed: $(tail -n1 <<<"$out")"
        fi
    done < <(_pinned_packages)
}

# Read package names from stdin, excluding exact hold-list matches.
_without_held_packages() {
    awk -v holds="$(_held_packages)" '
        BEGIN { n = split(holds, names, "\n"); for (i = 1; i <= n; i++) held[names[i]] = 1 }
        NF && !($0 in held)
    '
}

check_held_updates() {
    local held pending line pkg
    held=$(_held_packages)
    [[ -n "$held" ]] || return 0
    pending=$(_pending_aur)
    while IFS= read -r line; do
        pkg=${line%% *}
        [[ -n "$pkg" ]] || continue
        if grep -qxF "$pkg" <<< "$held"; then
            warn "held package has update: $line (review: paru -Gp $pkg; upgrade: paru -S $pkg)"
        fi
    done <<< "$pending"
    return 0
}


# Build these indexes once instead of spawning grep/pacman for every package.
declare -A _INSTALLED_PKGS=()
declare -A _SKIPPED_PKGS=()
_PKG_INDEX_READY=false

_init_pkg_index() {
    $_PKG_INDEX_READY && return

    local pkg installed skipped=""
    installed=$(pacman -Qq) || return 1
    if [[ -f "$SYSUP_PLAN_DIR/paru-skip.list" ]]; then
        skipped=$(_pkg_list "$SYSUP_PLAN_DIR/paru-skip.list") || return 1
    fi
    _INSTALLED_PKGS=(); _SKIPPED_PKGS=()
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] && _INSTALLED_PKGS["$pkg"]=1
    done <<< "$installed"

    if [[ -f "$SYSUP_PLAN_DIR/paru-skip.list" ]]; then
        while IFS= read -r pkg; do
            [[ -n "$pkg" ]] && _SKIPPED_PKGS["$pkg"]=1
        done <<< "$skipped"
    fi

    _PKG_INDEX_READY=true
}

INSTALL_FAIL_DETAIL=""
INSTALL_CONFLICT=false
_install_list() {
    INSTALL_FAIL_DETAIL=""
    INSTALL_CONFLICT=false
    local list="$1" to_install=() contents pkg
    contents=$(_pkg_list "$list") || return 1
    _init_pkg_index || return 1
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] || continue
        if [[ -v _SKIPPED_PKGS["$pkg"] ]]; then
            ok "skipped (skip list): $pkg"
            continue
        fi
        [[ -v _INSTALLED_PKGS["$pkg"] ]] || to_install+=("$pkg")
    done <<< "$contents"
    if [[ ${#to_install[@]} -gt 0 ]]; then
        local malware_list="$HOME/.local/share/aur-malware-check/package_list.txt"
        if [[ -f "$malware_list" ]]; then
            local matches
            matches=$(_infected_packages "$malware_list" < <(printf '%s\n' "${to_install[@]}")) || return 1
            if [[ -n "$matches" ]]; then
                local infected=()
                mapfile -t infected <<< "$matches"
                _die_infected "infected packages about to be installed" "${infected[@]}"
            fi
        fi
        # Callers run this behind `|| return 1` inside an `if !`, which disables
        # set -e for the whole chain — so a failing paru would otherwise fall
        # through, mark everything as installed, and report success, silently
        # skipping the mirror-refresh retry. Propagate the failure explicitly
        # and invalidate the index so retries query partially installed targets.
        # ponytail: one average over the whole call (repo + AUR mixed); AUR
        # builds also get exact per-package spans from _record_build_times.
        local _t0=$SECONDS install_log ask=(--useask --ask=4) blocked
        # --ask=4 accepts pacman's "X conflicts with Y, remove Y?" so a swap is
        # one transaction: Y goes only once X has built and installs. --useask
        # extends that to AUR targets: paru checks their conflicts itself and,
        # under --noconfirm, refuses them outright without it. Never for a
        # protected package — then pacman declines and the conflict is reported.
        blocked=$(_protected_conflicts "${to_install[@]}")
        if [[ -n "$blocked" ]]; then
            ask=()
            warn "not auto-removing protected conflicts: $blocked"
        fi
        install_log=$(mktemp) || return 1
        if ! LC_ALL=C _paru -S --needed --noconfirm "${ask[@]}" "${to_install[@]}" 2>&1 | tee "$install_log"; then
            INSTALL_FAIL_DETAIL=$(_syuu_fail_detail "$install_log")
            _queue_aur_fails "$install_log"
            # pacman's wording, then paru's own AUR conflict check.
            if grep -Eq 'unresolvable package conflicts|conflicting dependencies|conflicting packages' "$install_log"; then
                INSTALL_CONFLICT=true
                local _c
                for _c in $(_conflict_names "$install_log"); do _queue_fix conflict "$_c"; done
            fi
            rm -f "$install_log"
            # paru can install some targets before a later target fails.
            _PKG_INDEX_READY=false
            return 1
        fi
        rm -f "$install_log"
        for pkg in "${to_install[@]}"; do
            _INSTALLED_PKGS["$pkg"]=1
        done
        local _per=$(( (SECONDS - _t0) / ${#to_install[@]} ))
        _record_time @pacman-per-pkg "$(( _per > 0 ? _per : 1 ))"
    fi
}

# Fetch/refresh the aur-malware-check definitions. Returns non-zero on failure
# so callers decide whether that is fatal. Idempotent within one run: several
# gates need current definitions, but only the first one pays for the pull.
_MALWARE_DEFS_FRESH=false
_update_malware_defs() {
    $_MALWARE_DEFS_FRESH && return 0
    local repo_dir="$HOME/.local/share/aur-malware-check"
    if [[ -d "$repo_dir" ]]; then
        git -C "$repo_dir" reset --hard HEAD --quiet 2>/dev/null || true
        git -C "$repo_dir" pull --quiet 2>/dev/null || return 1
    else
        git clone --quiet https://github.com/lenucksi/aur-malware-check.git "$repo_dir" 2>/dev/null || return 1
    fi
    _MALWARE_DEFS_FRESH=true
}

# Read requested package names from stdin and match definitions in one pass.
# Explicit filenames plus stdin keep matches literal and propagate read errors.
_infected_packages() {
    awk 'FILENAME != "-" { bad[$0] = 1; next } $0 in bad { print }' "$@" -
}

# Pre-install malware gate: check all AUR package lists against definitions.
_check_packages_against_malware() {
    local repo_dir="$HOME/.local/share/aur-malware-check"
    # Always refresh, never "only if missing": an existing but months-old clone
    # would otherwise wave through a package flagged since the last fetch, and
    # the full installed-package scan only runs later, after the install.
    info "Refreshing malware definitions..."
    _update_malware_defs || die "malware gate: failed to update definitions — aborting install"
    local campaign_pkgs=("$repo_dir"/data/campaigns/*/packages*.txt)
    [[ -e "${campaign_pkgs[0]}" ]] || die "malware gate: definitions missing after fetch — aborting install"
    info "Pre-install malware gate: scanning package lists..."
    local requested="" contents list matches
    list="$SYSUP_PLAN_DIR/paru-install.list"
    contents=$(_pkg_list "$list") || die "malware gate: cannot read $list"
    requested+="$contents"$'\n'
    matches=$(_infected_packages "${campaign_pkgs[@]}" <<< "$requested") \
        || die "malware gate: cannot read definitions"
    if [[ -n "$matches" ]]; then
        local infected=()
        mapfile -t infected <<< "$matches"
        _die_infected "infected packages in install lists" "${infected[@]}"
    fi
    ok "malware gate: all packages clean"
}

refresh_mirrors() {
    if ! _needs_run mirrors 2592000; then
        ok "skipped: mirrors (< 30 days)"
        return
    fi

    if ! command -v rate-mirrors &>/dev/null; then
        warn "rate-mirrors not found — skipping mirror refresh"
        return
    fi

    info "Detecting region..."
    local country
    country=$(curl --connect-timeout 10 -sSL 'https://geoip.kde.org/v1/ubiquity' 2>/dev/null \
        | grep -Po '<CountryCode>\K([A-Z]{2})' || true)
    [[ -n "$country" ]] && ok "region: $country"

    local _rm_env=(
        RATE_MIRRORS_PROTOCOL=https
        RATE_MIRRORS_FETCH_MIRRORS_TIMEOUT=30000
        RATE_MIRRORS_MAX_DELAY=10000
    )
    [[ -n "$country" ]] && _rm_env+=(RATE_MIRRORS_ENTRY_COUNTRY="$country")
    [[ "$country" == "CN" ]] && _rm_env+=(
        RATE_MIRRORS_COUNTRY_NEIGHBORS_PER_COUNTRY=0
        RATE_MIRRORS_COUNTRY_TEST_MIRRORS_PER_COUNTRY=50
    )

    local tmp_arch tmp_cachyos rm_log
    tmp_arch=$(mktemp); tmp_cachyos=$(mktemp); rm_log=$(mktemp)

    # rate-mirrors progress goes to its own temp file, not $LOG_FILE — the tee
    # from the top of the script holds an offset on $LOG_FILE and would clobber
    # anything appended behind its back.
    info "Rating arch + CachyOS mirrors in parallel..."
    env "${_rm_env[@]}" rate-mirrors \
        --per-mirror-timeout 1500 --max-mirrors-to-output 5 \
        --save "$tmp_arch" arch >>"$rm_log" 2>&1 &
    local pid_arch=$!

    env "${_rm_env[@]}" rate-mirrors \
        --per-mirror-timeout 1500 --max-mirrors-to-output 5 \
        --save "$tmp_cachyos" cachyos >>"$rm_log" 2>&1 &
    local pid_cachyos=$!

    local rc_arch=0 rc_cachyos=0
    wait "$pid_arch"    || rc_arch=$?
    wait "$pid_cachyos" || rc_cachyos=$?

    if (( rc_arch == 0 )); then
        [[ "$country" != "RU" && "$country" != "CN" ]] && \
            sed -i "1iServer = https://archlinux.cachyos.org/repo/\$repo/os/\$arch" "$tmp_arch"
        sudo install -m 0644 --backup=simple --suffix=-backup "$tmp_arch" /etc/pacman.d/mirrorlist
        ok "ranked: $(grep -c '^Server' "$tmp_arch") arch mirrors"
    else
        warn "arch mirror refresh failed — keeping existing"
    fi

    if (( rc_cachyos == 0 )); then
        sudo install -m 0644 --backup=simple --suffix=-backup "$tmp_cachyos" /etc/pacman.d/cachyos-mirrorlist
        sudo cp /etc/pacman.d/cachyos-mirrorlist /etc/pacman.d/cachyos-v3-mirrorlist
        sudo cp /etc/pacman.d/cachyos-mirrorlist /etc/pacman.d/cachyos-v4-mirrorlist
        sudo sed -i 's|/$arch/|/$arch_v3/|g' /etc/pacman.d/cachyos-v3-mirrorlist
        sudo sed -i 's|/$arch/|/$arch_v4/|g' /etc/pacman.d/cachyos-v4-mirrorlist
        ok "ranked: $(grep -c '^Server' "$tmp_cachyos") CachyOS mirrors"
    else
        warn "CachyOS mirror refresh failed — keeping existing"
    fi

    if (( rc_arch != 0 && rc_cachyos != 0 )); then
        cat "$rm_log"
        rm -f "$tmp_arch" "$tmp_cachyos" "$rm_log"
        # No stamp on total failure — otherwise one bad network run pins stale
        # mirrors for the full 30-day window.
        warn "mirror refresh failed entirely — not stamping, will retry next run"
        return
    fi

    rm -f "$tmp_arch" "$tmp_cachyos" "$rm_log"
    _syy
    _mark_done mirrors
    ok "refreshed: mirrors"
}

# Force-remove [paru].remove packages (conflict swaps) that are installed.
# -Rdd skips dep checks so replacements (e.g. wine→wine-cachyos) don't block.
# Sets REMOVED_CONFLICTS so --update can point at the replacement install.
REMOVED_CONFLICTS=()
_remove_conflicts() {
    local _conflicts pkg out
    if [[ -f "$SYSUP_PLAN_DIR/paru-remove.list" ]] && ! _conflicts=$(_pkg_list "$SYSUP_PLAN_DIR/paru-remove.list"); then
        _record "conflict-removal" fail "cannot read paru-remove.list"
        warn "Cannot read paru-remove.list — conflicting packages were not removed"
        return 0
    fi
    [[ -n "${_conflicts:-}" ]] || return 0
    while IFS= read -r pkg; do
        # Exact name only: -Qq also answers for a package that provides it
        # (vectorcraft → vectorcraft-bin), which -Rdd then can't find.
        [[ "$(pacman -Qq "$pkg" 2>/dev/null)" == "$pkg" ]] || continue
        if _is_protected "$pkg"; then
            warn "protected, not removed: $pkg"
        elif out=$(sudo pacman -Rdd --noconfirm "$pkg" 2>&1); then
            ok "removed: $pkg"; REMOVED_CONFLICTS+=("$pkg")
        else
            warn "failed to remove: $pkg — $out"
        fi
    done <<< "$_conflicts"
}

# _upgrade_system OK-MESSAGE PROGRESS-MESSAGE [warn-conflicts]
_upgrade_system() {
    _remove_conflicts
    _demote_packages
    if [[ "${3:-}" == warn-conflicts ]]; then
        ((${#REMOVED_CONFLICTS[@]} == 0)) \
            || warn "removed ${REMOVED_CONFLICTS[*]}; install replacements with: sysup --actions install"
    fi
    _check_disk_space
    _review_aur_updates
    _estimate_aur_builds
    info "$2"
    local _dms_before; _dms_before=$(_dms_versions)
    # A failed upgrade must not abort before clean_caches and print_recap
    # can report it; never announce success unconditionally.
    if _syuu; then
        _record "full-upgrade" ok
        ok "$1"
    else
        _record_upgrade_failure
    fi
    _sync_pinned
    # Also after a partial failure: DMS may have upgraded before it.
    _restart_dms_if_changed "$_dms_before"
}

install_all() {
    command -v paru    &>/dev/null && ok "already installed: paru"    || die "paru not found — run sources phase first"

    _upgrade_system "upgraded: system" "Upgrading existing packages..."

    _do_install() {
        info "Installing packages (profile: ${MACHINE:-?})..."
        _install_list "$SYSUP_PLAN_DIR/paru-install.list" || return 1
    }

    if ! _do_install; then
        if $INSTALL_CONFLICT; then
            _record "packages" fail "$INSTALL_FAIL_DETAIL"
            warn "Package conflict — check package selections and regenerate the run plan: $INSTALL_FAIL_DETAIL"
        else
            warn "Install failed — forcing mirror refresh and retrying..."
            # Only drop the stamp once the retry is actually about to happen.
            rm -f "$STAMP_DIR/mirrors"
            refresh_mirrors
            if _do_install; then
                _record "packages" ok "succeeded after mirror refresh"
            else
                _record "packages" fail "failed after mirror refresh${INSTALL_FAIL_DETAIL:+: $INSTALL_FAIL_DETAIL}"
                # Do not die: flatpak installs and cache cleanup are independent of
                # the pacman/AUR list, so they still run. The non-zero exit status
                # comes from print_recap, so the failure is not swallowed.
                warn "Package install failed after mirror refresh${INSTALL_FAIL_DETAIL:+: $INSTALL_FAIL_DETAIL} — continuing with independent steps"
            fi
        fi
    else
        _record "packages" ok
    fi

    # The selected pacman list may omit Flatpak even when apps are selected.
    # Sources runs before package installation, so configure Flathub here too.
    if [[ -s "$SYSUP_PLAN_DIR/flatpak-install.list" ]]; then
        if _ensure_package_command flatpak flatpak; then
            flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo \
                || _failw flathub "failed to configure Flathub"
        fi
    fi
    local _apps
    if command -v flatpak &>/dev/null && ! _apps=$(_pkg_list "$SYSUP_PLAN_DIR/flatpak-install.list"); then
        _record "flatpak" fail "cannot read flatpak-install.list"
        warn "Cannot read flatpak-install.list — flatpak apps were not installed"
    elif command -v flatpak &>/dev/null; then
        info "Installing flatpak apps..."
        while IFS= read -r app; do
            [[ -n "$app" ]] || continue
            if flatpak info "$app" &>/dev/null; then
                ok "already installed: $app"
            else
                local _t0=$SECONDS _sec
                if flatpak install -y flathub "$app" &>/dev/null; then
                    _sec=$(( SECONDS - _t0 ))
                    _record_time @flatpak-per-pkg "$(( _sec > 0 ? _sec : 1 ))"
                    ok "installed: $app"
                else
                    _failw "flatpak:$app" "failed to install: $app"
                fi
            fi
        done <<< "$_apps"
        # [flatpak].remove: apps replaced by a package; runs after the paru
        # install above, so the old app goes only after its replacement exists.
        if [[ -f "$SYSUP_PLAN_DIR/flatpak-remove.list" ]] && _apps=$(_pkg_list "$SYSUP_PLAN_DIR/flatpak-remove.list"); then
            while IFS= read -r app; do
                [[ -n "$app" ]] && flatpak info "$app" &>/dev/null || continue
                if flatpak uninstall -y --noninteractive "$app" &>/dev/null; then
                    ok "removed: $app"
                else
                    _failw "flatpak:$app" "failed to remove: $app"
                fi
            done <<< "$_apps"
        fi
        info "Updating flatpak apps..."
        flatpak update -y &>/dev/null && ok "flatpaks up to date" || _failw flatpak-update "flatpak update failed"
    fi
    update_ollama
    update_projects
    update_claude_plugins

    install_user_tools
    install_codex
    clean_caches
    # Failures above are recorded; print_recap turns them into the exit status.
    # Returning non-zero here would trip errexit and abort every later phase.
    return 0
}

# Local `x` marks (paru-demote.list): mark them dependencies instead of -Rdd,
# then remove only those that are now orphans (-s takes their unneeded deps).
# Anything still required by another package stays, and the recap says why.
_demote_packages() {
    local list="$SYSUP_PLAN_DIR/paru-demote.list" pkgs=() pkg contents
    [[ -f "$list" ]] || return 0
    contents=$(_pkg_list "$list") || { _record "demote" fail "cannot read paru-demote.list"; return 0; }
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] || continue
        if _is_protected "$pkg"; then warn "protected, not removed: $pkg"; continue; fi
        [[ "$(pacman -Qqe "$pkg" 2>/dev/null)" == "$pkg" ]] && pkgs+=("$pkg")
    done <<< "$contents"
    (( ${#pkgs[@]} )) || return 0
    info "Demoting to dependencies: ${pkgs[*]}"
    if ! sudo pacman -D --asdeps "${pkgs[@]}" >/dev/null; then
        _record "demote" fail "pacman -D --asdeps failed"
        warn "demote failed: ${pkgs[*]}"
        return 0
    fi
    local orphans=() all
    all=$(pacman -Qdtq 2>/dev/null || true)
    for pkg in "${pkgs[@]}"; do
        if grep -qxF "$pkg" <<< "$all"; then
            orphans+=("$pkg")
        else
            warn "kept as dependency (still required by: $(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Required By *: //p')): $pkg"
        fi
    done
    if (( ${#orphans[@]} )); then
        if sudo pacman -Rns --noconfirm "${orphans[@]}"; then
            ok "removed: ${orphans[*]}"
        else
            _record "demote" fail "pacman -Rns failed"
            warn "removal failed: ${orphans[*]}"
            return 0
        fi
    fi
    _record "demote" ok
}

# pacman checks space for packages itself; AUR builds in ~/.cache and
# snapshots do not, so warn before a long upgrade starts on a near-full root.
_check_disk_space() {
    local avail
    avail=$(df --output=avail -BG / 2>/dev/null | tail -1 | tr -dc '0-9') || return 0
    [[ -n "$avail" ]] || return 0
    if (( avail < ${SYSUP_MIN_FREE_GB:-5} )); then
        warn "only ${avail} GiB free on / — AUR builds and snapshots may fill it mid-upgrade"
    fi
    return 0
}

# ─── AUR update review ───────────────────────────────────
# paru.conf has SkipReview, so nothing shows what changed in a PKGBUILD. Before
# an upgrade, fetch each pending AUR package's paru clone and diff upstream
# against HEAD (the version last built). Diffs are saved; packages whose added
# lines download or execute code are left out of this upgrade (like a hold)
# unless an interactive run confirms. Upgrading one by hand moves HEAD, which
# clears the flag. Also imports missing source-signing keys (see below).
# JS package installs were the Atomic Arch vector (June 2026): the poisoned
# PKGBUILDs pulled malicious npm/bun packages at build time.
_AUR_REVIEW_RE='curl|wget|base64|eval |/dev/tcp|python[0-9.]* -c|(ba)?sh -c|\| *(ba)?sh\b|chmod +[ugo]*\+?s|nc -|\b(npm|pnpm|yarn|bun) +(install|add|ci|i)\b|\bnpx '
_AUR_FLAGGED=()
_review_aur_updates() {
    local clones="$HOME/.cache/paru/clone" dir="$STAMP_DIR/aur-review" pending held line pkg base hits
    [[ -d "$clones" ]] || return 0
    pending=$(_pending_aur)
    [[ -n "$pending" ]] || return 0
    held=$(_held_packages)
    mkdir -p "$dir"
    local flagged=() names=() old new
    while IFS= read -r line; do
        pkg=${line%% *}
        [[ -n "$pkg" ]] || continue
        grep -qxF "$pkg" <<< "$held" && continue
        names+=("$pkg")
        base=$(pacman -Qi "$pkg" 2>/dev/null | sed -n 's/^Base *: //p' || true)
        base=${base:-$pkg}
        [[ -d "$clones/$base/.git" ]] || continue
        if ! git -C "$clones/$base" fetch -q origin 2>/dev/null; then
            warn "AUR review: fetch failed for $base"
            continue
        fi
        _import_aur_keys "$clones/$base"
        git -C "$clones/$base" diff HEAD '@{u}' > "$dir/$base.diff" 2>/dev/null || continue
        [[ -s "$dir/$base.diff" ]] || continue
        hits=$(grep -E '^\+[^+]' "$dir/$base.diff" | grep -E -- "$_AUR_REVIEW_RE" | head -3 | tr '\n' ' ' || true)
        if [[ -n "$hits" ]]; then
            flagged+=("$pkg")
            warn "AUR review: $pkg update adds download/exec lines: ${hits:0:200}(diff: $dir/$base.diff)"
        fi
    done <<< "$pending"
    if (( ${#names[@]} )); then
        while IFS=$'\t' read -r pkg old new; do
            [[ -n "$pkg" ]] || continue
            [[ " ${flagged[*]} " == *" $pkg "* ]] || flagged+=("$pkg")
            warn "AUR review: $pkg changed maintainer since it was built ($old -> $new) — check the AUR page and diff before upgrading"
        done < <(_aur_maint_changes "$(_aur_info "${names[@]}")")
    fi
    (( ${#flagged[@]} )) || return 0
    if $INTERACTIVE && [[ -t 0 ]] && _confirm "Upgrade flagged AUR packages (${flagged[*]}) anyway? [y/N]"; then
        return 0
    fi
    _AUR_FLAGGED+=("${flagged[@]}")
    warn "left out of this upgrade: ${flagged[*]} (after reading the diff: paru -S ${flagged[*]})"
}

# _aur_info PKG... → "name<TAB>maintainer<TAB>out-of-date" per package the AUR
# has ("None" = orphan, "No" = not flagged), "-<TAB>name" per one it lacks.
# One paru -Sai = one RPC call. Empty output = no answer (offline).
_aur_info() {
    paru -Sai "$@" 2>&1 | awk -F' *: ' '
        /^Name /        { n = $2 }
        /^Maintainer /  { m = $2 }
        /^Out Of Date / { print n "\t" m "\t" $2 }
        /^error: package .* was not found/ {
            s = $0; sub(/^error: package \047/, "", s); sub(/\047 was not found.*/, "", s); print "-\t" s }' || true
}

# _aur_maint_changes INFO (from _aur_info) → "pkg<TAB>old<TAB>new" for each
# package whose AUR maintainer changed since it was last built. Atomic Arch
# adopted orphaned packages and then poisoned them, so a change is the signal.
# The snapshot ($STAMP_DIR/aur-maintainers.tsv: pkg, maintainer, installed
# version) takes the current maintainer for new packages and ones rebuilt
# since (a new installed version = the user upgraded it, i.e. reviewed it).
_aur_maint_changes() {
    local f="$STAMP_DIR/aur-maintainers.tsv" pkg maint ood ver
    local -A old_m=() old_v=() cur_v=()
    while read -r pkg ver; do [[ -z "$pkg" ]] || cur_v[$pkg]=$ver; done < <(pacman -Qm 2>/dev/null || true)
    if [[ -f "$f" ]]; then
        while IFS=$'\t' read -r pkg maint ver; do old_m[$pkg]=$maint; old_v[$pkg]=$ver; done < "$f"
    fi
    while IFS=$'\t' read -r pkg maint ood; do
        [[ -n "$pkg" && "$pkg" != - && -n "${cur_v[$pkg]+x}" ]] || continue
        if [[ -n "${old_m[$pkg]+x}" && "${old_v[$pkg]}" == "${cur_v[$pkg]}" ]]; then
            [[ "${old_m[$pkg]}" == "$maint" ]] || printf '%s\t%s\t%s\n' "$pkg" "${old_m[$pkg]}" "$maint"
        else
            old_m[$pkg]=$maint; old_v[$pkg]=${cur_v[$pkg]}
        fi
    done <<< "$1"
    mkdir -p "$STAMP_DIR"
    for pkg in "${!old_m[@]}"; do
        [[ -z "${cur_v[$pkg]+x}" ]] || printf '%s\t%s\t%s\n' "$pkg" "${old_m[$pkg]}" "${old_v[$pkg]}"
    done | sort > "$f.tmp" && mv "$f.tmp" "$f"
}

# makepkg verifies source signatures with the USER's keyring, not pacman-key,
# so sysup's keyring reset never fixes "unknown public key". Import the
# validpgpkeys the updated .SRCINFO names, before paru builds.
_import_aur_keys() {
    local clone="$1" key
    command -v gpg &>/dev/null || return 0
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        gpg --list-keys "$key" &>/dev/null && continue
        if gpg --keyserver hkps://keyserver.ubuntu.com --recv-keys "$key" &>/dev/null; then
            ok "imported AUR source key: $key (${clone##*/})"
        else
            warn "could not import AUR source key $key for ${clone##*/} — try: gpg --recv-keys $key"
        fi
    done < <(git -C "$clone" show '@{u}:.SRCINFO' 2>/dev/null | sed -n 's/^[[:space:]]*validpgpkeys = //p')
}

# Global npm and uv tools from packages.toml [npm]/[uv]. Install-only: both
# tools update themselves through their own commands.
_npm_have() { npm ls -g --depth=0 --parseable | sed -n 's|.*/node_modules/||p'; }
_uv_have() { uv tool list | awk '$1 !~ /^-/ {print $1}'; }

# Install a required package manager even when omitted from the selected plan.
_ensure_package_command() {
    local tool="$1" package="$2"
    command -v "$tool" &>/dev/null && return 0
    info "Installing missing prerequisite: $package..."
    if sudo pacman -S --needed --noconfirm "$package" && command -v "$tool" &>/dev/null; then
        ok "installed: $package"
    else
        _failw "$tool-prerequisite" "failed to install required command: $tool ($package)"
        return 1
    fi
}

# Global npm installs go to ~/.local/bin (already on PATH), not /usr, so they
# need no sudo. npm's default prefix is /usr, where `npm i -g` fails EACCES.
_ensure_npm_prefix() {
    local want="$HOME/.local" cur
    cur=$(npm config get prefix 2>/dev/null || true)
    [[ "$cur" == "$want" ]] && return 0
    if npm config set prefix "$want"; then
        ok "npm global prefix: $want (was ${cur:-unset})"
    else
        _failw npm-prefix "could not set npm global prefix to $want"
        return 1
    fi
}

# Print the tail of a failed installer's output, indented, so the cause is
# visible live. Callers fold the last line into their _failw message.
_show_install_error() {
    [[ -n "$1" ]] || return 0
    tail -n 8 <<< "$1" | sed 's/^/      /'
}

# _user_tools TOOL LIST LIST-CALLBACK INSTALL-ARGV...
_user_tools() {
    local tool="$1" list="$SYSUP_PLAN_DIR/$2" listing="$3" have pkg; shift 3
    [[ -s "$list" ]] || return 0
    if [[ "$tool" == npm ]]; then
        _ensure_package_command npm npm || return 0
        _ensure_npm_prefix || return 0
    else
        command -v "$tool" &>/dev/null || { warn "$tool not found — $tool tools skipped"; return 0; }
    fi
    have=$("$listing" 2>/dev/null || true)
    local out args
    while IFS= read -r pkg; do
        # An entry is the package plus optional installer args ("x[api] --with y").
        read -ra args <<< "$pkg"
        (( ${#args[@]} )) || continue
        # Listings print bare names: compare without extras (lightrag-hku[api]).
        if grep -qxF -- "${args[0]%%\[*}" <<< "$have"; then
            ok "already installed: $pkg ($tool)"
        elif out=$("$@" "${args[@]}" 2>&1); then
            ok "installed: $pkg ($tool)"
        else
            _show_install_error "$out"
            _failw "$tool:$pkg" "failed to install: $pkg ($tool): $(grep . <<< "$out" | tail -n 1)"
        fi
    done < <(_pkg_list "$list")
}

install_user_tools() {
    _user_tools npm npm-install.list _npm_have npm i -g
    _user_tools uv uv-install.list _uv_have uv tool install
    return 0
}

# ─── Phase 4: Dotfiles ───────────────────────────────────
# Stow packages come from the chosen dotfile set (dotsets/<name>/, SYSUP_DOTSET_DIR),
# limited to the run plan's stow.list. `scripts` is tooling, not a dotfile set:
# it is always linked from the repo root. niri, ollama and brave keep their
# special handling below.
# Local config [display] (plan env): GTK/GNOME text-scaling-factor (GTK, libadwaita,
# Chromium/Electron). Unset → left alone.
_apply_display() {
    [[ -n "${SYSUP_TEXT_SCALE:-}" ]] || return 0
    if ! command -v gsettings &>/dev/null; then
        _failw display "gsettings not found — text scale not applied"
    elif gsettings set org.gnome.desktop.interface text-scaling-factor "$SYSUP_TEXT_SCALE"; then
        ok "text scale: $SYSUP_TEXT_SCALE"
    else
        _failw display "failed to set text scale $SYSUP_TEXT_SCALE"
    fi
}

_stow_niri_cfg() {
    # ~/.config/niri/ must stay a real directory — DMS writes dms/ inside it and
    # stow would fold the whole dir into a symlink, breaking DMS on regeneration.
    # So we skip stow for niri and create file-level symlinks directly.
    local src="$SYSUP_DOTSET_DIR/niri/.config/niri"
    local dst="$HOME/.config/niri"
    local mach_src="$SYSUP_DOTSET_DIR/$MACHINE/.config/niri"

    local files=(display input autostart-machine surface-layout) f

    mkdir -p "$dst/cfg"
    _apply_display

    # niri reloads on every change and silently keeps the last good config on
    # a parse error, so validate the PROPOSED tree first: a temp dir mirroring
    # ~/.config/niri (dms/ and the rest linked through, includes resolve
    # against the link paths) with the new links in place. Invalid → keep the
    # current links and record the failure.
    if command -v niri &>/dev/null; then
        local stage out e
        stage=$(mktemp -d) || return 0
        mkdir -p "$stage/cfg" "$stage/dms"
        # DMS may not have run yet. Validate with existing generated files,
        # filling missing includes from the curated repo defaults.
        for e in "$dst"/dms/*.kdl "$src"/dms/*.kdl; do
            [[ -f "$e" && ! -e "$stage/dms/${e##*/}" ]] || continue
            cp "$e" "$stage/dms/${e##*/}"
        done
        for e in "$dst"/* "$dst"/cfg/*; do
            [[ -e "$e" ]] || continue
            [[ "$e" == "$dst/cfg" || "$e" == "$dst/dms" || "$e" == "$dst/config.kdl" ]] && continue
            ln -s "$e" "$stage/${e#"$dst"/}"
        done
        ln -sfn "$src/config.kdl" "$stage/config.kdl"
        for f in "${files[@]}"; do
            [[ -f "$mach_src/cfg/${f}.kdl" ]] && ln -sfn "$mach_src/cfg/${f}.kdl" "$stage/cfg/${f}.kdl"
        done
        if ! out=$(niri validate -c "$stage/config.kdl" 2>&1); then
            rm -rf "$stage"
            _record "niri-config" fail "niri validate failed; links unchanged"
            warn "niri config invalid — links left unchanged: $(printf '%s\n' "$out" | grep -v DEBUG | grep -m3 -E 'Error|×|╰' | tr '\n' ' ')"
            return 0
        fi
        rm -rf "$stage"
        ok "niri config valid"
    fi

    # DMS must own real files, not links into the repo. Preserve generated
    # files; dms_import applies curated overrides separately.
    mkdir -p "$dst/dms"
    local dms_file
    for dms_file in "$src"/dms/*.kdl; do
        [[ -f "$dms_file" && ! -e "$dst/dms/${dms_file##*/}" ]] || continue
        cp "$dms_file" "$dst/dms/${dms_file##*/}"
    done
    ln -sf "$src/config.kdl" "$dst/config.kdl"

    for f in "${files[@]}"; do
        [[ -f "$mach_src/cfg/${f}.kdl" ]] && ln -sf "$mach_src/cfg/${f}.kdl" "$dst/cfg/${f}.kdl"
    done
    # A missing last file must not leave the loop's false test as the return status.
    return 0

}

# Stow folds a package dir into one link only when the target doesn't exist
# yet. If it is already a real directory (an app or plugin wrote files there
# first), stow links file by file instead and reports success, but new files
# created there never reach git. Warn at the top-most such dir; refolding
# needs a manual merge (move it aside, restow, copy untracked files back).
_warn_unfolded() {
    local pkg="$1" d rel t hit=""
    while IFS= read -r d; do
        rel=${d#"$pkg"/}
        [[ -n "$hit" && "$rel" == "$hit"/* ]] && continue
        # Shared parents; systemctl --user enable writes .wants links into user/.
        case "$rel" in .config|.local|.local/share|.local/state|.local/lib|.config/systemd|.config/systemd/user) continue ;; esac
        t="$HOME/$rel"
        [[ -d "$t" ]] || continue
        # Folded (directly or through a parent link): resolves into the package.
        [[ "$(realpath "$t")" == "$(realpath "$d")" ]] && continue
        hit=$rel
        warn "stow: '$pkg' is unfolded at ~/$rel (a real directory, not a link) — new files there are not in git"
    done < <(find "$pkg" -mindepth 1 -maxdepth 3 -type d | sort)
    return 0
}

# ─── Dotset backups ──────────────────────────────────────
# Two local tags per dotfile set: backup/<set>/1 (newest) and backup/<set>/2,
# on snapshot commits. A new snapshot moves 1 → 2 and drops the old 2. Tags
# are never pushed: commit-tree skips the pre-commit secret scan, and two
# machines would overwrite each other's rotation.
#   _backup_dotset head       the last saved state (HEAD), before a git export
#   _backup_dotset work [why] the working tree, before deploy / restore
#   _backup_dotset live-dms   working tree + live DMS overrides, before dms-import
# Never blocks the step it protects: any failure warns and returns 0.
_backup_dotset() {
    local mode="$1" why="${2:-$1}" set rel idx tree commit prev f name failed=false
    [[ -n "${SYSUP_DOTSET_DIR:-}" ]] || return 0
    rel=${SYSUP_DOTSET_DIR#"$DOTS_DIR"/}
    [[ "$rel" != "$SYSUP_DOTSET_DIR" ]] || return 0      # set outside the repo
    set=${rel##*/}
    git -C "$DOTS_DIR" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0
    if [[ "$mode" == head ]]; then
        commit=$(git -C "$DOTS_DIR" rev-parse HEAD) || failed=true
    else
        idx=$(mktemp) || return 0
        export GIT_INDEX_FILE="$idx"
        git -C "$DOTS_DIR" read-tree HEAD && git -C "$DOTS_DIR" add -A -- "$rel" || failed=true
        if [[ "$mode" == live-dms ]] && ! $failed; then
            for f in "$DOTS_DIR/$rel/niri/.config/niri/dms/"*.kdl; do
                name=${f##*/}
                [[ -f "$f" && -f "$DMS_LIVE/$name" && ! -L "$DMS_LIVE/$name" ]] || continue
                git -C "$DOTS_DIR" update-index --add --cacheinfo \
                    "100644,$(git -C "$DOTS_DIR" hash-object -w -- "$DMS_LIVE/$name"),$rel/niri/.config/niri/dms/$name" \
                    || failed=true
            done
        fi
        $failed || tree=$(git -C "$DOTS_DIR" write-tree) || failed=true
        unset GIT_INDEX_FILE
        rm -f "$idx"
        $failed || commit=$(git -C "$DOTS_DIR" commit-tree "$tree" -p HEAD \
            -m "sysup backup $set $(date '+%F %T') before $why") || failed=true
    fi
    if $failed; then warn "dotset backup failed — continuing without it"; return 0; fi
    # Rotate only when the set itself changed since backup 1.
    prev=$(git -C "$DOTS_DIR" rev-parse -q --verify "backup/$set/1:$rel" 2>/dev/null) || prev=""
    [[ "$(git -C "$DOTS_DIR" rev-parse -q --verify "$commit:$rel" 2>/dev/null)" != "$prev" ]] || return 0
    if git -C "$DOTS_DIR" rev-parse -q --verify "refs/tags/backup/$set/1" >/dev/null; then
        git -C "$DOTS_DIR" tag -f "backup/$set/2" "backup/$set/1" >/dev/null || { warn "dotset backup rotation failed"; return 0; }
    fi
    git -C "$DOTS_DIR" tag -f "backup/$set/1" "$commit" >/dev/null \
        && ok "dotset backup: backup/$set/1 (before $why)" || warn "dotset backup failed — continuing without it"
}

# sysup --restore 1|2: put the active set back to a backup (working tree only,
# nothing committed). The state it replaces becomes backup 1 first.
restore_dotset() {
    local n="$1" set rel commit
    [[ -n "${SYSUP_DOTSET_DIR:-}" ]] || die "no dotfile set chosen — run: sysup --profile NAME --dotset SET"
    rel=${SYSUP_DOTSET_DIR#"$DOTS_DIR"/}; set=${rel##*/}
    commit=$(git -C "$DOTS_DIR" rev-parse -q --verify "refs/tags/backup/$set/$n^{commit}") \
        || die "no backup/$set/$n yet — backups are made before deploy, dms-import and git export"
    info "backup/$set/$n: $(git -C "$DOTS_DIR" log -1 --format='%cs %s' "$commit")"
    if git -C "$DOTS_DIR" diff --quiet "$commit" -- "$rel"; then
        ok "$rel already matches backup $n"; return 0
    fi
    git -C "$DOTS_DIR" --no-pager diff --stat "$commit" -- "$rel"
    _confirm "Restore $rel from backup $n? The current state becomes backup 1. [y/N]" \
        || { info "nothing changed"; return 0; }
    _backup_dotset work restore
    if git -C "$DOTS_DIR" restore --source="$commit" --worktree -- "$rel"; then
        ok "restored $rel from backup $n (not committed — review with git diff)"
        info "DMS overrides are copies: run 'sysup --actions dms-import' to apply them"
    else
        _failw restore "git restore from backup $n failed"
    fi
}

deploy_dotfiles() {
    _backup_dotset work deploy
    info "Deploying dotfiles via stow..."
    cd "$DOTS_DIR" || die "cannot cd to $DOTS_DIR"

    # Idempotent: point git at the tracked hooks dir so a fresh clone gets the
    # lint pre-commit guard without a manual setup step. (Do not start this
    # comment line with the linter's name — it parses as a directive.)
    git config core.hooksPath .githooks 2>/dev/null || true
    # Clean filter named in .gitattributes: strips nicotine+'s password before
    # it reaches a commit. Unregistered, git would commit the file as-is.
    git config filter.nicotine.clean .githooks/nicotine-clean 2>/dev/null || true

    # -t "$HOME" is required: stow's default target is the PARENT of the stow dir,
    # which here is $HOME/Projects (DOTS_DIR=$HOME/Projects/dots), not $HOME.
    # Without it, symlinks land in ~/Projects/.config instead of ~/.config.

    # Restow each package in one invocation. Stow checks its complete plan for
    # conflicts before executing it; a separate -D would remove working links
    # even when the subsequent install cannot proceed.

    # BEHAVIOUR CHANGE (deliberate): routine deployment no longer passes
    # --adopt. --adopt silently MOVES whatever real file is already at the
    # target INTO the repo, overwriting the tracked copy, then symlinks to it.
    # On a re-run over a machine whose config had drifted, that quietly replaced
    # repo content with live content and the only trace was an unexplained
    # `git diff`. Now a conflict is reported and left alone; adopting is an
    # explicit `--adopt` run that backs the files up first.
    local _stowed=() _conflicts=()
    _deploy_pkg() {   # <stow args...> -- label
        local label="${*: -1}"; set -- "${@:1:$#-1}"
        if $STOW_ADOPT; then
            if ! _adopt_backup "$@"; then
                _record "stow:$label" fail "backup failed; adoption cancelled"
                return 1
            fi
            stow --adopt "$@" && _stowed+=("$label") && return 0
            _record "stow:$label" fail "adopt failed"; return 1
        fi
        if stow "$@" 2>/dev/null; then
            _stowed+=("$label"); return 0
        fi
        # Re-run visibly to capture why; stow reports conflicts on stderr.
        local _err; _err=$(stow -n "$@" 2>&1 || true)
        _conflicts+=("$label: $(echo "$_err" | grep -c 'existing target') conflict(s)")
        _record "stow:$label" fail "conflicts"
        local _payload; printf -v _payload '%s\x1f' "$PWD" "$@"
        _queue_fix stow "${_payload%$'\x1f'}"
        warn "stow conflict in '$label' — fix offered at the end, or run 'sysup --adopt'"
        echo "$_err" | sed 's/^/        /'
        return 1
    }

    # scripts is stowed unfolded: ~/.local/bin must stay a real directory so
    # installers (npm -g, uv, codex, AppImages) write there, not into the repo.
    # Every other package is folded on purpose: app writes should land in git.
    # Dead links from an old layout (pre-dotsets/) make stow report "not owned"
    # conflicts, so remove them before stowing, not after.
    _prune_dead_links
    _deploy_pkg --restow --no-folding -t "$HOME" scripts scripts || true

    # Root-target packages (-t /, not ~HOME):
    #   ollama — systemd drop-in for ROCm GPU support
    #   brave  — managed policy letting discord.com reach Vesktop's local RPC port
    _deploy_root_pkg() {
        local _rpkg="$1"
        if $STOW_ADOPT; then
            _adopt_backup -t / "$_rpkg" || { _record "stow:$_rpkg" fail "backup failed"; return 1; }
            sudo stow --adopt -t / "$_rpkg" && _stowed+=("$_rpkg→/") || _record "stow:$_rpkg" fail "adopt failed"
        else
            sudo stow --restow -t / "$_rpkg" && _stowed+=("$_rpkg→/") \
                || { _record "stow:$_rpkg" fail "conflicts"; warn "stow conflict in '$_rpkg' — run 'sysup --adopt'"; }
        fi
    }

    # The drop-in dir is a folded link, so edits to it land without a restow
    # and stay inert until systemd reloads. Restart only a running service.
    _reload_ollama() {
        [[ "$(systemctl show -p NeedDaemonReload --value ollama 2>/dev/null)" == yes ]] || return 0
        sudo systemctl daemon-reload && sudo systemctl try-restart ollama \
            && ok "ollama drop-ins reloaded" \
            || _failw ollama "ollama reload failed — run: sudo systemctl daemon-reload && sudo systemctl restart ollama"
    }

    if [[ -z "${SYSUP_DOTSET_DIR:-}" ]]; then
        info "dotfile set: none — only scripts linked"
    else
        cd "$SYSUP_DOTSET_DIR" || die "cannot cd to dotfile set $SYSUP_DOTSET_DIR"
        local pkg
        while IFS= read -r pkg; do
            [[ -n "$pkg" && -d "$pkg" ]] || continue
            case "$pkg" in
                niri)         _stow_niri_cfg; _stowed+=("niri") ;;
                ollama)       _deploy_root_pkg "$pkg" || return 1; _reload_ollama ;;
                brave)        _deploy_root_pkg "$pkg" || return 1 ;;
                *)            _deploy_pkg --restow -t "$HOME" "$pkg" "$pkg" && _warn_unfolded "$pkg" ;;
            esac
        done < <([[ -f "$SYSUP_PLAN_DIR/stow.list" ]] && cat "$SYSUP_PLAN_DIR/stow.list")
        _unstow_unticked
    fi

    for _pkg in "${_stowed[@]}"; do ok "stowed: $_pkg"; done
    if [[ ${#_conflicts[@]} -gt 0 ]]; then
        warn "stow conflicts left untouched: ${_conflicts[*]}"
    fi
    # Deliberately returns 0 even with conflicts. A conflict is the EXPECTED,
    # recoverable outcome of not passing --adopt, and each one is already
    # recorded as failed at its call site, so _FAILED (and the exit status) is
    # set either way. Returning non-zero here would trip the ERR trap and abort
    # the whole run — dms_import, configure and audit would never execute
    # because one package had a drifted file.
    return 0
}

# Packages sysup linked on an earlier run but that are unticked now
# (local config [select] dotfiles) get unlinked. Only packages recorded in the state file are
# touched, so a package that was never deployed here is left alone. niri is
# never unlinked: niri without config.kdl starts with defaults.
_unstow_unticked() {
    local state="$STAMP_DIR/stowed-pkgs" now pkg
    now=$(cat "$SYSUP_PLAN_DIR/stow.list" 2>/dev/null) || return 0
    if [[ -f "$state" ]]; then
        while IFS= read -r pkg; do
            [[ -n "$pkg" && -d "$SYSUP_DOTSET_DIR/$pkg" ]] || continue
            grep -qxF "$pkg" <<< "$now" && continue
            case "$pkg" in
                niri) warn "niri is unticked but stays linked (unlinking would leave niri without config)"; continue ;;
                ollama|brave) sudo stow -D -d "$SYSUP_DOTSET_DIR" -t / "$pkg" ;;
                *) stow -D -d "$SYSUP_DOTSET_DIR" -t "$HOME" "$pkg" ;;
            esac && ok "unlinked (unticked): $pkg" || warn "could not unlink unticked package: $pkg"
        done < "$state"
    fi
    { mkdir -p "$STAMP_DIR" && printf '%s\n' "$now" > "$state"; } || true
    return 0
}

# Dead links that point into the repo, left behind when a tracked file is
# deleted or renamed (restow only prunes inside packages it is restowing).
# Never follows links, never touches a link pointing anywhere else.
_prune_dead_links() {
    local l t
    while IFS= read -r -d '' l; do
        t=$(readlink -- "$l") || continue
        [[ "$t" == /* ]] || t="$(dirname -- "$l")/$t"
        t=$(realpath -m -- "$t") || continue
        [[ "$t" == "$DOTS_DIR"/* ]] || continue
        rm -f -- "$l" && ok "removed dead link: ${l/#"$HOME"/\~}"
    done < <(find "$HOME/.config" -maxdepth 3 -xtype l -print0 2>/dev/null
             find "$HOME/.local/bin" "$HOME/.local/share/applications" -maxdepth 1 -xtype l -print0 2>/dev/null)
    return 0
}

# Back up every file stow would overwrite, OUTSIDE the tracked tree, before an
# --adopt run moves it into the repo. Without this, adopting is unrecoverable:
# the repo copy is gone and the live file has been moved.
_adopt_backup() {
    local dest _err rc=0 target="$HOME" pkg="${*: -1}" arg
    local -a args=("$@")
    while (( $# )); do
        arg="$1"; shift
        case "$arg" in
            -t|--target) target="$1"; shift ;;
            --target=*) target="${arg#*=}" ;;
        esac
    done
    _err=$(LC_ALL=C stow -n "${args[@]}" 2>&1) || rc=$?
    (( rc == 0 )) && return 0
    # stow's conflict line is (2.4+, then 2.3 as on Ubuntu CI):
    #   * cannot stow <src> over existing target <target> since <reason>
    #   * existing target is neither a link nor a directory: <target>
    # <target> is relative to -t, which is / for the root-target packages (ollama, brave).
    # Refuse unknown conflict formats and probe errors, never silently adopt.
    local _targets
    _targets=$(printf '%s\n' "$_err" | _conflict_paths)
    if [[ $rc != 1 || -z "$_targets" ]] || printf '%s\n' "$_err" | grep '^ *\* ' | grep -qv -e ' since neither a link nor a directory and --adopt not specified$' \
        -e '^ *\* existing target is neither a link nor a directory: '; then
        warn "Cannot safely parse stow conflicts; adoption cancelled: $_err"
        return 1
    fi
    mkdir -p "$STAMP_DIR" || return 1
    dest=$(mktemp -d "$STAMP_DIR/adopt-backup-$(date '+%Y%m%d-%H%M%S')-XXXXXX") || return 1
    local t src repo_src
    while IFS= read -r t; do
        if [[ -z "$t" || "$t" == /* || "/$t/" == *"/../"* ]]; then
            warn "Invalid stow conflict path; adoption cancelled: $t"
            return 1
        fi
        src="$target/$t"
        repo_src="$pkg/$t"
        if [[ ! -e "$src" && ! -L "$src" ]] || [[ ! -e "$repo_src" && ! -L "$repo_src" ]]; then
            warn "Backup source missing; adoption cancelled: $t"
            return 1
        fi
        mkdir -p "$dest/live/$(dirname "$t")" "$dest/repo/$(dirname "$t")" || return 1
        cp -a -- "$src" "$dest/live/$t" || { warn "Backup failed: $src"; return 1; }
        cp -a -- "$repo_src" "$dest/repo/$t" || { warn "Backup failed: $repo_src"; return 1; }
        ok "backed up live and repo: $t"
    done <<< "$_targets"
    ok "adopt backups in $dest"
}

# ─── Phase 5: Services ───────────────────────────────────
_sc() {
    local kind="$1"; shift
    if [[ "$kind" == user ]]; then systemctl --user "$@"; else sudo systemctl "$@"; fi
}

# Units come from packages.toml/profiles [systemd] (systemd-*.list in the plan).
# sysup records what it enabled; a unit dropped from the lists is disabled
# (not stopped — that happens at the next boot, so nothing dies mid-session).
# Nothing is disabled on the first run, before there is a record.
enable_services() {
    local sys="$SYSUP_PLAN_DIR/systemd-enable.list" usr="$SYSUP_PLAN_DIR/systemd-user.list"
    local managed="$STAMP_DIR/managed-units" now="" u kind
    mkdir -p "$STAMP_DIR"
    if [[ ! -r "$sys" || ! -r "$usr" ]]; then
        _record "services" fail "service lists missing from the run plan"
        warn "service lists missing from the run plan — nothing enabled or disabled"
        return 0
    fi
    info "Enabling services..."
    while read -r kind u; do
        [[ -n "$u" ]] || continue
        local tag="$u"; [[ "$kind" == user ]] && tag="$u (user)"
        # The MPD dotset stores its log, database and state here. MPD creates
        # the files itself, but cannot start when their parent is missing.
        if [[ "$kind" == user && "$u" == mpd ]]; then
            if ! mkdir -p "$HOME/.local/share/mpd"; then
                _failw "service:$kind:$u" "could not create MPD data directory"
                continue
            fi
        fi
        if _sc "$kind" enable --now "$u"; then
            ok "enabled: $tag"
            now+="$kind $u"$'\n'
        else
            _failw "service:$kind:$u" "could not enable: $tag"
            # enable --now may enable and then fail to start: keep tracking it.
            if _sc "$kind" is-enabled --quiet "$u" 2>/dev/null \
                || { [[ -f "$managed" ]] && grep -qxF "$kind $u" "$managed"; }; then
                now+="$kind $u"$'\n'
            fi
        fi
    done < <(_pkg_list "$sys" | sed 's/^/system /'; _pkg_list "$usr" | sed 's/^/user /')

    if _has_feature desktop-services; then
        sudo systemctl daemon-reload 2>/dev/null || true
        sudo usermod -aG libvirt "$USER" 2>/dev/null || true
        sudo usermod -aG docker "$USER" 2>/dev/null || true
    fi

    if [[ -f "$managed" ]]; then
        while read -r kind u; do
            [[ -n "$u" ]] || continue
            grep -qxF "$kind $u" <<< "$now" && continue
            local tag="$u"; [[ "$kind" == user ]] && tag="$u (user)"
            if _sc "$kind" disable "$u"; then
                ok "disabled (no longer listed): $tag"
            else
                _failw "service:$kind:$u" "could not disable: $tag (will retry)"
                now+="$kind $u"$'\n'
            fi
        done < "$managed"
    fi
    printf '%s' "$now" > "$managed.tmp"
    mv "$managed.tmp" "$managed"
    ufw_allow
}

# [ufw].allow (packages.toml/profiles → ufw-allow.list): one `ufw allow` per
# line, split into words so "from 192.168.1.0/24 to any port 22" works.
# `ufw allow` skips existing rules itself, so this is safe to rerun.
# ponytail: add-only; a rule dropped from the list stays until `ufw delete allow <rule>`.
ufw_allow() {
    local list="$SYSUP_PLAN_DIR/ufw-allow.list" line rule=()
    [[ -s "$list" ]] && command -v ufw &>/dev/null || return 0
    while IFS= read -r line; do
        read -ra rule <<< "$line"
        (( ${#rule[@]} )) || continue
        if sudo ufw allow "${rule[@]}" >/dev/null; then
            ok "firewall allows: $line"
        else
            _failw "ufw:$line" "ufw allow failed: $line"
        fi
    done < <(_pkg_list "$list")
}

# ─── Phase 7: Snapper ────────────────────────────────────
setup_snapper() {
    info "Configuring snapper..."
    if [[ ! -f /etc/snapper/configs/root ]]; then
        sudo snapper -c root create-config / && ok "created: snapper root config"
    else
        ok "already exists: snapper root config"
    fi
}

# ─── Automount disks (code in ../lib/sysup/automount.sh, loaded on use) ──
_AUTOMOUNT_LIB="${BASH_SOURCE[0]%/*}/../lib/sysup/automount.sh"  # ~/.local/lib via stow, or the repo
# shellcheck source=scripts/.local/lib/sysup/automount.sh
automount_disks() { source "$_AUTOMOUNT_LIB" && automount_disks "$@"; }

# ─── Phase 7a: Greeter ───────────────────────────────────
setup_keyboard() {
    info "Setting X11/XWayland keyboard layout (us intl)..."
    if sudo localectl set-x11-keymap us pc105 intl; then
        ok "configured: keyboard (us intl)"
    else
        _failw keyboard "keyboard: localectl failed"
    fi
}

setup_greeter() {
    # Greeter split out of the dms binary; `dms greeter` is now a deprecated shim.
    if ! command -v dms-greeter &>/dev/null; then
        warn "dms-greeter not found — skipping greeter setup"
        return
    fi
    info "Configuring DMS greeter (greetd)..."
    dms-greeter install --yes && ok "configured: greeter" || _failw greeter "greeter: install failed — run: dms-greeter install"
    sudo mkdir -p /var/cache/dms-greeter && sudo chown greeter:greeter /var/cache/dms-greeter \
        || _failw greeter "greeter: cannot prepare /var/cache/dms-greeter"
    dms-greeter sync && ok "synced: greeter" || _failw greeter "greeter: sync failed — run: dms-greeter sync"
}

# ─── Phase 7f: Keyring PAM integration ───────────────────

setup_keyring_pam() {
    local pam=/etc/pam.d/greetd
    if grep -q "pam_gnome_keyring" "$pam" 2>/dev/null; then
        ok "already configured: keyring PAM"
        return
    fi
    info "Configuring gnome-keyring PAM integration..."
    printf '\nauth       optional     pam_gnome_keyring.so\nsession    optional     pam_gnome_keyring.so auto_start\n' \
        | sudo tee -a "$pam" > /dev/null \
        && ok "configured: keyring PAM (/etc/pam.d/greetd)" \
        || _failw keyring-pam "keyring PAM: failed — add manually to /etc/pam.d/greetd"
}

# ─── NVIDIA: niri VRAM fix (niri wiki, "Nvidia") ─────────
# The driver keeps a large free-buffer pool per GL process, so niri holds
# ~1 GiB of VRAM instead of ~100 MiB. One-time action; applies when niri restarts.
# ─── One-time personal setup (was the post-install checklist) ──
# Each checks first: done → ok (stamped); needs a person and no terminal, or
# a precondition is missing → warn (not stamped, offered again next time).

# Defaults from the old checklist; asked for interactively, kept if already set.
GIT_DEFAULT_NAME="Viridjan"
GIT_DEFAULT_EMAIL="viridjan@users.noreply.github.com"
setup_git_identity() {
    local name email
    name=$(git config --global user.name || true)
    email=$(git config --global user.email || true)
    if [[ -n "$name" && -n "$email" ]]; then
        ok "git identity: $name <$email>"
        return 0
    fi
    if $INTERACTIVE; then
        [[ -n "$name" ]] || { read -rp "    git user.name [$GIT_DEFAULT_NAME]: " name; name=${name:-$GIT_DEFAULT_NAME}; }
        [[ -n "$email" ]] || { read -rp "    git user.email [$GIT_DEFAULT_EMAIL]: " email; email=${email:-$GIT_DEFAULT_EMAIL}; }
    else
        name=${name:-$GIT_DEFAULT_NAME}; email=${email:-$GIT_DEFAULT_EMAIL}
    fi
    git config --global user.name "$name" && git config --global user.email "$email" \
        && ok "git identity set: $name <$email>" \
        || _failw git-identity "could not write git identity"
}

setup_ssh_key() {
    local key="$HOME/.ssh/id_ed25519" body
    if [[ ! -f "$key" ]]; then
        if ! $INTERACTIVE; then
            warn "no SSH key — needs a terminal for the passphrase: sysup --actions ssh-key"
            return 0
        fi
        info "Creating an SSH key (choose a passphrase, or Enter for none)..."
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        ssh-keygen -t ed25519 -C "$(git config --global user.name || whoami)@$(hostname)" -f "$key" \
            || { _failw ssh-key "ssh-keygen failed"; return 0; }
        ok "created $key"
    else
        ok "SSH key exists: $key"
    fi
    if ! command -v gh &>/dev/null || ! gh auth token &>/dev/null; then
        warn "add the key on GitHub: gh auth login, then re-run (or paste $key.pub at github.com/settings/keys)"
        return 0
    fi
    body=$(awk '{print $2}' "$key.pub")
    if gh ssh-key list 2>/dev/null | grep -qF "$body"; then
        ok "SSH key already on GitHub"
    elif gh ssh-key add "$key.pub" --title "$(hostname)" >/dev/null 2>&1; then
        ok "SSH key added to GitHub as $(hostname)"
    else
        warn "gh could not add the key (needs scope: gh auth refresh -s admin:public_key) — or paste $key.pub at github.com/settings/keys"
    fi
}

setup_fingerprint() {
    command -v fprintd-list &>/dev/null || { ok "fprintd not installed — nothing to enroll"; return 0; }
    local out
    out=$(fprintd-list "$USER" 2>&1 || true)
    if [[ "$out" == *"No devices available"* ]]; then
        ok "no fingerprint reader"
    elif [[ "$out" == *" - #"* ]]; then
        ok "fingerprint already enrolled"
    elif $INTERACTIVE; then
        fprintd-enroll && ok "fingerprint enrolled" || _failw fingerprint "fprintd-enroll failed"
    else
        warn "fingerprint not enrolled — needs a terminal: sysup --actions fingerprint"
    fi
}

setup_bitwarden() {
    command -v bitwarden-desktop &>/dev/null || { ok "Bitwarden not installed — nothing to do"; return 0; }
    local data="$HOME/.config/Bitwarden/data.json"
    if jq -e '.global_account_activeAccountId | select(. != null and . != false and . != "" and . != 0)' \
            "$data" >/dev/null 2>&1; then
        ok "Bitwarden: logged in"
        return 0
    fi
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        ( _drop_lock; setsid -f bitwarden-desktop >/dev/null 2>&1 ) || true
        warn "Bitwarden opened — log in there; this step is marked done once you have"
    else
        warn "Bitwarden: not logged in — open the app (or browser extension) and log in"
    fi
}

setup_yubikey_pin() {
    command -v ykman &>/dev/null || { ok "ykman not installed — nothing to do"; return 0; }
    local out
    out=$(ykman fido info 2>&1 || true)
    if [[ "$out" == *"PIN:"* && "$out" != *"Not set"* && "$out" != *"not set"* ]]; then
        ok "YubiKey FIDO PIN is set"
    elif [[ "$out" != *"PIN:"* ]]; then
        warn "no YubiKey found — plug it in and re-run: sysup --actions yubikey-pin"
    elif $INTERACTIVE; then
        ykman fido access change-pin && ok "YubiKey PIN set" || _failw yubikey-pin "ykman could not set the PIN"
    else
        warn "YubiKey has no FIDO PIN — needs a terminal: sysup --actions yubikey-pin"
    fi
}

# linux-surface kernels are signed with the project's key; with Secure Boot on,
# the firmware needs it enrolled (MOK). The package queues the enrolment and
# the MOK manager asks for it on the next boot (password: surface).
setup_surface_secureboot() {
    _has_feature linux-surface || { ok "not a Surface profile — nothing to do"; return 0; }
    local sb
    # bootctl status exits nonzero for unrelated boot-loader findings.
    sb=$({ bootctl status 2>/dev/null || true; } | sed -n 's/^ *Secure Boot: *//p' | head -1)
    if [[ "$sb" != enabled* ]]; then
        ok "Secure Boot ${sb:-state unknown} — no key to enroll"
        return 0
    fi
    if pacman -Q linux-surface-secureboot-mok &>/dev/null; then
        ok "linux-surface MOK package installed (if the kernel still won't boot: reboot and enroll it in the MOK manager, password 'surface')"
    elif sudo pacman -S --needed --noconfirm linux-surface-secureboot-mok; then
        warn "linux-surface key queued — reboot, choose 'Enroll MOK' in the blue screen, password: surface"
    else
        _failw surface-secureboot "could not install linux-surface-secureboot-mok"
    fi
}

setup_nvidia_niri() {
    local f=/etc/nvidia/nvidia-application-profiles-rc.d/50-limit-free-buffer-pool-in-wayland-compositors.json json
    if ! _has_feature nvidia; then
        warn "NVIDIA niri fix skipped on ${MACHINE:-this profile} (no nvidia feature)"
        return 0
    fi
    json='{
    "rules": [
        { "pattern": { "feature": "procname", "matches": "niri" },
          "profile": "Limit Free Buffer Pool On Wayland Compositors" }
    ],
    "profiles": [
        { "name": "Limit Free Buffer Pool On Wayland Compositors",
          "settings": [ { "key": "GLVidHeapReuseRatio", "value": 0 } ] }
    ]
}'
    if [[ "$(cat "$f" 2>/dev/null)" == "$json" ]]; then
        ok "already configured: NVIDIA niri VRAM fix"
        return 0
    fi
    sudo mkdir -p "${f%/*}" && printf '%s\n' "$json" | sudo tee "$f" >/dev/null \
        && ok "configured: NVIDIA niri VRAM fix ($f) — log out and back in to apply" \
        || _failw nvidia-niri "NVIDIA niri fix: failed to write $f"
}

# ─── Phase 7e: System optimisations ──────────────────────
# Idempotent CachyOS/Arch tuning — mirrors README §"System optimisations".
# Safe to re-run; each step checks current state and skips if already applied.
# Skips greetd autologin (conflicts with DMS greeter) and EFI cleanup (needs
# manual review of efibootmgr output).
optimize_system() {
    section "system optimisations"

    # 1. CPU governor → performance (desktop only; laptops want powersave on battery)
    if _has_feature cpu-performance; then
        local _conf=/etc/default/cpupower-service.conf
        if [[ -f "$_conf" ]] && ! grep -q "^GOVERNOR='performance'" "$_conf"; then
            if grep -q "^#\?GOVERNOR=" "$_conf"; then
                sudo sed -i "s/^#\?GOVERNOR=.*/GOVERNOR='performance'/" "$_conf"
            else
                echo "GOVERNOR='performance'" | sudo tee -a "$_conf" >/dev/null
            fi
            sudo systemctl restart cpupower.service 2>/dev/null || true
            sudo cpupower frequency-set -g performance &>/dev/null || true
            command -v powerprofilesctl &>/dev/null && powerprofilesctl set performance 2>/dev/null || true
            ok "CPU governor → performance"
        else
            ok "CPU governor: already performance (or no cpupower conf)"
        fi
    fi

    # 2. Disable NetworkManager-wait-online (delays boot waiting for network)
    if systemctl is-enabled NetworkManager-wait-online.service &>/dev/null; then
        sudo systemctl disable NetworkManager-wait-online.service &>/dev/null \
            && ok "disabled: NetworkManager-wait-online"
    else
        ok "NetworkManager-wait-online: already disabled"
    fi

    # 3. Mask lvm2-monitor if no LVM volumes present
    if ! lsblk -no FSTYPE 2>/dev/null | grep -q "LVM2_member"; then
        if [[ "$(systemctl is-enabled lvm2-monitor.service 2>/dev/null)" != "masked" ]]; then
            sudo systemctl mask lvm2-monitor.service &>/dev/null \
                && ok "masked: lvm2-monitor (no LVM)"
        else
            ok "lvm2-monitor: already masked"
        fi
    fi

    # 4. cachyos-rate-mirrors — delay post-boot run from 10min to 2h
    if systemctl list-unit-files cachyos-rate-mirrors.timer &>/dev/null; then
        local _ovr=/etc/systemd/system/cachyos-rate-mirrors.timer.d/override.conf
        if [[ ! -f "$_ovr" ]] || [[ "$(cat "$_ovr")" == $'[Timer]\nOnBootSec=2h' ]]; then
            sudo mkdir -p "$(dirname "$_ovr")"
            # Timer assignments accumulate. Clear the original boot trigger;
            # also migrate the exact override generated by older sysup.
            printf '[Timer]\nOnBootSec=\nOnBootSec=2h\n' | sudo tee "$_ovr" >/dev/null
            sudo systemctl daemon-reload
            ok "cachyos-rate-mirrors: OnBootSec → 2h"
        else
            ok "cachyos-rate-mirrors: override already present"
        fi
    fi

    # 5. AMD GPU performance level (desktop only; persistent udev rule)
    if _has_feature amd-gpu-tuning && lspci 2>/dev/null | grep -qi "VGA.*AMD\|Display.*AMD\|VGA.*ATI"; then
        local _rule=/etc/udev/rules.d/99-amdgpu-performance.rules
        if [[ ! -f "$_rule" ]]; then
            printf 'ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1002", ATTR{class}=="0x030000", ATTR{power_dpm_force_performance_level}="high"\n' \
                | sudo tee "$_rule" >/dev/null
            sudo udevadm control --reload-rules && sudo udevadm trigger
            ok "AMD GPU: performance level → high (udev rule)"
        else
            ok "AMD GPU: udev rule already present"
        fi
    fi

    # 6. Upgrade list as a table, one package per row (old/new version, sizes);
    #    the default packs every package onto one wrapped line (changed 2026-11-14).
    if grep -q "^VerbosePkgLists" /etc/pacman.conf; then
        ok "pacman: VerbosePkgLists already on"
    elif grep -q "^#VerbosePkgLists" /etc/pacman.conf; then
        sudo sed -i 's/^#VerbosePkgLists/VerbosePkgLists/' /etc/pacman.conf
        ok "pacman: VerbosePkgLists enabled (one package per row)"
    else
        sudo sed -i '/^\[options\]/a VerbosePkgLists' /etc/pacman.conf
        ok "pacman: VerbosePkgLists enabled (one package per row)"
    fi

    return 0
}

# ─── DMS config import/export ───────────────────────────
# DMS owns ~/.config/niri/dms/ and overwrites symlinks — can't stow it.
# DMS_AUTO   : DMS rewrites these live within seconds of every session start.
#              The repo copy is the CURATED one (hand-tuned colors etc.), so
#              export must NEVER copy live→repo for these or it destroys the
#              overrides. Import DOES push repo→live, to re-apply them.
# DMS_MANUAL : not auto-regenerated; safe to round-trip in both directions.
DMS_LIVE="$HOME/.config/niri/dms"
# Repo side of the DMS overrides lives in the chosen dotfile set.
_dms_repo() {
    [[ -n "${SYSUP_DOTSET_DIR:-}" ]] || { warn "no dotfile set chosen — DMS overrides not synced"; return 1; }
    DMS_REPO="$SYSUP_DOTSET_DIR/niri/.config/niri/dms"
}
DMS_MANUAL=(alttab.kdl binds.kdl cursor.kdl layout.kdl windowrules.kdl wpblur.kdl)
DMS_AUTO=(colors.kdl)

# _dms_copy FROM TO VERB MISSING-TEXT FILE...
_dms_copy() {
    local from="$1" to="$2" verb="$3" missing="$4" f; shift 4
    for f in "$@"; do
        if [[ -f "$from/$f" ]]; then
            cp "$from/$f" "$to/$f"
            ok "$verb: $f"
        else
            warn "$missing: $f"
        fi
    done
}

dms_export() {
    if [[ ! -d "$DMS_LIVE" ]]; then
        warn "DMS live dir not found: $DMS_LIVE — skipping"
        return
    fi
    _dms_repo || return 0
    info "Exporting DMS config: live → repo..."
    # Only DMS_MANUAL — a blanket `cp "$DMS_LIVE"/*.kdl` also drags DMS's
    # regenerated colors.kdl into the repo, silently reverting manual theme
    # overrides. That is exactly how the green focus-ring override was lost
    # in ff2cd4e (2026-06-17), unnoticed for two months.
    _dms_copy "$DMS_LIVE" "$DMS_REPO" exported "not live, not exported" "${DMS_MANUAL[@]}"
    info "skipped (auto-generated, repo copy is authoritative): ${DMS_AUTO[*]}"
    ok "exported: DMS config (commit niri/dms/)"
}

dms_import() {
    if [[ ! -d "$DMS_LIVE" ]]; then
        warn "DMS live dir not found: $DMS_LIVE — run 'dms setup' first"
        return
    fi
    _dms_repo || return 0
    _backup_dotset live-dms dms-import
    info "Importing DMS manual overrides: repo → live..."
    # DMS_AUTO included here on purpose: DMS regenerates these live, so pushing
    # the repo's curated copy back is the only way manual theme overrides stick.
    _dms_copy "$DMS_REPO" "$DMS_LIVE" imported "not in repo" "${DMS_MANUAL[@]}" "${DMS_AUTO[@]}"
}

# ─── Phase 7b: DMS Plugins ───────────────────────────────
install_dms_plugins() {
    if ! command -v dms &>/dev/null; then
        warn "dms not found — skipping plugin install"
        return
    fi

    local list="$DOTS_DIR/.dms-plugins.list"
    if [[ ! -f "$list" ]]; then
        warn ".dms-plugins.list not found — skipping"
        return
    fi

    info "Installing DMS plugins..."
    local installed added=false
    installed=$(dms plugins list 2>/dev/null) || true

    while IFS= read -r plugin; do
        [[ -z "$plugin" || "$plugin" == \#* ]] && continue
        if echo "$installed" | grep -q "ID: $plugin"; then
            ok "already installed: $plugin"
        else
            if dms plugins install "$plugin" 2>/dev/null; then
                ok "installed: $plugin"; added=true
            else
                _failw "dms-plugin:$plugin" "failed to install: $plugin"
            fi
        fi
    done < "$list"
    if $added; then _restart_dms "new plugins"; fi

}

# ─── Phase 7c: Install scripts ───────────────────────────
# `@sh <url>` lines in .install-scripts.list: download the script and run it
# with sh only if it is byte-identical to the copy that ran last time (trust on
# first use, no hash to maintain by hand). A changed script is shown as a diff;
# an interactive run asks, a --yes run skips it.
_run_pinned_sh() {
    local url="$1" dir="$STAMP_DIR/installers" tmp key
    key=$(printf '%s' "$url" | sha256sum | cut -c1-16)
    mkdir -p "$dir"
    tmp=$(mktemp) || return 1
    if ! curl -fsSL "$url" -o "$tmp"; then
        rm -f "$tmp"; warn "download failed: $url"; return 1
    fi
    if [[ -f "$dir/$key" ]] && ! cmp -s "$tmp" "$dir/$key"; then
        warn "installer changed since its last run: $url"
        diff -u "$dir/$key" "$tmp" | head -80 || true
        if ! { $INTERACTIVE && [[ -t 0 ]] && _confirm "Run the changed installer? [y/N]"; }; then
            rm -f "$tmp"
            warn "skipped changed installer — review with: curl -fsSL $url | less"
            return 1
        fi
    elif [[ ! -f "$dir/$key" ]]; then
        info "first run of $url (sha256 $(sha256sum < "$tmp" | cut -c1-16)) — recorded for next time"
    fi
    if ! sh "$tmp"; then rm -f "$tmp"; return 1; fi
    mv -f "$tmp" "$dir/$key"
}

# Codex is a normal install prerequisite; skill installers remain optional.
install_codex() {
    local cli
    cli=$(command -v codex 2>/dev/null || true)
    [[ -n "$cli" ]] || cli="$HOME/.local/bin/codex"
    if [[ -x "$cli" ]] && "$cli" --version >/dev/null 2>&1; then
        ok "already installed: Codex"
        return 0
    fi
    if _run_pinned_sh https://chatgpt.com/codex/install.sh \
        && "$HOME/.local/bin/codex" --version >/dev/null 2>&1; then
        ok "installed: Codex"
    else
        _failw codex-install "Codex installer failed or installed command could not run"
    fi
}

run_install_scripts() {
    local list="$DOTS_DIR/.install-scripts.list" installer_fd cmd
    [[ -f "$list" ]] || { warn ".install-scripts.list not found — skipping"; return; }

    info "Running install scripts..."
    # Keep commands on a separate descriptor; installers retain normal stdin.
    exec {installer_fd}< "$list"
    while IFS= read -r -u "$installer_fd" cmd || [[ -n "$cmd" ]]; do
        [[ -z "$cmd" || "$cmd" == \#* ]] && continue
        info "Running: $cmd"
        if [[ "$cmd" == "@sh "* ]]; then
            if _run_pinned_sh "${cmd#@sh }" {installer_fd}<&-; then
                _record "installer:$cmd" ok; ok "done: $cmd"
            else
                _record "installer:$cmd" fail "installer failed or changed"; warn "failed: $cmd"
            fi
            continue
        fi
        # Child shells do not inherit pipefail: a failed download piped into a
        # successful empty installer must still fail the action.
        if bash -o pipefail -c "$cmd" {installer_fd}<&-; then
            _record "installer:$cmd" ok
            ok "done: $cmd"
        else
            _record "installer:$cmd" fail "installer command failed"
            warn "failed: $cmd"
        fi
    done
    exec {installer_fd}<&-
}

# ─── Phase 7g: Ollama model setup ───────────────────────
setup_ollama() {
    if ! command -v ollama &>/dev/null; then
        warn "ollama not found — skipping model pull"
        return
    fi

    if ! _has_feature ollama-model; then
        warn "ollama model pull skipped on ${MACHINE:-this profile} (no ollama-model feature) — see TODO.md"
        return
    fi

    # Re-pulling an unchanged tag only checks the manifest, so updates call this too.
    local models=(qwen3.5) model mf
    _has_feature rag-stack && models+=(nomic-embed-text)  # embeddings for claude-context + LightRAG
    for model in "${models[@]}"; do
        info "Pulling ollama model: $model..."
        ollama pull "$model" &>/dev/null \
            && ok "$model up to date" \
            || _failw "ollama:$model" "ollama pull failed — run manually: ollama pull $model"
    done
    # Each <name>.Modelfile is rebuilt as model <name> after the pulls: the
    # qwen3.5 VRAM cap overwrites the official tag the pull just restored.
    for mf in "$DOTS_DIR"/scripts/.local/share/ollama/*.Modelfile; do
        [[ -f "$mf" ]] || continue
        model=$(basename "$mf" .Modelfile)
        ollama create "$model" -f "$mf" &>/dev/null \
            && ok "$model rebuilt" \
            || _failw "ollama:$model" "ollama create failed — run manually: ollama create $model -f $mf"
    done
}

# Update path: silent where the profile has no model or ollama isn't running.
# Refresh the plugin marketplaces, then update every user-scope Claude Code
# plugin to its latest version (applies on the next Claude start).
update_claude_plugins() {
    command -v claude &>/dev/null || return 0
    command -v jq &>/dev/null || { warn "jq missing — Claude plugins not updated"; return 0; }
    info "Updating Claude Code plugins..."
    if ! claude plugin marketplace update </dev/null >/dev/null 2>&1; then
        warn "Claude marketplace refresh failed — plugins not updated"; return 0
    fi
    local id bad=()
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        claude plugin update "$id" --scope user </dev/null >/dev/null 2>&1 || bad+=("$id")
    done < <(claude plugin list --json 2>/dev/null | jq -r '.[]? | select(.scope == "user") | .id')
    if (( ${#bad[@]} )); then
        _failw claude-plugins "Claude plugin update failed: ${bad[*]} — run: claude plugin update <id>"
    else
        _record claude-plugins ok; ok "Claude plugins up to date"
    fi
}

# DMS runs the shell it loaded at login: an upgrade of the shell, its system
# monitor or quickshell (or a new DMS plugin) only applies after a restart.
_DMS_PKGS=(dux-shell dux-gop quickshell)
_dms_versions() { pacman -Q "${_DMS_PKGS[@]}" 2>/dev/null || true; }
_restart_dms() {
    systemctl --user is-active -q dms.service 2>/dev/null || return 0
    if systemctl --user restart dms.service; then
        ok "DMS restarted ($1)"
    else
        _failw dms "DMS restart failed — run: systemctl --user restart dms.service"
    fi
}
# <versions before> : restart when any DMS package line changed.
_restart_dms_if_changed() {
    local now changed
    now=$(_dms_versions)
    [[ "$now" != "$1" ]] || return 0
    changed=$(grep -vxF -f <(printf '%s\n' "$1") <<< "$now" | awk '{print $1}' | tr '\n' ' ')
    _restart_dms "updated: ${changed% }"
}

update_ollama() {
    _has_feature ollama-model && command -v ollama &>/dev/null || return 0
    systemctl is-active -q ollama || { warn "ollama not running — model update skipped"; return 0; }
    setup_ollama
}

# projects.toml `build`: pull each repo (fast-forward only) and rerun its build
# when HEAD moved since the last successful build. A repo with local changes is
# being worked on, so it is neither pulled nor rebuilt.
update_projects() {
    local list="$SYSUP_PLAN_DIR/project-builds.list" name cmd dir head stamp
    [[ -s "$list" ]] || return 0
    mkdir -p "$STAMP_DIR/builds"
    while IFS=$'\t' read -r name cmd || [[ -n "$name" ]]; do
        [[ -n "$name" && -n "$cmd" ]] || continue
        dir="$HOME/Projects/$name"
        [[ -d "$dir/.git" ]] || continue  # not cloned yet: the sources phase clones it
        if [[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]]; then
            warn "$name: local changes — not pulled or rebuilt"
            continue
        fi
        if ! GIT_TERMINAL_PROMPT=0 git -C "$dir" pull --ff-only -q </dev/null; then
            _failw "build:$name" "$name: git pull --ff-only failed"
            continue
        fi
        head=$(git -C "$dir" rev-parse HEAD) || continue
        stamp="$STAMP_DIR/builds/$name"
        if [[ "$(cat "$stamp" 2>/dev/null)" == "$head" ]]; then
            ok "up to date: $name"
            continue
        fi
        info "Building $name..."
        # Lowest priority like _paru; stdin closed so a build can't eat the list.
        if (cd "$dir" && nice -n "$(( 19 - $(nice) ))" bash -o pipefail -c "$cmd") </dev/null; then
            printf '%s\n' "$head" > "$stamp"
            _record "build:$name" ok
            ok "built: $name"
        else
            _failw "build:$name" "$name: build failed: $cmd"
        fi
    done < "$list"
}

# ─── Phase 7f: VM setup ──────────────────────────────────
setup_vms() {
    if ! _has_feature windows-vm; then
        warn "VM setup skipped on ${MACHINE:-this profile} (no windows-vm feature)"
        return 0
    fi
    if ! command -v docker &>/dev/null; then
        warn "docker not found — skipping VM setup"
        return
    fi

    info "Setting up VM storage directories..."
    local win_storage=/mnt/data/windows-vm-storage
    [[ -d /mnt/data && "$(stat -c '%U' /mnt/data)" != "$USER" ]] && sudo chown "$USER:$USER" /mnt/data
    mkdir -p "$win_storage"
    if [[ ! -L "$DOTS_DIR/windows/storage" ]]; then
        ln -sfn "$win_storage" "$DOTS_DIR/windows/storage"
    fi
    ok "VM storage dirs ready"

    info "Pulling VM images..."
    docker pull dockurr/windows &>/dev/null \
        && ok "pulled: VM images" \
        || _failw vms "docker pull dockurr/windows failed"
}

# ─── Phase 7e: Fish plugins (tide prompt) ────────────────
# fish_variables is NOT tracked (tide writes a per-session prompt cache that
# would churn git endlessly), so the prompt is reproduced here instead.
setup_fish() {
    command -v fish &>/dev/null || { warn "fish not installed — skipping fish setup"; return; }
    if ! fish -c 'functions -q fisher' 2>/dev/null; then
        warn "fisher not found — add 'fisher' to packages.toml; skipping"
        return
    fi

    # Installed tide needs no network: a GitHub API outage used to warn every run.
    if fish -c 'functions -q tide' 2>/dev/null; then
        ok "already installed: tide"
    else
        info "Installing fish plugins (tide)..."
        fish -c 'fisher install IlanCosman/tide@v6' >/dev/null 2>&1 \
            && ok "installed: tide" \
            || _failw fish "tide install failed — run manually: fisher install IlanCosman/tide@v6"
    fi

    # Configure only on first setup so later manual tweaks aren't overwritten.
    if fish -c 'set -q _tide_left_items' 2>/dev/null; then
        ok "already configured: tide"
    else
        info "Applying tide rainbow preset..."
        fish -c "tide configure --auto --style=Rainbow --prompt_colors='True color' --show_time='24-hour format' --rainbow_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='One line' --prompt_connection=Disconnected --powerline_right_prompt_frame=No --prompt_connection_andor_frame_color=Lightest --prompt_spacing=Sparse --icons='Many icons' --transient=No" \
            && ok "configured: tide (rainbow)" \
            || _failw fish "tide configure failed — run manually: tide configure"
    fi

    # Apply theme colors — idempotent, runs every bootstrap so colors
    # survive tide reconfigures. Source: dank-theme.toml blue/steel palette.
    info "Applying blue/steel tide colors..."
    fish -c "
        set -U tide_os_bg_color                  1c2430
        set -U tide_os_color                     9dcbfb
        set -U tide_context_bg_color             101e2c
        set -U tide_context_color_default        839fbc
        set -U tide_pwd_bg_color                 124a73
        set -U tide_pwd_color_anchors            e0e2e8
        set -U tide_pwd_color_dirs               e0e2e8
        set -U tide_pwd_color_truncated_dirs     5c6370
        set -U tide_git_bg_color                 1a3a28
        set -U tide_git_color_branch             e0e2e8
        set -U tide_git_color_dirty              e0e2e8
        set -U tide_git_color_staged             e0e2e8
        set -U tide_git_color_untracked          e0e2e8
        set -U tide_git_color_upstream           e0e2e8
        set -U tide_git_bg_color_unstable        3a3010
        set -U tide_git_bg_color_urgent          3a1010
        set -U tide_character_color              9dcbfb
        set -U tide_character_color_failure      d75a59
        set -U tide_status_bg_color              101e2c
        set -U tide_status_color                 8ed88c
        set -U tide_status_color_failure         d75a59
        set -U tide_prompt_color_frame_and_connection 124a73
        set -U tide_prompt_color_separator_same_color 4087bc
    " && ok "applied: tide colors (blue/steel)" \
      || _failw fish "tide color set failed — run manually: set -U tide_pwd_bg_color 124a73"
}

# ─── Phase 8: Claude Code ────────────────────────────────
setup_claude() {
    if ! command -v claude &>/dev/null; then
        warn "claude-code not in PATH — skipping plugin setup"
        return
    fi

    info "Setting up Claude Code plugins..."
    # settings.json is already stowed and sets enabledPlugins.
    # These commands install the plugin assets (skills, hook scripts).
    local entry market plugin hint installed installed_json full_id out
    installed_json=$(claude plugin list --json 2>/dev/null) || installed_json='[]'
    installed=$(jq -r '.[]? | select(type == "object" and .scope == "user") | .id // empty' \
        <<< "$installed_json" 2>/dev/null) || installed=""
    # "marketplace-repo plugin-id"; "-" uses the official marketplace.
    for entry in "JuliusBrussee/caveman caveman" \
                 "- superpowers@claude-plugins-official" \
                 "DietrichGebert/ponytail ponytail" \
                 "Egonex-AI/Understand-Anything understand-anything@understand-anything"; do
        read -r market plugin <<< "$entry"
        full_id="$plugin"
        [[ "$plugin" == *@* ]] || full_id="$plugin@${market##*/}"
        if grep -qxF "$full_id" <<< "$installed"; then
            ok "already installed: ${plugin%@*}"
            continue
        fi
        hint="claude plugin install $plugin --scope user"
        [[ "$market" == - ]] || {
            claude plugin marketplace add "$market" || true
            hint="claude plugin marketplace add $market && $hint"
        }
        if out=$(claude plugin install "$plugin" --scope user 2>&1); then
            [[ -z "$out" ]] || printf '%s\n' "$out"
            ok "installed: ${plugin%@*}"
        else
            [[ -z "$out" ]] || printf '%s\n' "$out"
            _failw claude "${plugin%@*} plugin install failed — run manually: $hint"
        fi
    done

    # Graphify is distributed as a CLI plus an assistant skill, not a
    # marketplace plugin. The CLI itself is managed by [uv].install.
    if [[ -f "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/graphify/SKILL.md" ]]; then
        ok "already installed: graphify (Claude skill)"
    elif command -v graphify &>/dev/null; then
        graphify install --platform claude \
            && ok "installed: graphify (Claude skill)" \
            || _failw claude "graphify skill install failed — run manually: graphify install --platform claude"
    else
        _failw claude "graphify CLI missing — install graphifyy, then run: graphify install --platform claude"
    fi

    _setup_rea
    _setup_rag

    # No statusline wiring here on purpose. settings.json is stowed and points at
    # ~/.claude/statusline.sh, which globs the version-hashed plugin paths at
    # runtime — so nothing needs regenerating after a plugin update, and this
    # function can no longer clobber a hand-edited statusline.
}

# REA (rea-agents, [npm].install): MCP server + skill for Claude Code and Codex.
# The skill lands in the stowed ~/.claude/skills; the MCP entries live in
# ~/.claude.json and ~/.codex/config.toml (untracked), so each machine runs setup.
_setup_rea() {
    command -v rea &>/dev/null || { warn "rea not installed — skipping REA setup (npm i -g rea-agents)"; return 0; }
    if claude mcp get rea &>/dev/null; then
        ok "already registered: rea (MCP)"
        return 0
    fi
    local out
    local -a clients=(--client claude_code)
    command -v codex &>/dev/null && clients+=(--client codex)
    if out=$(cd ~ && rea setup --yes "${clients[@]}" 2>&1); then
        ok "registered: rea (MCP + skill)"
    else
        _show_install_error "$out"
        _failw claude "REA setup failed — run manually: rea setup"
    fi
}

# rag-stack feature (docs/rag-tools.md): Milvus container for claude-context,
# then the claude-context + godot MCP servers for Claude Code and Codex. The npm
# binaries come from the profile's [npm]; MCP entries are untracked, like REA's.
_setup_rag() {
    _has_feature rag-stack || return 0
    if command -v docker &>/dev/null; then
        docker compose -f "$DOTS_DIR/rag/docker-compose.yml" up -d &>/dev/null \
            && ok "running: milvus (rag/)" \
            || _failw rag "milvus start failed — run manually: docker compose -f $DOTS_DIR/rag/docker-compose.yml up -d"
    else
        warn "docker not found — milvus not started"
    fi
    local name bin out
    local -a env
    for name in claude-context godot; do
        case $name in
            claude-context) bin=claude-context-mcp
                env=(EMBEDDING_PROVIDER=Ollama EMBEDDING_MODEL=nomic-embed-text
                     MILVUS_ADDRESS=127.0.0.1:19530 "CUSTOM_EXTENSIONS=.gd,.tscn") ;;
            godot) bin=godot-mcp; env=(GODOT_PATH=/usr/bin/godot) ;;
        esac
        command -v "$bin" &>/dev/null || { warn "$bin not installed — $name MCP skipped (install phase)"; continue; }
        bin=$(command -v "$bin")
        if claude mcp get "$name" &>/dev/null; then
            ok "already registered: $name (MCP)"
        elif out=$(claude mcp add -s user "$name" "${env[@]/#/--env=}" -- "$bin" 2>&1); then
            ok "registered: $name (MCP)"
        else
            _show_install_error "$out"
            _failw claude "$name MCP registration failed"
        fi
        command -v codex &>/dev/null || continue
        if codex mcp get "$name" &>/dev/null; then
            ok "already registered: $name (Codex MCP)"
        elif out=$(codex mcp add "$name" "${env[@]/#/--env=}" -- "$bin" 2>&1); then
            ok "registered: $name (Codex MCP)"
            # Milvus + Ollama make the first start slow; codex mcp add has no timeout flag.
            [[ $name != claude-context ]] \
                || sed -i '/^\[mcp_servers\.claude-context\]$/a startup_timeout_ms = 20000' "$HOME/.codex/config.toml"
        else
            _show_install_error "$out"
            _failw claude "$name Codex MCP registration failed"
        fi
    done
}

# ─── Phase 8b: caveman-code ──────────────────────────────
setup_caveman_code() {
    _ensure_package_command npm npm || return 0
    _ensure_npm_prefix || return 0

    info "Installing caveman-code..."
    local out
    if out=$(npm install -g @juliusbrussee/caveman-code 2>&1); then
        ok "installed: caveman-code"
    else
        _show_install_error "$out"
        _failw caveman-code "caveman-code npm install failed: $(grep . <<< "$out" | tail -n 1)"
        return
    fi

    local cli
    cli="$(npm root -g 2>/dev/null)/@juliusbrussee/caveman-code/dist/cli.js"
    ln -sfn "$cli" "$HOME/.local/bin/caveman-code"
    ln -sfn "$cli" "$HOME/.local/bin/caveman"
    ok "linked: caveman-code → $cli"
}

# ─── Phase 8: Projects ───────────────────────────────────
clone_projects() {
    local list="$SYSUP_PLAN_DIR/projects.list"
    [[ -f "$list" ]] || { warn "projects.list not in run plan — skipping"; return; }

    info "Cloning projects into ~/Projects/..."
    mkdir -p "$HOME/Projects"
    while IFS= read -r repo; do
        [[ -z "$repo" || "$repo" == \#* ]] && continue
        local name; name=$(basename "$repo" .git)
        if [[ -d "$HOME/Projects/$name" ]]; then
            ok "already exists: $name"
        else
            git clone "$repo" "$HOME/Projects/$name" && ok "cloned: $name" || warn "failed: $repo"
        fi
    done < "$list"
}

# Both upgrade entry points retain the same actionable failure details.
_record_upgrade_failure() {
    local detail="${SYUU_FAIL_DETAIL:-paru -Syuu returned non-zero}"
    _record "full-upgrade" fail "$detail"
    warn "Full upgrade failed: $detail"
}

# ─── Maintenance: system update ──────────────────────────
system_update() {
    refresh_mirrors
    _upgrade_system "system up to date" "Updating all packages..." warn-conflicts
}

# ─── Maintenance: flatpak update ─────────────────────────
flatpak_update() {
    if ! command -v flatpak &>/dev/null; then
        warn "flatpak not installed — skipping"
        return
    fi
    info "Updating flatpak apps..."
    flatpak update -y
    ok "flatpaks up to date"
}

# ─── Maintenance: flatpak unused runtimes ────────────────
check_flatpak_orphans() {
    if ! command -v flatpak &>/dev/null; then
        warn "flatpak not installed — skipping"
        return
    fi
    info "Removing unused flatpak runtimes..."
    flatpak uninstall --unused --assumeyes --noninteractive \
        && ok "removed: unused flatpak runtimes" \
        || warn "flatpak uninstall --unused had warnings"
}

# ─── Maintenance: cache cleanup ──────────────────────────
# Remove clone dirs none of whose .SRCINFO pkgnames (dir name if none) is installed.
_prune_aur_clones() {
    local dir=$1 d names installed pruned=() kb=0 s
    [[ -d "$dir" ]] || return 0
    installed=$(pacman -Qq) || return 1
    for d in "$dir"/*/; do
        d=${d%/}
        [[ -d "$d" ]] || continue
        names=$(awk -F' = ' '/^[[:space:]]*pkgname = / { print $2 }' "$d/.SRCINFO" 2>/dev/null || true)
        [[ -n "$names" ]] || names=${d##*/}
        grep -qxFf <(printf '%s\n' "$names") <<< "$installed" && continue
        s=$(du -sk "$d" 2>/dev/null | cut -f1 || true)
        rm -rf -- "$d" && pruned+=("${d##*/}") && kb=$((kb + ${s:-0}))
    done
    (( ${#pruned[@]} )) || return 0
    ok "removed AUR clones of uninstalled packages ($((kb / 1024)) MiB): ${pruned[*]}"
}

clean_caches() {
    info "Cleaning package caches..."
    local _cache_ok=true
    # Guarded like check_pacnew/check_rebuilds: paccache ships in pacman-contrib,
    # which may not be installed yet if a fresh bootstrap failed mid-install.
    # Unguarded, it would abort the run before print_recap.
    if command -v paccache &>/dev/null; then
        sudo paccache -rk2  || { _cache_ok=false; warn "paccache -rk2 failed$(_sudo_cause)"; }
        sudo paccache -ruk0 || { _cache_ok=false; warn "paccache -ruk0 failed$(_sudo_cause)"; }
    else
        _cache_ok=false
        warn "paccache not found — install pacman-contrib"
    fi

    # ~/.cache/paru/clone holds the AUR checkouts paru reuses and
    # _review_aur_updates diffs against, so only clones of packages no longer
    # installed go; --clean wipes the whole paru/yay cache.
    local _paru_cache="$HOME/.cache/paru" _summary="pacman; AUR sources of installed packages kept"
    if $CLEAN; then
        rm -rf "$_paru_cache" "$HOME/.cache/yay" \
            || { _cache_ok=false; warn "AUR cache removal failed"; }
        _summary="--clean: AUR sources removed, next build re-clones"
    else
        _prune_aur_clones "$_paru_cache/clone" || { _cache_ok=false; warn "could not prune stale AUR clones"; }
    fi
    if $_cache_ok; then
        _record "cache-cleanup" ok
        ok "caches cleaned ($_summary)"
    else
        _record "cache-cleanup" fail "one or more cleanup operations failed"
    fi
    # Failure is retained for the final recap, while independent work continues.
    return 0
}

# ─── Audit: unlisted / unused apps (report only) ────────
# Apps with a launcher that no package list mentions, and apps with no DMS
# usage record in 60 days. Logic and data sources: sysup.py (report).
check_unused_apps() {
    info "Checking for unlisted and unused apps..."
    local out
    if ! out=$(_py unused "$SYSUP_PLAN_DIR" 60 2>&1); then
        warn "unused-app check failed: ${out##*$'\n'}"
        return 0
    fi
    if [[ -z "$out" ]]; then ok "no unlisted or unused apps"; return 0; fi
    while IFS= read -r line; do
        case "$line" in
            "Unused-app check starts"*) ok "$line" ;;
            *"installed but in no package list"*)
                local p
                for p in ${line##*: }; do _queue_fix unlisted "$p"; done
                warn "$line" ;;
            *) warn "$line" ;;
        esac
    done <<< "$out"
}

# Package config files changed from their packaged version (aconfmgr-style
# drift tracking). Most are expected (fstab, pacman.conf, mirrorlists), so only
# files changed since the last audit are reported; the full list stays in the
# state dir as the baseline.
check_modified_configs() {
    info "Checking modified package config files..."
    local now prev="$STAMP_DIR/modified-configs.txt" new
    mkdir -p "$STAMP_DIR"
    now=$(pacman -Qii 2>/dev/null | grep -oE '/[^ ]+ \[modified\]' | sed 's/ \[modified\]$//' | sort -u || true)
    if [[ -z "$now" ]]; then ok "no modified package config files"; return 0; fi
    if [[ -f "$prev" ]]; then
        new=$(comm -13 "$prev" - <<< "$now" || true)
        if [[ -n "$new" ]]; then
            warn "package config files modified since last audit: $(tr '\n' ' ' <<< "$new")(baseline: $prev)"
        else
            ok "no new config changes ($(wc -l <<< "$now") modified overall, see $prev)"
        fi
    else
        ok "recorded $(wc -l <<< "$now") modified config files as baseline: $prev"
    fi
    printf '%s\n' "$now" > "$prev"
}

# DMS started twice (systemd user unit AND a niri spawn-at-startup) gives two
# bars, two notification daemons and doubled IPC handling.
# linux-surface profiles need the surface kernel (ithc/ipts touchscreen
# modules). CachyOS sets GRUB_TOP_LEVEL to linux-cachyos, so GRUB boots that
# first: no touchscreen, no warning (2026-11-01).
check_surface_kernel() {
    _has_feature linux-surface || return 0
    [[ "$(uname -r)" == *surface* ]] && { ok "running the surface kernel"; return 0; }
    if pacman -Q linux-surface &>/dev/null; then
        warn "running $(uname -r), not linux-surface — touchscreen/pen need it; run vjsurface (sets GRUB_TOP_LEVEL), then reboot"
    else
        warn "linux-surface is not installed — run vjsurface or the Install action"
    fi
}

check_dms_owner() {
    command -v dms &>/dev/null || return 0
    systemctl --user is-enabled --quiet dms.service 2>/dev/null || return 0
    local spawn
    spawn=$(grep -RhsE '^[[:space:]]*spawn(-sh)?-at-startup.*\b(dms|qs)\b' --include='*.kdl' "$HOME/.config/niri" | head -1 || true)
    if [[ -n "$spawn" ]]; then
        warn "DMS is started twice: dms.service is enabled and niri runs '${spawn#"${spawn%%[![:space:]]*}"}' — keep one"
    else
        ok "DMS has one owner (dms.service)"
    fi
}

# Logins a fresh install still needs. Local checks only (no network), and only
# for tools that are installed, so a finished machine prints nothing.
check_logins() {
    info "Checking logins..."
    local need=()
    if command -v gh &>/dev/null && ! gh auth token &>/dev/null; then need+=("GitHub: gh auth login"); fi
    if ! compgen -G "$HOME/.ssh/id_*.pub" >/dev/null; then need+=("SSH key for git@ clones/pushes: ssh-keygen -t ed25519, add the .pub on GitHub"); fi
    if command -v claude &>/dev/null && [[ ! -f "$HOME/.claude/.credentials.json" ]]; then need+=("Claude Code: run claude, then /login"); fi
    if command -v codex &>/dev/null && [[ ! -f "$HOME/.codex/auth.json" ]]; then need+=("Codex: codex login"); fi
    if command -v spotify_player &>/dev/null && [[ ! -f "$HOME/.cache/spotify-player/credentials.json" ]]; then need+=("spotify-player: run spotify_player once and log in"); fi
    if command -v vesktop &>/dev/null && [[ ! -d "$HOME/.config/vesktop/sessionData" ]]; then need+=("Vesktop: open it and log in to Discord"); fi
    local m
    for m in "${need[@]}"; do warn "login needed — $m"; done
    (( ${#need[@]} )) || ok "all logins present"
}

# Files under / that no package owns (lostfiles). Slow (~1 min), so it is an
# explicit action (--actions lostfiles), not part of every audit. Report only.
report_unowned_files() {
    command -v pacreport &>/dev/null || { warn "pacreport not found — install pacutils"; return 0; }
    local out="$STAMP_DIR/unowned-files.txt"
    info "Scanning for files no package owns (about a minute)..."
    if pacreport --unowned-files > "$out" 2>/dev/null; then
        ok "$(grep -c '^ ' "$out" || true) unowned paths listed in $out"
        _record "unowned-files" ok
    else
        _record "unowned-files" fail "pacreport failed"
        warn "pacreport --unowned-files failed"
    fi
}

# ─── Maintenance: foreign packages + orphan removal ──────
check_foreign_orphans() {
    info "Checking foreign (AUR) packages..."
    local foreign
    foreign=$(pacman -Qm 2>/dev/null || true)
    if [[ -n "$foreign" ]]; then
        echo "$foreign"
        echo "$foreign" > "$HOME/foreign-pkgs.txt"
        ok "saved: foreign pkgs (~/foreign-pkgs.txt)"
    else
        ok "no foreign packages"
    fi

    info "Checking for orphaned packages..."
    local orphans
    orphans=$(paru -Qdtq 2>/dev/null || true)
    if [[ -z "$orphans" ]]; then
        ok "no orphans"
        return
    fi
    echo "$orphans"
    if ! $AUDIT_ORPHAN_REMOVAL; then
        _queue_fix orphans "$(echo $orphans)"
        warn "Orphan removal skipped — fix offered at the end, or enable orphan-removal"; return
    fi
    local o keep=()
    while IFS= read -r o; do
        if _is_protected "$o"; then warn "protected, not removed: $o"; else keep+=("$o"); fi
    done <<< "$orphans"
    (( ${#keep[@]} )) || return 0
    sudo pacman -Rns --noconfirm "${keep[@]}"
    ok "removed: orphans"
}

# ─── Maintenance: python rebuild check ───────────────────
check_python_rebuilds() {
    info "Checking Python packages needing rebuild..."
    local current_version
    current_version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")

    local old_dirs="" d
    for d in /usr/lib/python3.*/; do
        d="${d%/}"
        [[ -d "$d" && "$d" != "/usr/lib/python${current_version}" ]] && old_dirs+="$d"$'\n'
    done
    old_dirs="${old_dirs%$'\n'}"
    if [[ -z "$old_dirs" ]]; then
        ok "no stale python dirs"
        return
    fi

    local all_packages=""
    while IFS= read -r dir; do
        local dir_packages
        dir_packages=$(pacman -Qoq "$dir" 2>/dev/null || true)
        if [[ -n "$dir_packages" ]]; then
            warn "Packages with files in $dir:"
            echo "$dir_packages"
            all_packages="$all_packages $dir_packages"
        fi
    done <<< "$old_dirs"

    local unique_packages
    unique_packages=$(echo "$all_packages" | tr ' ' '\n' | sort -u | _without_held_packages | tr '\n' ' ' | xargs 2>/dev/null || true)
    if [[ -z "$unique_packages" ]]; then
        ok "no python rebuilds needed"
        return
    fi

    warn "Packages needing Python rebuild: $unique_packages"
    if ! $AUDIT_PYTHON_REBUILD; then warn "Python rebuild skipped — enable via configure checklist"; return; fi
    # shellcheck disable=SC2086  # word-split intended: multiple package args
    _paru -S --noconfirm $unique_packages
    ok "python packages rebuilt"
}

# ─── Maintenance: rebuild check ──────────────────────────
check_rebuilds() {
    if ! command -v checkrebuild &>/dev/null; then
        warn "checkrebuild not found — install rebuild-detector"
        return
    fi
    info "Checking for packages needing rebuild..."
    local out
    out=$(checkrebuild 2>/dev/null || true)
    if [[ -z "$out" ]]; then
        ok "no rebuilds needed"
        return
    fi
    local packages
    packages=$(awk -F'\t' '{print $2}' <<<"$out" | _without_held_packages | tr '\n' ' ' | xargs)
    if [[ -z "$packages" ]]; then
        ok "no unheld rebuilds needed"
        return
    fi
    warn "Packages needing rebuild: $packages"
    if ! $AUDIT_REBUILD; then warn "Rebuild skipped — enable via configure checklist"; return; fi
    # shellcheck disable=SC2086  # word-split intended: multiple package args
    _paru -S --noconfirm $packages
    ok "packages rebuilt"
}

# ─── Maintenance: kernel management ─────────────────────
manage_kernels() {
    info "Installed kernels:"
    pacman -Q | grep "^linux-cachyos" || echo "  (none)"
    echo ""
    info "Available CachyOS kernels:"
    pacman -Ss "^linux-cachyos" 2>/dev/null \
        | grep "^cachyos" \
        | grep -v "headers\|docs\|nvidia\|zfs\|virtualbox" \
        || echo "  (run 'pacman -Ss linux-cachyos' to see all)"
    echo ""

    if _confirm "Install a kernel? [y/N]:"; then
        read -rp "Package name (e.g. linux-cachyos-lts): " kernel_pkg
        # paru self-escalates; running it under sudo breaks makepkg (refuses root)
        [[ -n "$kernel_pkg" ]] && paru -S "$kernel_pkg" "${kernel_pkg}-headers"
    fi

    if _confirm "Remove a kernel? [y/N]:"; then
        read -rp "Package name to remove: " remove_pkg
        if [[ -n "$remove_pkg" ]]; then
            local running_kernel running_pkg
            running_kernel=$(uname -r)
            # uname's release string is not pacman's package version. Resolve
            # the owner of the running kernel image instead. After an upgrade
            # its old module tree may be gone; refuse removal if ownership is
            # unavailable rather than guessing that the package is safe.
            if ! running_pkg=$(pacman -Qoq "/usr/lib/modules/$running_kernel/vmlinuz" 2>/dev/null) \
                || [[ -z "$running_pkg" || "$running_pkg" == *$'\n'* ]]; then
                warn "Cannot identify package owning running kernel ($running_kernel) — reboot before removing kernels"
                _record "kernel-removal" fail "running kernel owner unknown"
                return 1
            fi
            if [[ "$remove_pkg" == "$running_pkg" ]]; then
                warn "Cannot remove running kernel ($running_kernel) — reboot first"
                _record "kernel-removal" fail "requested package owns the running kernel"
                return 1
            else
                sudo pacman -R "$remove_pkg" "${remove_pkg}-headers" 2>/dev/null \
                    || sudo pacman -R "$remove_pkg"
            fi
        fi
    fi
    ok "kernel management done"
}

# ─── Maintenance: pacnew files ───────────────────────────
# pacnew's 'o' (overwrite) replaced pacman.conf with the stock Arch file
# (CachyOS repos and multilib gone) and the mirrorlist with an all-commented
# one, breaking pacman (2026-11-01). Snapshot both before the merge and put
# the old file back if a merge drops a repo section or every Server line.
_PACMAN_CONF_FILES=(/etc/pacman.conf /etc/pacman.d/*mirrorlist)
_snapshot_pacman_conf() {
    local f
    for f in "${_PACMAN_CONF_FILES[@]}"; do
        [[ -f "$f" ]] && cp -p "$f" "$1/${f//\//%}"
    done
    return 0
}
_restore_lost_repos() {
    local snap f lost
    for snap in "$1"/*; do
        [[ -f "$snap" ]] || continue
        f=${snap##*/}; f=${f//%//}
        if [[ "$f" == */pacman.conf ]]; then
            lost=$(comm -23 <(grep -o '^\[[^]]*\]' "$snap" | sort -u) \
                            <(grep -o '^\[[^]]*\]' "$f" 2>/dev/null | sort -u) | tr '\n' ' ')
        elif grep -q '^Server' "$snap" && ! grep -q '^Server' "$f" 2>/dev/null; then
            lost="every Server line"
        else
            lost=""
        fi
        [[ -n "$lost" ]] || continue
        if sudo cp -p "$snap" "$f"; then
            warn "pacnew merge dropped ${lost% } from $f — restored the previous file; merge it by hand (pacdiff, 'd' then edit)"
        else
            _failw pacnew "pacnew merge dropped ${lost% } from $f and restoring it failed — copy it back from $f.bak"
        fi
    done
}

check_pacnew() {
    info "Checking for pacnew files..."
    if ! command -v pacdiff &>/dev/null; then
        warn "pacdiff not found — install pacman-contrib"
        return
    fi
    local pending
    pending=$(pacdiff -o 2>/dev/null || true)
    [[ -z "$pending" ]] || printf '%s\n' "$pending"
    if ! $AUDIT_PACNEW; then
        [[ -z "$pending" ]] || _queue_fix pacnew "$(grep -c . <<< "$pending")"
        return 0
    fi
    # pacdiff prompts per file and opens $DIFFPROG (here micro: both files as
    # tabs, no diff view — use 'd' to see the diff first), so it needs a
    # terminal — a --yes run would block on stdin forever.
    if ! $INTERACTIVE; then
        warn "pacnew merge skipped — needs a terminal, run: sysup --actions pacnew-merge"
        return
    fi
    # -s: pacdiff does its own sudo/sudoedit, so this stays unprivileged.
    # -b: overwrites keep a .bak, since most of these configs are hand-tuned
    #     (pacman.conf's cachyos repos, rate-mirrors lists, locale.gen).
    info "Merging pacnew files (per file: v=view d=diff s=skip r=remove o=overwrite q=quit)"
    local snap; snap=$(mktemp -d) || return 0
    _snapshot_pacman_conf "$snap"
    DIFFPROG="${DIFFPROG:-micro}" pacdiff -s -b || true
    _restore_lost_repos "$snap"
    rm -rf "$snap"
    ok "pacnew merge done"
}

# ─── Security: AUR malware check ─────────────────────────
check_aur_malware() {
    local repo_dir="$HOME/.local/share/aur-malware-check"
    info "Checking AUR malware (supply chain attack scan)..."
    _update_malware_defs \
        || die "aur-malware-check: failed to update definitions — cannot proceed without them"
    local result rc=0
    # || rc=$? is load-bearing: aur_check exits non-zero exactly when it finds
    # something, and set -e would kill the script here before the reporting
    # below ever printed why.
    result=$(cd "$repo_dir" && python -m aur_check --full --refresh --json 2>/dev/null) || rc=$?
    # aur_check's exit codes are graded (aur_check/constants.py ExitCode):
    #   0 OK  1 WARNING  2 CRITICAL  3 UNKNOWN
    # WARNING means "could not fully verify" (missing/unreadable pacman logs)
    # with NO indicators found — models.py returns it only after every hit list
    # comes back empty. Lumping 1 and 3 in with 2 cried malware over a missing
    # log file. Parse the code, the warning kinds and their details in one go.
    local parsed verdict kinds detail
    # Any shape error (not an object, exit_code not an integer, warnings not a
    # list of objects) makes jq fail, and the whole result counts as unreadable.
    parsed=$(jq -r '
        def kind: if (.kind // "") == "" then "?" else .kind end;
        if (.exit_code | type) != "number" or (.exit_code | floor) != .exit_code then error("bad exit_code") else . end
        | (.warnings // []) as $ws
        | if ($ws | type) != "array" or any($ws[]; type != "object") then error("bad warnings") else . end
        | (.exit_code | tostring),
          ([$ws[] | kind] | unique | join(", ")),
          ($ws[] | "      - " + kind + ": " + ((.detail // "") | tostring))
        ' <<< "$result" 2>/dev/null) || parsed=$'unreadable\n'
    verdict=$(printf '%s\n' "$parsed" | sed -n '1p')
    kinds=$(printf '%s\n'  "$parsed" | sed -n '2p')
    detail=$(printf '%s\n' "$parsed" | tail -n +3)
    case "$verdict" in
        0)
            # A JSON body saying "clean" while the process exited non-zero means
            # the two disagree; trusting the body would let a crash after the
            # dump read as a pass. aur_check exits with its own ExitCode, so a
            # clean verdict must come with rc=0.
            if [[ $rc -ne 0 ]]; then
                echo "$result"
                die "aur malware check: scanner reported clean but exited $rc — inconsistent, cannot verify, aborting"
            fi
            ok "aur malware check: clean" ;;
        1)
            # Blocks, as an unverifiable system is not a safe one — but say so
            # honestly instead of claiming an infection nobody detected.
            echo -e "${YEL}    scan could not fully verify:${NC}"
            [[ -n "$detail" ]] && printf '%s\n' "$detail"
            die "aur malware check: verification INCOMPLETE (${kinds:-unspecified warnings}) — no indicators found, but the scan was not conclusive; aborting" ;;
        2)
            echo "$result"
            die "aur malware check: POSSIBLE INFECTION DETECTED — aborting" ;;
        3)
            echo "$result"
            die "aur malware check: scanner reported an error (exit_code=3, rc=$rc) — cannot verify, aborting" ;;
        unreadable|"")
            [[ -n "$result" ]] && echo "$result"
            die "aur malware check: scanner produced no usable output (rc=$rc) — cannot verify, aborting" ;;
        *)
            echo "$result"
            die "aur malware check: unrecognised scanner exit_code '$verdict' — cannot verify, aborting" ;;
    esac
}

# ─── Maintenance: firmware updates ───────────────────────
check_firmware() {
    if ! command -v fwupdmgr &>/dev/null; then
        warn "fwupdmgr not found — install fwupd"
        return
    fi
    info "Checking firmware updates..."
    local rc=0 failed=false
    fwupdmgr refresh --force || rc=$?
    # fwupdmgr documents exit 2 as success with nothing to do.
    if (( rc != 0 && rc != 2 )); then
        failed=true
        warn "firmware metadata refresh failed (exit $rc)"
    fi
    rc=0
    fwupdmgr get-updates || rc=$?
    case "$rc" in
        0) ;;
        2) ok "no firmware updates" ;;
        *) failed=true; warn "firmware update query failed (exit $rc)" ;;
    esac
    if $failed; then
        _record "firmware" fail "firmware check incomplete"
    else
        _record "firmware" ok
    fi
}

check_pacman_db() {
    info "Checking pacman database integrity..."
    local output rc=0
    # Same set -e trap as check_aur_malware: pacman -Dk exits non-zero on the
    # broken-entry case this function exists to report.
    # No sudo: -Dk is read-only, and requiring a password made a failed prompt
    # look identical to a corrupt database.
    output=$(pacman -Dk 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        _record "pacman-database" fail "pacman -Dk exited $rc"
        warn "pacman database integrity check failed (exit $rc): $output"
        warn "Inspect the reported dependencies and package entries before attempting a repair"
    else
        _record "pacman-database" ok
        ok "pacman database: clean"
    fi
}

# Known-malicious AUR accounts from the aur-malware-check campaigns
# (aur_check itself never reads accounts.json).
_bad_aur_accounts() {
    local f
    for f in "$HOME/.local/share/aur-malware-check"/data/campaigns/*/accounts.json; do
        [[ -f "$f" ]] || continue
        jq -r '.accounts // {} | keys[]' "$f" 2>/dev/null || true
    done | sort -u
}

# AUR state of installed foreign packages: maintainer changes since the last
# build, known-malicious maintainers, packages gone from the AUR, orphans and
# out-of-date flags (the last two are info only, not warnings).
check_aur_health() {
    local foreign aur accounts p m o
    foreign=$(pacman -Qmq 2>/dev/null || true)
    [[ -n "$foreign" ]] || return 0
    info "Checking AUR package health (maintainers, removals)..."
    # shellcheck disable=SC2086  # one package per word
    aur=$(_aur_info $foreign)
    if [[ -z "$aur" ]]; then warn "AUR health: no answer from the AUR (offline?) — skipped"; return 0; fi
    accounts=$(_bad_aur_accounts)
    local gone=() orphan=() ood=() n=0
    while IFS=$'\t' read -r p m o; do
        [[ -n "$p" ]] || continue
        if [[ "$p" == - ]]; then gone+=("$m"); continue; fi
        [[ "$m" != None ]] || orphan+=("$p")
        [[ "$o" == No* ]] || ood+=("$p")
        if [[ -n "$accounts" && "$m" != None ]] && grep -qixF -- "$m" <<< "$accounts"; then
            warn "AUR: $p is maintained by known-malicious account '$m' — treat as compromised, remove and investigate"; n=$((n + 1))
        fi
    done <<< "$aur"
    while IFS=$'\t' read -r p o m; do
        [[ -n "$p" ]] || continue
        warn "AUR: $p changed maintainer since it was built ($o -> $m) — review the AUR page and diff before upgrading"; n=$((n + 1))
    done < <(_aur_maint_changes "$aur")
    if (( ${#gone[@]} )); then
        warn "AUR: installed but no longer on the AUR (deleted or renamed — investigate): ${gone[*]}"; n=$((n + 1))
    fi
    (( ${#orphan[@]} == 0 )) || echo "    orphaned on the AUR: ${orphan[*]}"
    (( ${#ood[@]} == 0 )) || echo "    flagged out-of-date on the AUR: ${ood[*]}"
    (( n )) || ok "AUR health: no maintainer changes, bad accounts or removed packages"
}

# File contents of every package vs. its sha256 in MTREE (backup/config files
# excluded). Takes minutes, so at most every 60 days; needs root to read all
# files, so a run without a terminal or sudo ticket waits for the next one.
check_package_files() {
    command -v paccheck &>/dev/null || return 0
    _needs_run paccheck $((60 * 86400)) || return 0
    if [[ ! -t 0 ]] && ! sudo -n true 2>/dev/null; then
        info "package file check due — needs sudo, runs in the next terminal audit"
        return 0
    fi
    local out="$STAMP_DIR/paccheck.txt" n
    mkdir -p "$STAMP_DIR"
    info "Verifying package files against their sha256 sums (a few minutes, every 60 days)..."
    # shellcheck disable=SC2024  # the report belongs to the user, not root
    sudo paccheck --sha256sum --quiet > "$out" 2>&1 || true
    n=$(grep -c . "$out" || true)
    if (( n )); then
        warn "package files: $n changed or unreadable — see $out (reinstall: sudo pacman -S <pkg>)"
    else
        ok "package files match their sha256 sums"
    fi
    _mark_done paccheck
}

# Microsoft's 2011 Secure Boot CAs expired in 2026 (KEK + UEFI CA in June,
# Windows PCA in October). Shims and option ROMs signed only with the 2023
# CAs fail to boot until the firmware db/KEK carry them. linux-surface
# machines boot with Secure Boot on; report only.
check_secureboot_certs() {
    _has_feature linux-surface || return 0
    command -v mokutil &>/dev/null || return 0
    mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled' || return 0
    local kek db need=()
    kek=$(mokutil --kek 2>/dev/null || true)
    db=$(mokutil --db 2>/dev/null || true)
    if [[ -z "$kek$db" ]]; then warn "Secure Boot: could not read KEK/db"; return 0; fi
    grep -qF 'Microsoft Corporation KEK CA 2023' <<< "$kek" || need+=("KEK CA 2023")
    grep -qF 'Microsoft UEFI CA 2023' <<< "$db" || need+=("UEFI CA 2023")
    grep -qF 'Windows UEFI CA 2023' <<< "$db" || need+=("Windows UEFI CA 2023")
    if (( ${#need[@]} )); then
        warn "Secure Boot: firmware lacks the 2023 Microsoft certificates (${need[*]}); the 2011 ones expired in 2026 — apply UEFI updates (fwupdmgr, or Windows Update / Surface firmware)"
    else
        ok "Secure Boot: 2023 Microsoft certificates present"
    fi
}

# CPU vulnerabilities the running kernel reports as unmitigated.
_CPU_VULN_DIR=/sys/devices/system/cpu/vulnerabilities
check_cpu_vulns() {
    local f s bad=()
    for f in "$_CPU_VULN_DIR"/*; do
        [[ -r "$f" ]] || continue
        s=$(< "$f")
        [[ "$s" != Vulnerable* ]] || bad+=("${f##*/}: $s")
    done
    if (( ${#bad[@]} )); then
        local b
        for b in "${bad[@]}"; do warn "CPU vulnerable — $b (update microcode/kernel/firmware)"; done
    else
        ok "CPU vulnerabilities: none unmitigated"
    fi
}

# ─── Warnings recap ──────────────────────────────────────
print_recap() {
    if [[ ${#_RESULT_NAMES[@]} -gt 0 ]]; then
        _banner "$CYN" "Results"
        local i mark col
        for i in "${!_RESULT_NAMES[@]}"; do
            case "${_RESULT_STATES[$i]}" in
                ok)   mark="✓"; col="$GRN" ;;
                fail) mark="✗"; col="$RED" ;;
                *)    mark="–"; col="$YEL" ;;
            esac
            printf '%b  %s %-28s%b%s\n' "$col" "$mark" "${_RESULT_NAMES[$i]}" "$NC" \
                "${_RESULT_NOTES[$i]:+  (${_RESULT_NOTES[$i]})}"
        done
    fi

    if [[ ${#WARNINGS[@]} -eq 0 ]]; then
        echo ""; ok "no warnings"
    else
        _banner "$YEL" "⚠  Warnings / Errors (${#WARNINGS[@]})"
        for w in "${WARNINGS[@]}"; do
            echo -e "${YEL}  [!] $w${NC}"
        done
        echo ""
    fi
    _offer_fixes
    # Exit status reflects whether the requested work actually succeeded, so a
    # failed run is visible to a caller/cron after recoverable failures too.
    (( _FAILED != 0 )) && _RECAP_FAILURE_REPORTED=true
    return $_FAILED
}

# ─── Phase 9: Summary ────────────────────────────────────
# ─── Phase groups ────────────────────────────────────────
phase_sources() {
    install_paru
    reset_keyrings
    setup_linux_surface_repo
    refresh_mirrors
    if command -v flatpak &>/dev/null; then
        info "Adding Flathub remote..."
        flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo \
            && ok "flathub remote ready" || warn "flathub remote-add failed"
    fi
    clone_projects
}
phase_install()  { install_all; }
phase_dotfiles() { deploy_dotfiles; dms_import; }
# Action IDs for --actions (fish completion reads this line).
MENU_ORDER=(sources install services snapper automount optimize keyboard kernels greeter keyring-pam nvidia-niri install-scripts fish dms-plugins dms-export claude caveman-code ollama vms steam-launchers app-launchers lostfiles dotfiles-export stow-symlinks dms-import audit orphan-removal rebuild python-rebuild pacnew-merge git-identity ssh-key fingerprint bitwarden yubikey-pin surface-secureboot)

# Accept stable IDs; keep legacy programmatic selection payloads compatible.
_selected_action() {
    local line
    while IFS= read -r line; do
        [[ "$line" != "$1" && "$line" != "$1 —"* ]] || return 0
    done <<< "$2"
    return 1
}

export_dotfiles() {
    if ! $INTERACTIVE; then
        _record "dotfiles-export" skip "interactive review required"
        return 0
    fi
    local branch remote merge_ref changes message
    branch=$(git -C "$DOTS_DIR" symbolic-ref --quiet --short HEAD) \
        || { _record "dotfiles-export" fail "not on a branch"; warn "Upload needs a checked-out branch"; return 0; }
    remote=$(git -C "$DOTS_DIR" config --get "branch.$branch.remote") || remote=""
    merge_ref=$(git -C "$DOTS_DIR" config --get "branch.$branch.merge") || merge_ref=""
    if [[ -z "$remote" || "$remote" == . || "$merge_ref" != refs/heads/* ]]; then
        _record "dotfiles-export" fail "no remote upstream configured"
        warn "Configure a remote upstream for $branch before uploading"
        return 0
    fi
    changes=$(git -C "$DOTS_DIR" status --porcelain) \
        || { _record "dotfiles-export" fail "cannot read repository status"; return 0; }
    info "Upload destination: $remote/${merge_ref#refs/heads/} (local branch: $branch)"
    _backup_dotset head export
    if [[ -n "$changes" ]]; then
        printf '%s\n' "$changes"
        if ! _confirm "Stage ALL non-ignored changes in the dots repository for review? [y/N]"; then
            _record "dotfiles-export" skip "staging declined"
            return 0
        fi
        git -C "$DOTS_DIR" add -A \
            || { _record "dotfiles-export" fail "staging failed"; return 0; }
        git -C "$DOTS_DIR" --no-pager diff --cached --stat
        git -C "$DOTS_DIR" --no-pager diff --cached --no-ext-diff --no-textconv
        echo "Existing local commits will also be pushed. Cancelled reviews leave files staged."
        if ! read -rp "Commit message (empty cancels): " message || [[ -z "${message//[[:space:]]/}" ]]; then
            _record "dotfiles-export" skip "review cancelled; changes remain staged"
            return 0
        fi
        if ! _confirm "Commit the staged changes and push to $remote/${merge_ref#refs/heads/}? [y/N]"; then
            _record "dotfiles-export" skip "upload declined; changes remain staged"
            return 0
        fi
        git -C "$DOTS_DIR" commit -m "$message" \
            || { _record "dotfiles-export" fail "commit failed; nothing pushed"; return 0; }
    else
        info "No file changes; upload any existing local commits"
        git -C "$DOTS_DIR" --no-pager log -5 --oneline
        if ! _confirm "Push $branch to $remote/${merge_ref#refs/heads/}? [y/N]"; then
            _record "dotfiles-export" skip "push declined"
            return 0
        fi
    fi
    if git -C "$DOTS_DIR" push "$remote" "HEAD:$merge_ref"; then
        _record "dotfiles-export" ok
        ok "uploaded: $remote/${merge_ref#refs/heads/}"
    else
        _record "dotfiles-export" fail "push failed; local commits preserved"
        warn "Push failed; local commits are preserved. Resolve the remote error and retry."
    fi
    return 0
}

# Run one selected action and record it; one-time ones get stamped at the end.
# Unexpected failures still abort through errexit. Handled failures and
# warnings must not stamp an incomplete one-time task as done.
_act() {
    local id="$1" start=${#_RESULT_STATES[@]} warnings=${#WARNINGS[@]} i state=ok
    shift
    "$@"
    for (( i=start; i<${#_RESULT_STATES[@]}; i++ )); do
        case "${_RESULT_STATES[$i]}" in
            fail) state=fail; break ;;
            skip) state=skip ;;
        esac
    done
    if [[ "$state" == ok ]] && (( ${#WARNINGS[@]} > warnings )); then
        state=skip
    fi
    _record "action:$id" "$state"
}

phase_configure() {
    local _selected

    # Interactive runs always populate CONFIGURE_ITEMS in bootstrap() (or skip
    # this phase outright), so the only other case is --yes.
    if $CONFIGURE_PROMPTED; then
        _selected="$CONFIGURE_ITEMS"
    else
        run_install_scripts
        setup_fish
        return
    fi

    _sel() { _selected_action "$1" "$_selected"; }

    _sel "dms-export"      && _act dms-export dms_export
    # Save/export first, then deploy links and copy DMS overrides,
    # before services: it enables user units that are stow links.
    # The old import alias remains accepted in programmatic payloads.
    _sel "dotfiles-export" && _act dotfiles-export export_dotfiles
    _sel "stow-symlinks"   && _act stow-symlinks deploy_dotfiles
    if _sel "dotfiles-import" || _sel "dms-import"; then
        dms_import
    fi

    _sel "services"        && _act services enable_services
    _sel "snapper"         && _act snapper setup_snapper
    _sel "automount"       && _act automount automount_disks
    _sel "optimize"        && _act optimize optimize_system
    _sel "keyboard"        && _act keyboard setup_keyboard
    _sel "kernels"         && _act kernels manage_kernels
    _sel "greeter"         && _act greeter setup_greeter
    _sel "keyring-pam"     && _act keyring-pam setup_keyring_pam
    _sel "nvidia-niri"     && _act nvidia-niri setup_nvidia_niri
    _sel "install-scripts" && _act install-scripts run_install_scripts
    _sel "fish"            && _act fish setup_fish
    _sel "dms-plugins"     && _act dms-plugins install_dms_plugins
    _sel "claude"          && _act claude setup_claude
    _sel "caveman-code"    && _act caveman-code setup_caveman_code
    _sel "ollama"          && _act ollama setup_ollama
    _sel "vms"             && _act vms setup_vms
    _sel "git-identity"    && _act git-identity setup_git_identity
    _sel "ssh-key"         && _act ssh-key setup_ssh_key
    _sel "fingerprint"     && _act fingerprint setup_fingerprint
    _sel "bitwarden"       && _act bitwarden setup_bitwarden
    _sel "yubikey-pin"     && _act yubikey-pin setup_yubikey_pin
    _sel "surface-secureboot" && _act surface-secureboot setup_surface_secureboot
    # Audit-dependent actions are resolved in bootstrap() from the AUDIT_ACTIONS
    # table (which also enables the audit phase); nothing to set here.
    _sel "steam-launchers" && _act steam-launchers setup_steam_launchers
    _sel "app-launchers"   && _act app-launchers check_app_launchers
    _sel "lostfiles"       && _act lostfiles report_unowned_files

    return 0
}
phase_update()   { system_update; flatpak_update; clean_caches; }
# One list for the audit phase and --check, so they can't drift. Each check
# only reports unless its AUDIT_ACTIONS flag was set (orphans, rebuilds, pacnew).
AUDIT_CHECKS=(check_held_updates check_foreign_orphans check_unused_apps check_rebuilds
              check_python_rebuilds check_pacnew check_modified_configs check_dms_owner check_surface_kernel
              check_logins check_firmware check_aur_malware check_aur_health check_pacman_db
              check_secureboot_certs check_cpu_vulns check_package_files)
_run_audit_checks() { local c; for c in "${AUDIT_CHECKS[@]}"; do "$c"; done; }
# The audit phase also removes unused flatpak runtimes; --check stays report-only.
# sysup --status shows this (the weekly timer runs --check too).
_save_last_check() {
    local i f="$STAMP_DIR/last-check.tsv"
    mkdir -p "$STAMP_DIR"
    {
        for i in "${!_RESULT_NAMES[@]}"; do printf '%s\t%s\n' "${_RESULT_NAMES[$i]}" "${_RESULT_STATES[$i]}"; done
        printf '@warnings\t%s\n' "${#WARNINGS[@]}"
    } > "$f.tmp" && mv "$f.tmp" "$f"
}
phase_audit()    { check_flatpak_orphans; _run_audit_checks; return 0; }

# ─── Main ────────────────────────────────────────────────
bootstrap() {
    if $INTERACTIVE; then
        SKIP_PHASES=""
        local _selected
        detect_machine
        [[ -n "${SYSUP_ACTIONS:-}" ]] || die "no actions given: sysup --actions A,B (IDs: ${MENU_ORDER[*]})"
        local _id
        _selected=""
        for _id in ${SYSUP_ACTIONS//,/ }; do
            [[ " ${MENU_ORDER[*]} " == *" $_id "* ]] || die "unknown action: $_id"
            _selected+="$_id"$'\n'
        done
        _ensure_dots_repo

        local _phase_keys=(sources install dotfiles audit)
        for _p in "${_phase_keys[@]}"; do
            _selected_action "$_p" "$_selected" || SKIP_PHASES+="$_p "
        done

        CONFIGURE_ITEMS=$(echo "$_selected" | grep -vE "^(sources|install|dotfiles|audit)( —.*)?$" || true)
        if [[ -n "$CONFIGURE_ITEMS" ]]; then
            CONFIGURE_PROMPTED=true
        else
            SKIP_PHASES+="configure "
        fi

        # Enable each selected audit-dependent action from the single table at
        # the top of the file. _enable_audit_action also un-skips the audit
        # phase, so an action can no longer be selected into a phase that never
        # runs — which is what made `rebuild` a silent no-op.
        local _act
        for _act in "${!AUDIT_ACTIONS[@]}"; do
            _selected_action "$_act" "${CONFIGURE_ITEMS:-}" && _enable_audit_action "$_act"
        done
    else
        detect_machine
        _ensure_dots_repo
    fi
    # Gate package mutations, including rebuilds and the optional kernel action.
    # A dotfiles-only run still needs no network. The post-audit scan is too late
    # to guard rebuilds because they execute before it.
    if { ! _skipped install || ! _skipped sources; } \
        || { ! _skipped "audit" && { $AUDIT_REBUILD || $AUDIT_PYTHON_REBUILD || $AUDIT_ORPHAN_REMOVAL; }; } \
        || { ! _skipped "configure" && _selected_action kernels "$CONFIGURE_ITEMS"; }; then
        _check_packages_against_malware
        # phase_install runs paru -Syuu, which rebuilds installed AUR packages
        # from upstream PKGBUILDs — the exact vector the scan exists to catch.
        # The list gate only covers packages we are about to request, so scan
        # what is already installed too, before the mutation rather than in the
        # audit phase afterwards. Same gate update() already applies to --update.
        # Definitions were just refreshed, so this reuses them without re-pulling.
        check_aur_malware
    fi
    info "phases active: $({ for _p in sources install dotfiles configure audit; do _skipped "$_p" || printf '%s ' "$_p"; done; })"
    _run_phase "sources"   phase_sources
    _run_phase "install"   phase_install
    _run_phase "dotfiles"  phase_dotfiles
    _run_phase "configure" phase_configure
    _run_phase "audit"     phase_audit
    local _rc=0
    print_recap || _rc=$?
    _stamp_once
    return $_rc
}

# Record one-time actions that finished ok (sysup --status shows the dates).
# sysup.py ignores IDs that are not one-time actions.
_stamp_once() {
    local i ids=()
    for i in "${!_RESULT_NAMES[@]}"; do
        [[ "${_RESULT_NAMES[i]}" == action:* && "${_RESULT_STATES[i]}" == ok ]] \
            && ids+=("${_RESULT_NAMES[i]#action:}")
    done
    (( ${#ids[@]} )) || return 0
    _py once-done "${ids[@]}" || warn "could not record one-time actions in the config"
}

# --pkg WHERE NAME...: put packages in a list. Flatpak when the name is an
# installed flatpak app or looks like an app ID (two dots), else pacman/AUR.
_pkg_cmd() {
    local where="${1:-}" n src rc=0
    case "$where" in
        shared|profile|local|remove|ignore) shift ;;
        *) die "--pkg needs a target: shared profile local remove ignore" ;;
    esac
    (( $# )) || die "--pkg $where needs package names"
    if [[ "$where" == profile ]]; then
        _ensure_plan
        [[ -n "$MACHINE" ]] || die "no profile chosen — run: sysup --profile NAME"
    fi
    for n in "$@"; do
        src=paru
        if [[ "$n" == *.*.* ]] || { command -v flatpak &>/dev/null && flatpak info -- "$n" &>/dev/null; }; then
            src=flatpak
        fi
        if _py add "$where" "$src" "$n" "${MACHINE:-}"; then ok "$n ($src) → $where"; else rc=1; fi
    done
    case "$where" in
        shared)  info "now commit packages.toml" ;;
        profile) info "now commit profiles/$MACHINE.toml" ;;
    esac
    return $rc
}

update() {
    _banner "$BLU" "sysup — update" box
    echo ""

    detect_machine
    # --update runs paru -Syuu, which rebuilds AUR packages from upstream
    # PKGBUILDs. Gate it the same way bootstrap does, before anything is pulled.
    check_aur_malware
    system_update
    check_held_updates
    flatpak_update
    update_ollama
    update_projects
    update_claude_plugins
    check_flatpak_orphans
    clean_caches
    print_recap
}

check() {
    _banner "$BLU" "sysup — check" box
    echo ""

    _run_audit_checks
    _save_last_check
    print_recap
}

# Set "key" "value" inside the block at slash path (e.g. Registry/HKCU/Software/Valve/Steam)
# of a text VDF; replaces the line or appends it before the block's closing brace.
_vdf_set() {
    local file=$1 path=$2 key=$3 val=$4 tmp
    tmp=$(mktemp "$file.XXXX") || return 1
    awk -v want="$path" -v key="$key" -v val="$val" '
        function cur(  i, p) { p = ""; for (i = 1; i <= d; i++) p = p (i > 1 ? "/" : "") s[i]; return p }
        /^\t*"[^"]*"$/ { n = $0; gsub(/^\t*"|"$/, "", n); print; next }
        /^\t*\{$/ { s[++d] = n; done = 0; print; next }
        /^\t*\}$/ {
            if (cur() == want && !set) { printf "%s\"%s\"\t\t\"%s\"\n", substr($0, 1, length($0) - 1) "\t", key, val; set = 1 }
            d--; print; next
        }
        cur() == want && index($0, "\"" key "\"\t") == d + 1 {
            printf "%s\"%s\"\t\t\"%s\"\n", substr($0, 1, d), key, val; set = 1; next
        }
        { print }
        END { exit !set }' "$file" >"$tmp" && mv "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

# Big Picture off: no Big Picture at launch (StartupMode 7 = desktop UI), Guide button
# doesn't open it. Steam rewrites these files on exit, so only edit while it is stopped.
_steam_no_bigpicture() {
    local reg="$HOME/.steam/registry.vdf" f
    [[ -f "$reg" ]] || return 0
    if pgrep -x steam >/dev/null; then
        info "Steam running — Big Picture settings not checked (quit Steam and rerun)"
        return 0
    fi
    _vdf_set "$reg" Registry/HKCU/Software/Valve/Steam StartupMode 7 \
        || { warn "steam: could not set StartupMode in $reg"; return 0; }
    for f in "$HOME"/.local/share/Steam/userdata/*/config/localconfig.vdf; do
        [[ -f "$f" ]] || continue
        _vdf_set "$f" UserLocalConfigStore Controller_CheckGuideButton 0 \
            || warn "steam: could not set Controller_CheckGuideButton in $f"
    done
    ok "Steam: Big Picture off at launch and on Guide button"
}

setup_steam_launchers() {
    _steam_no_bigpicture
    local steam_root="$HOME/.local/share/Steam"
    local apps_dir="$HOME/.local/share/applications"
    local vdf="$steam_root/steamapps/libraryfolders.vdf"
    local -a library_paths=()
    local count=0 skipped=0

    [[ -f "$vdf" ]] || { warn "Steam library not found — is Steam installed?"; return; }

    info "Scanning Steam libraries..."

    # Parse library paths from libraryfolders.vdf
    while IFS= read -r line; do
        if [[ "$line" =~ \"path\"[[:space:]]+\"([^\"]+)\" ]]; then
            library_paths+=("${BASH_REMATCH[1]}/steamapps")
        fi
    done < "$vdf"

    # Also include the default steamapps dir
    library_paths+=("$steam_root/steamapps")

    # Deduplicate
    declare -A _seen_paths
    local -a _unique_paths=()
    for _p in "${library_paths[@]}"; do
        [[ -d "$_p" && -z "${_seen_paths[$_p]:-}" ]] || continue
        _seen_paths[$_p]=1
        _unique_paths+=("$_p")
    done
    library_paths=("${_unique_paths[@]}")

    mkdir -p "$apps_dir"

    for lib in "${library_paths[@]}"; do
        for acf in "$lib"/appmanifest_*.acf; do
            [[ -f "$acf" ]] || continue

            local appid name
            appid=$(grep -m1 '"appid"' "$acf" | grep -oP '(?<="appid"\s{1,8}")[^"]+' || true)
            name=$(grep -m1 '"name"' "$acf" | grep -oP '(?<="name"\s{1,8}")[^"]+' || true)

            [[ -z "$appid" || -z "$name" ]] && continue

            # Skip Proton, redistributables, Steam Linux Runtime, and tools
            if echo "$name" | grep -qiE '(^Proton |^Steam Linux Runtime|Steamworks Common Redistributables|^Steam ?VR|^Pressure Vessel)'; then
                (( skipped++ )) || true
                continue
            fi

            local desktop="$apps_dir/steam_app_${appid}.desktop"
            local icon_entry="steam_icon_${appid}"

            cat > "$desktop" <<EOF
[Desktop Entry]
Name=$name
Exec=steam -applaunch $appid
Icon=$icon_entry
Terminal=false
Type=Application
Categories=Game;
EOF
            (( count++ )) || true
        done
    done

    # Remove launchers for games no longer installed (appmanifest gone)
    local removed=0
    for desktop in "$apps_dir"/steam_app_*.desktop; do
        [[ -f "$desktop" ]] || continue
        local id="${desktop##*/steam_app_}"
        id="${id%.desktop}"
        local found=false
        for lib in "${library_paths[@]}"; do
            [[ -f "$lib/appmanifest_${id}.acf" ]] && { found=true; break; }
        done
        $found || { rm -f "$desktop"; (( removed++ )) || true; }
    done

    ok "created: $count Steam game launchers ($skipped tools/runtimes skipped, $removed stale removed)"
}

# ─── Maintenance: non-Steam app launcher hygiene ─────────
# Extracts the executable token from a .desktop Exec= line (handles a
# quoted path, ignores trailing %f/%U field codes and arguments).
_desktop_exec_bin() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    if [[ "$s" == \"* ]]; then
        s="${s#\"}"
        printf '%s' "${s%%\"*}"
    else
        printf '%s' "${s%% *}"
    fi
}

check_app_launchers() {
    local apps_dir="$HOME/.local/share/applications"
    local f base exec_line bin removed=0

    for f in "$apps_dir"/*.desktop; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        [[ "$base" == steam_app_* ]] && continue

        # grep exits 1 when a .desktop carries no Exec= (Hidden=true override
        # stubs, and .directory-style entries). With set -euo pipefail that
        # killed the whole run mid-loop before the -z check below could skip
        # the file. Keep such entries — absence of Exec is not staleness.
        exec_line=$(grep -m1 '^Exec=' "$f" | cut -d= -f2-) || exec_line=""
        [[ -z "$exec_line" ]] && continue

        bin=$(_desktop_exec_bin "$exec_line")
        [[ "$bin" == steam* ]] && continue

        if [[ "$bin" == /* ]]; then
            [[ -e "$bin" ]] && continue
        else
            command -v "$bin" &>/dev/null && continue
        fi

        rm -f "$f"
        (( removed++ )) || true
    done
    ok "removed: $removed stale (non-Steam) app launcher(s)"

    local missing=0
    for f in /usr/share/applications/*.desktop; do
        [[ -f "$f" ]] || continue
        [[ -e "$apps_dir/$(basename "$f")" ]] || (( missing++ )) || true
    done
    ok "$missing installed app(s) not mirrored in ~/.local/share/applications (already visible via /usr/share/applications, informational only)"
}

# Profile, features, one-time actions, last check, dotset backups.
_status() {
    local backups
    _py status || return $?
    backups=$(git -C "$DOTS_DIR" for-each-ref 'refs/tags/backup/' \
        --format='  %(refname:short)  %(creatordate:short)  %(subject)' 2>/dev/null) || backups=""
    printf '\ndotset backups (sysup --restore 1|2):\n%s\n' "${backups:-  none yet}"
}

# Bare sysup in a terminal: a menu loop. Each choice runs as a child sysup
# (same lock, recap and self-update as the command line), then the menu comes
# back. Esc quits on the main screen and goes back on the others.
_menu() {
    local self="${BASH_SOURCE[0]}" mode ids opts=()
    while :; do
        mode=$(printf '%s\t%s\n' \
                update  "Update packages + clean caches" \
                first   "First run: new-machine setup" \
                check   "Audit, report only" \
                actions "Choose actions…" \
                options "Options… [${opts[*]:-none}]" \
                status  "Profile, one-time actions, last check" \
                quit    "Quit" \
            | fzf --delimiter='\t' --with-nth=2 --height=~12 --reverse --no-multi \
                  --prompt='sysup> ' --header='Enter: choose   Esc: quit') || return 0
        case "${mode%%$'\t'*}" in
            # A run ends the menu: return its exit status.
            first)   ids=$(_first_run_ids) || continue; _menu_run "$self" --actions "$ids" "${opts[@]}" || return; return 0 ;;
            update)  _menu_run "$self" --update "${opts[@]}" || return; return 0 ;;
            check)   _menu_run "$self" --check "${opts[@]}" || return; return 0 ;;
            actions) ids=$(_menu_actions) || continue; _menu_run "$self" --actions "$ids" "${opts[@]}" || return; return 0 ;;
            options) _menu_options opts ;;
            status)  _status; _menu_pause ;;
            *)       return 0 ;;
        esac
    done
}

# New-machine set: packages, links, services, plus every one-time action never run.
_first_run_ids() {
    local rows
    rows=$(_py menu "${MENU_ORDER[@]}") || return 1
    awk -F'\t' 'BEGIN { printf "sources,install,stow-symlinks,dms-import,services" }
        $4 == "never run" && $1 != "services" { printf ",%s", $1 } END { print "" }' <<< "$rows"
}

# Action picker. Prints the marked IDs comma-separated; fails on Esc or no marks.
_menu_actions() {
    local rows sel ids
    rows=$(_py menu "${MENU_ORDER[@]}") || return 1
    # Rows arrive grouped; a header row (empty ID) opens each group and a
    # RUN row comes first. Enter marks; Enter on RUN (or Ctrl-R) runs the marks.
    # Display column: label + one-time state; field 3 = description.
    sel=$(awk -F'\t' 'NR == 1 { printf "RUN\t▶ Run marked actions\t\n" }
            $2 != g { g = $2; printf "\t── %s ──\t\n", g }
            { printf "%s\t   %-38s %s\t%s\n", $1, $3, $4, $5 }' <<< "$rows" \
        | fzf --multi --delimiter='\t' --with-nth=2 --height=80% --reverse \
              --prompt='actions> ' --header='Enter/Tab: mark   ▶ Run or Ctrl-R: run marked   Esc: back' \
              --bind="enter:transform:[ {1} = RUN ] && echo accept || { [ -n {1} ] && echo toggle+down || echo down; }" \
              --bind='ctrl-r:accept' \
              --preview="[ -n {3} ] && printf '%s\n\nsysup --actions %s\n' {3} {1}" --preview-window=down,4,wrap) \
        || return 1
    ids=$(awk -F'\t' '$1 != "" && $1 != "RUN" { print $1 }' <<< "$sel")
    [[ -n "$ids" ]] || return 1
    printf '%s\n' "${ids//$'\n'/,}"
}

# Modifier toggles, kept in the caller's array (name in $1) until the menu quits.
_menu_options() {
    local -n _o=$1
    local pick flag x o keep
    while :; do
        pick=$(for flag in --adopt --clean; do
                x=" "; [[ " ${_o[*]} " == *" $flag "* ]] && x=x
                case "$flag" in
                    --adopt)   printf '%s\t[%s] %s\n' "$flag" "$x" "adopt: stow takes over conflicting live files (backed up first)" ;;
                    *)         printf '%s\t[%s] %s\n' "$flag" "$x" "clean: also wipe ~/.cache/paru and ~/.cache/yay" ;;
                esac
            done | fzf --delimiter='\t' --with-nth=2 --height=~6 --reverse --no-multi \
                       --prompt='options> ' --header='Enter: toggle   Esc: back') || return 0
        flag=${pick%%$'\t'*}
        if [[ " ${_o[*]} " == *" $flag "* ]]; then
            keep=(); for o in "${_o[@]}"; do [[ "$o" == "$flag" ]] || keep+=("$o"); done
            _o=("${keep[@]}")
        else
            _o+=("$flag")
        fi
    done
}

_menu_run() {
    local rc=0
    echo; info "sysup ${*:2}"
    bash "$@" || rc=$?
    (( rc == 0 )) && ok "done" || echo -e "${YEL}[!] sysup exited with status $rc${NC}"
    return "$rc"
}

_menu_pause() { read -rsn1 -p $'\nPress any key to return to the menu ' _ < /dev/tty || true; echo; }

usage() {
    echo "Usage: sysup [OPTION]"
    echo ""
    echo "  (no args)           Menu (in a terminal, needs fzf); this help otherwise"
    echo "  --yes, -y           Full bootstrap, non-interactive"
    echo "  --actions A,B,...   Run exactly these action IDs (list below)"
    echo "  --update, -u        Update packages + clean caches"
    echo "  --check, -c         Audit: orphans, rebuilds, pacnew, firmware"
    echo ""
    echo "Configuration (edit config files only, run nothing):"
    echo "  --profile NAME [--dotset SET]  This machine's profile (profiles/NAME.toml) and dotfile set"
    echo "  --pkg WHERE NAME...  Put packages in a list. WHERE: shared (packages.toml),"
    echo "                      profile (profiles/<this>.toml), local (this machine only),"
    echo "                      remove (demote on this machine), ignore (stop reporting)"
    echo "  --status            Profile, features, one-time actions with dates, last check"
    echo "  --skip-once ID      Mark a one-time action as skipped"
    echo "  --restore 1|2       Restore the dotfile set from backup 1 (newest) or 2."
    echo "                      Backups (local git tags backup/<set>/1|2) are taken"
    echo "                      before deploy, dms-import and git export."
    echo "  --help, -h          Show this message"
    echo ""
    echo "Modifiers (combine with the actions above):"
    echo "  --adopt             Let stow ADOPT conflicting files into the repo."
    echo "                      Off by default: adoption overwrites the tracked"
    echo "                      copy with whatever is live. Conflicting files are"
    echo "                      copied to \$STAMP_DIR/adopt-backup-<ts>/ first."
    echo "  --clean             Also delete ~/.cache/paru and ~/.cache/yay during"
    echo "                      cleanup. Default keeps AUR clones of installed"
    echo "                      packages (reused by paru and the AUR review) and"
    echo "                      removes only those of uninstalled packages."
    echo ""
    echo "Environment:"
    echo "  SKIP_PHASES=\"...\"   Space-separated phases to skip. Valid names:"
    echo "                      sources install dotfiles configure audit"
    echo "                      (anything else is silently ignored)"
    echo ""
    echo "Action IDs (--actions):"
    echo "  ${MENU_ORDER[*]}"
    echo ""
    echo "Only one sysup may run at a time (flock on $LOCK_FILE)."
    echo "Exit status is nonzero if any requested action failed."
}

# Sourcing the script (for tests) must not run anything. Guard main execution so
# functions can be exercised in isolation without startup side effects.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    return 0 2>/dev/null || true
fi

_ARGS="$*"
ACTION=""
_ORIG_ARGS=("$@")
# Config commands: no lock, no log, no plan run; they only edit config files.
case "${1:-}" in
    --profile|--pkg|--status|--skip-once)
        (( EUID != 0 )) || die "run sysup as your user, not root"
        _cmd=$1; shift
        case "$_cmd" in
            --profile)
                [[ $# -ge 1 && "$1" != -* ]] || die "--profile needs a profile name (see profiles/)"
                _prof=$1; shift; _set=""
                if [[ "${1:-}" == --dotset ]]; then
                    [[ $# -ge 2 ]] || die "--dotset needs a set name (or none)"
                    _set=$2; shift 2
                fi
                (( $# == 0 )) || die "unexpected arguments: $*"
                _py choose "$_prof" ${_set:+"$_set"}; exit $? ;;
            --pkg)       _pkg_cmd "$@"; exit $? ;;
            --status)
                (( $# == 0 )) || die "--status takes no arguments"
                _status; exit $? ;;
            --skip-once) (( $# == 1 )) || die "--skip-once needs one action ID"; _py once-skip "$1"; exit $? ;;
        esac ;;
esac
# Modifiers are order-independent and may be combined with any action; the
# action itself is whatever non-modifier argument appears.
while [[ $# -gt 0 ]]; do
    case "$1" in
        --adopt)            STOW_ADOPT=true ;;
        --clean)            CLEAN=true ;;
        --help|-h)          ACTION=help ;;
        --restore)
            [[ -n "$ACTION" ]] && die "More than one action given ($ACTION, $1). Use --help."
            [[ "${2:-}" == 1 || "${2:-}" == 2 ]] || die "--restore needs 1 (newest) or 2"
            RESTORE_N=$2; shift; ACTION=--restore ;;
        --actions=*|--actions)
            [[ -n "$ACTION" ]] && die "More than one action given ($ACTION, $1). Use --help."
            if [[ "$1" == --actions ]]; then
                [[ $# -ge 2 && -n "$2" ]] || die "--actions needs a comma-separated list of action IDs"
                SYSUP_ACTIONS="$2"; shift
            else
                SYSUP_ACTIONS="${1#--actions=}"
                [[ -n "$SYSUP_ACTIONS" ]] || die "--actions needs a comma-separated list of action IDs"
            fi
            ACTION=--actions ;;
        "")                 ;;
        -*|*)
            [[ -n "$ACTION" ]] && die "More than one action given ($ACTION, $1). Use --help."
            ACTION="$1" ;;
    esac
    shift
done

# --help is read-only: no lock, no log rotation, no stamps.
if [[ "$ACTION" == help ]]; then usage; exit 0; fi
# Bare sysup: menu in a terminal, help otherwise (timer, pipes, scripts).
if [[ -z "$ACTION" ]]; then
    if [[ -t 0 && -t 1 ]] && command -v fzf &>/dev/null; then
        (( EUID != 0 )) || die "run sysup as your user, not root — it calls sudo itself"
        _menu || exit; exit 0
    else
        [[ -t 0 && -t 1 ]] && warn "fzf is not installed; showing help instead of the menu"
        usage; exit 0
    fi
fi
case "$ACTION" in
    ""|--actions|--yes|-y|--update|-u|--check|-c|--restore) ;;
    *) die "Unknown option: $ACTION. Use --help." ;;
esac
# Root would write stamps, logs and links into /root; sudo is called per command.
(( EUID != 0 )) || die "run sysup as your user, not root — it calls sudo itself"
_check_repo_current "${_ORIG_ARGS[@]}"
_ensure_plan

case "$ACTION" in
    --actions)           _init_runtime; INTERACTIVE=true;  bootstrap ;;
    --yes|-y)            _init_runtime; INTERACTIVE=false; bootstrap ;;
    --update|-u)         _init_runtime; update ;;
    --check|-c)          _init_runtime; check ;;
    --restore)           _init_runtime; restore_dotset "$RESTORE_N"; print_recap ;;
    *)                   die "Unknown option: $ACTION. Use --help." ;;
esac
