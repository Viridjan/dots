#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────
# vjupdate — bootstrap + maintenance for CachyOS
# Supports: desktop (tower) and surface (Surface Pro 9)
#
# Usage:
#   vjupdate            # full bootstrap
#   vjupdate --update   # system update + maintenance
#   vjupdate --help
# ─────────────────────────────────────────────────────────
set -euo pipefail

RED='\033[0;31m'; YEL='\033[0;33m'; GRN='\033[0;32m'; BLU='\033[0;34m'; NC='\033[0m'
info()  { echo -e "${BLU}==> $*${NC}"; }
ok()    { echo -e "${GRN} ✓  $*${NC}"; }
warn()  { echo -e "${YEL}[!] $*${NC}"; }
die()   { echo -e "${RED}[✗] $*${NC}" >&2; exit 1; }

DOTS_DIR="$HOME/Projects/dots"
STAMP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dots"
INTERACTIVE=true
mkdir -p "$STAMP_DIR"

_run_phase() {
    local name="$1"; shift
    if [[ -n "${SKIP_PHASES:-}" ]] && echo " $SKIP_PHASES " | grep -qi " $name "; then
        warn "Skipped: $name"
        return
    fi
    "$@"
}

_ensure_dots_repo() {
    if [[ -d "$DOTS_DIR" ]]; then
        ok "dots repo: $DOTS_DIR"
        return
    fi
    info "dots repo not found — cloning from GitHub..."
    mkdir -p "$(dirname "$DOTS_DIR")"
    git clone https://github.com/Viridjan/dots.git "$DOTS_DIR" \
        || die "Failed to clone dots repo — check network/git access"
    ok "dots repo cloned to $DOTS_DIR"
}

# Returns 0 (run it) if stamp is absent or older than 48h, else 1 (skip).
_needs_run() {
    local stamp="$STAMP_DIR/$1"
    [[ ! -f "$stamp" ]] && return 0
    local age=$(( $(date +%s) - $(date -r "$stamp" +%s) ))
    (( age > 172800 ))
}
_mark_done() { touch "$STAMP_DIR/$1"; }

# ─── Phase 1: Machine detection ──────────────────────────
detect_machine() {
    local h; h=$(hostname)
    if [[ "$h" == *desktop* ]]; then
        MACHINE="desktop"
    elif [[ "$h" == *surface* ]]; then
        MACHINE="surface"
    else
        warn "Hostname '$h' contains neither 'desktop' nor 'surface'."
        echo "Set hostname first:  sudo hostnamectl set-hostname desktop"
        echo "                 or: sudo hostnamectl set-hostname surface"
        echo ""
        read -rp "Continue anyway with which profile? [desktop/surface/abort]: " choice
        case "$choice" in
            desktop|surface) MACHINE="$choice" ;;
            *) die "Aborted." ;;
        esac
    fi
    ok "Machine profile: $MACHINE"
}

# ─── Phase 2: Paru ───────────────────────────────────────
install_paru() {
    if command -v paru &>/dev/null; then
        ok "paru already installed"
        return
    fi
    info "Installing paru..."
    sudo pacman -S --needed base-devel git
    local tmp; tmp=$(mktemp -d)
    git clone https://aur.archlinux.org/paru.git "$tmp/paru"
    (cd "$tmp/paru" && makepkg -si --noconfirm)
    rm -rf "$tmp"
    ok "paru installed"
}

# ─── Phase 2b: Keyrings ──────────────────────────────────
reset_keyrings() {
    if ! _needs_run keyrings; then
        ok "Keyrings reset skipped (< 48h ago)"
        return
    fi
    info "Resetting pacman keyrings..."
    sudo rm -rf /etc/pacman.d/gnupg/
    sudo pacman-key --init
    sudo pacman-key --populate
    sudo pacman-key --recv-keys F3B607488DB35A47 --keyserver keyserver.ubuntu.com
    sudo pacman-key --lsign-key F3B607488DB35A47
    if [[ "${MACHINE:-}" == surface ]]; then
        curl -s https://raw.githubusercontent.com/linux-surface/linux-surface/master/pkg/keys/surface.asc \
            | sudo pacman-key --add -
        sudo pacman-key --finger 56C464BAAC421453
        sudo pacman-key --lsign-key 56C464BAAC421453
        ok "linux-surface key imported"
    fi
    _mark_done keyrings
    ok "Keyrings reset"
}

# ─── Phase 2c: linux-surface repo ───────────────────────
setup_linux_surface_repo() {
    [[ "${MACHINE:-}" != "surface" ]] && return

    if grep -q '^\[linux-surface\]' /etc/pacman.conf; then
        ok "linux-surface repo already in pacman.conf"
        return
    fi

    info "Adding linux-surface pacman repository..."
    sudo tee -a /etc/pacman.conf > /dev/null <<'EOF'

[linux-surface]
Server = https://pkg.surfacelinux.com/arch/
EOF
    sudo pacman -Sy
    ok "linux-surface repo added to pacman.conf"
}

# ─── Phase 3: Packages ───────────────────────────────────
_pkg_list() {
    grep -v '^#' "$1" | grep -v '^$'
}

_install_list() {
    local list="$1" to_install=()
    while IFS= read -r pkg; do
        if pacman -Qi "$pkg" &>/dev/null; then
            ok "up to date: $pkg"
        else
            to_install+=("$pkg")
        fi
    done < <(_pkg_list "$list")
    if [[ ${#to_install[@]} -gt 0 ]]; then
        paru -S --needed --noconfirm "${to_install[@]}"
    fi
}

refresh_mirrors() {
    if ! _needs_run mirrors; then
        ok "Mirror refresh skipped (< 48h ago)"
        return
    fi
    info "Refreshing mirrors..."
    sudo cachyos-rate-mirrors 2>/dev/null \
        || sudo rate-mirrors --save /etc/pacman.d/cachyos-mirrorlist cachyos 2>/dev/null \
        || warn "Mirror refresh failed — continuing with existing mirrors"
    sudo pacman -Syy
    _mark_done mirrors
    ok "Mirrors refreshed"
}

install_packages() {
    # Force-remove known conflicting packages before installing.
    # -Rdd skips dep checks so replacements (e.g. wine→wine-cachyos) don't block.
    if [[ -f "$DOTS_DIR/.paru-R.list" ]]; then
        info "Removing flagged packages..."
        while IFS= read -r pkg; do
            local out
            if out=$(sudo pacman -Rdd --noconfirm "$pkg" 2>&1); then
                ok "removed: $pkg"
            elif echo "$out" | grep -q "target not found"; then
                ok "not installed, skipping: $pkg"
            else
                warn "failed to remove: $pkg — $out"
            fi
        done < <(_pkg_list "$DOTS_DIR/.paru-R.list")
    fi

    info "Upgrading existing packages..."
    paru -Syuu --noconfirm || warn "Full upgrade had warnings — continuing"
    ok "System upgraded"

    _do_install() {
        info "Installing common packages..."
        _install_list "$DOTS_DIR/.paru-S-common.list" || return 1
        info "Installing $MACHINE-specific packages..."
        _install_list "$DOTS_DIR/.paru-S-${MACHINE}.list" || return 1
    }

    if ! _do_install; then
        warn "Install failed — forcing mirror refresh and retrying..."
        rm -f "$STAMP_DIR/mirrors"
        refresh_mirrors
        _do_install || die "Package install failed after mirror refresh."
    fi

    ok "Packages done"
}

# ─── Phase 4: Dotfiles ───────────────────────────────────
COMMON_STOW_PKGS=(
    alacritty
    discord
    DankMaterialShell
    fish
    gtk-3.0
    gtk-4.0
    micro
    mimeapps
    # niri excluded — handled by _stow_niri_cfg (dir must stay real for DMS)
    paru
    qt5ct
    qt6ct
    scripts
    VSCodium
)

_stow_niri_cfg() {
    # ~/.config/niri/ must stay a real directory — DMS writes dms/ inside it and
    # stow would fold the whole dir into a symlink, breaking DMS on regeneration.
    # So we skip stow for niri and create file-level symlinks directly.
    local src="$DOTS_DIR/niri/.config/niri"
    local dst="$HOME/.config/niri"
    local mach_src="$DOTS_DIR/$MACHINE/.config/niri"

    mkdir -p "$dst/cfg"

    ln -sf "$src/config.kdl" "$dst/config.kdl"

    for f in animation autostart keybinds layout misc rules; do
        [[ -f "$src/cfg/${f}.kdl" ]] && ln -sf "$src/cfg/${f}.kdl" "$dst/cfg/${f}.kdl"
    done

    for f in display input; do
        [[ -f "$mach_src/cfg/${f}.kdl" ]] && ln -sf "$mach_src/cfg/${f}.kdl" "$dst/cfg/${f}.kdl"
    done

    ok "stowed: niri (file-level symlinks)"
}

deploy_dotfiles() {
    info "Deploying dotfiles via stow..."
    cd "$DOTS_DIR"

    # -t "$HOME" is required: stow's default target is the PARENT of the stow dir,
    # which here is $HOME/Projects (DOTS_DIR=$HOME/Projects/dots), not $HOME.
    # Without it, symlinks land in ~/Projects/.config instead of ~/.config.

    # Unstow first to handle moved files between packages (e.g. display.kdl, input.kdl).
    # Only removes symlinks stow owns — real dirs/files are left untouched.
    for pkg in "${COMMON_STOW_PKGS[@]}"; do
        [[ -d "$pkg" ]] && stow -D -t "$HOME" "$pkg" 2>/dev/null || true
    done
    stow -D -t "$HOME" claude 2>/dev/null || true

    # Stow common packages with --adopt:
    # - Fresh install: target doesn't exist → stow creates directory-level symlink.
    # - Re-run / broken symlink replaced by real dir: --adopt moves the real file
    #   into the repo package dir and creates a symlink. Run git diff after to review.
    for pkg in "${COMMON_STOW_PKGS[@]}"; do
        if [[ -d "$pkg" ]]; then
            stow --adopt -t "$HOME" "$pkg"
            ok "stowed: $pkg"
        fi
    done

    # Niri (incl. machine-specific display.kdl + input.kdl from $MACHINE pkg):
    # file-level symlinks into real ~/.config/niri/ (DMS must own that dir).
    # The $MACHINE package is intentionally NOT stowed — _stow_niri_cfg owns
    # display.kdl/input.kdl. Stowing it too caused "not owned by stow" conflicts.
    _stow_niri_cfg

    # Claude Code config
    stow --adopt --restow -t "$HOME" claude
    ok "stowed: claude"

    # bkg (wallpapers) if it exists
    [[ -d bkg ]] && stow --adopt -t "$HOME" bkg && ok "stowed: bkg"
}

# ─── Phase 5: Flatpaks ───────────────────────────────────
install_flatpaks() {
    if ! command -v flatpak &>/dev/null; then
        warn "flatpak not installed — skipping"
        return
    fi

    info "Adding Flathub remote..."
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

    info "Installing flatpak apps..."
    while IFS= read -r app; do
        flatpak install -y flathub "$app" || warn "Failed to install flatpak: $app"
    done < <(_pkg_list "$DOTS_DIR/.flatpak-S.list")

    ok "Flatpaks done"
}

# ─── Phase 6: Services ───────────────────────────────────
_enable() {
    # Enable a service, silently skip if unit doesn't exist
    systemctl enable --now "$1" 2>/dev/null && ok "enabled: $1" || warn "skipped (not found): $1"
}

enable_services() {
    info "Enabling common services..."
    _enable NetworkManager
    _enable bluetooth
    _enable cups
    _enable bpftune
    _enable ananicy-cpp
    _enable "dmemcg-booster-system"
    _enable systemd-oomd
    _enable power-profiles-daemon
    _enable "snapper-timeline.timer"
    _enable "snapper-cleanup.timer"
    _enable "limine-snapper-sync.service"
    _enable greetd
    _enable docker

    if [[ "$MACHINE" == surface ]]; then
        info "Enabling Surface-specific services..."
        _enable iptsd
        _enable tlp
        _enable iio-sensor-proxy
        _enable thermald
    fi

    # psd is a user service
    systemctl --user enable --now psd 2>/dev/null && ok "enabled: psd (user)" || warn "skipped (not found): psd"

    ok "Services done"
}

# ─── Phase 7: Snapper ────────────────────────────────────
setup_snapper() {
    info "Configuring snapper..."
    if [[ ! -f /etc/snapper/configs/root ]]; then
        sudo snapper -c root create-config / && ok "snapper: root config created"
    else
        ok "snapper: root config already exists"
    fi
}

# ─── Phase 7d: Extra disks (desktop) ────────────────────
setup_extra_disks() {
    [[ "${MACHINE:-}" != "desktop" ]] && return
    info "Configuring extra disks (desktop)..."

    _add_fstab() {
        local uuid="$1" mnt="$2" fstype="$3" opts="$4" pass="$5"
        if grep -q "UUID=$uuid" /etc/fstab; then
            ok "fstab: $mnt already present"
            return
        fi
        sudo mkdir -p "$mnt"
        printf 'UUID=%s %s %s %s 0 %s\n' "$uuid" "$mnt" "$fstype" "$opts" "$pass" \
            | sudo tee -a /etc/fstab > /dev/null
        ok "fstab: added $mnt"
    }

    # nofail + device-timeout: a missing/dead secondary disk must never block boot.
    # nvme0n1p1 — 3.4T ext4, label 'data'
    _add_fstab "150b328c-7d61-4efd-9740-0ad395b4ab27" /mnt/data ext4 "defaults,noatime,nofail,x-systemd.device-timeout=10" 2

    # sda2 — 461.8G btrfs
    _add_fstab "694d092d-8f7c-4bfb-9d60-34742ab760a3" /mnt/sda btrfs "defaults,noatime,compress=zstd:1,nofail,x-systemd.device-timeout=10" 0

    sudo systemctl daemon-reload
    local mnt_err
    if mnt_err=$(sudo mount -a 2>&1); then
        ok "Extra disks mounted"
    else
        warn "mount -a had errors — check fstab:"
        echo "$mnt_err"
    fi
}

# ─── Phase 7a: Greeter ───────────────────────────────────
setup_keyboard() {
    info "Setting X11/XWayland keyboard layout (us intl)..."
    sudo localectl set-x11-keymap us pc105 intl \
        && ok "X11 keymap set: us intl (dead keys enabled)" \
        || warn "localectl failed — XWayland apps may lack dead key support"
}

setup_greeter() {
    if ! command -v dms &>/dev/null; then
        warn "dms not found — skipping greeter setup"
        return
    fi
    info "Configuring DMS greeter (greetd)..."
    dms greeter install --yes && ok "DMS greeter configured" || warn "DMS greeter setup failed — run manually: dms greeter install"

    info "Ensuring DMS greeter cache dir..."
    sudo mkdir -p /var/cache/dms-greeter
    sudo chown greeter:greeter /var/cache/dms-greeter
    ok "greeter cache dir ready"

    info "Syncing DMS theme/settings with greeter..."
    dms greeter sync && ok "DMS greeter synced" || warn "DMS greeter sync failed — run manually: dms greeter sync"
}

# ─── DMS config import/export ───────────────────────────
# DMS owns ~/.config/niri/dms/ and overwrites symlinks — can't stow it.
# Auto-generated by DMS (theme/display changes): colors.kdl, outputs.kdl
# User-editable overrides tracked in repo: everything else
DMS_LIVE="$HOME/.config/niri/dms"
DMS_REPO="$DOTS_DIR/niri/.config/niri/dms"
DMS_MANUAL=(alttab.kdl binds.kdl cursor.kdl layout.kdl windowrules.kdl wpblur.kdl)

dms_export() {
    if [[ ! -d "$DMS_LIVE" ]]; then
        warn "DMS live dir not found: $DMS_LIVE — skipping"
        return
    fi
    info "Exporting DMS config: live → repo..."
    cp "$DMS_LIVE"/*.kdl "$DMS_REPO/"
    ok "DMS export done — commit dots/niri/.config/niri/dms/ to save"
}

dms_import() {
    if [[ ! -d "$DMS_LIVE" ]]; then
        warn "DMS live dir not found: $DMS_LIVE — run 'dms setup' first"
        return
    fi
    info "Importing DMS manual overrides: repo → live..."
    for f in "${DMS_MANUAL[@]}"; do
        if [[ -f "$DMS_REPO/$f" ]]; then
            cp "$DMS_REPO/$f" "$DMS_LIVE/$f"
            ok "imported: $f"
        else
            warn "not in repo: $f"
        fi
    done
    ok "DMS import done"
}

# ─── Phase 7b: DMS Plugins ───────────────────────────────
install_dms_plugins() {
    if ! command -v dms &>/dev/null; then
        warn "dms not found — skipping plugin install"
        return
    fi

    local list="$DOTS_DIR/.dms-plugins.list"
    if [[ ! -f "$list" ]]; then
        warn ".dms-plugins.list not found — skipping"
        return
    fi

    info "Installing DMS plugins..."
    local installed
    installed=$(dms plugins list 2>/dev/null)

    while IFS= read -r plugin; do
        [[ -z "$plugin" || "$plugin" == \#* ]] && continue
        if echo "$installed" | grep -q "ID: $plugin"; then
            ok "already installed: $plugin"
        else
            dms plugins install "$plugin" 2>/dev/null \
                && ok "installed: $plugin" \
                || warn "failed to install: $plugin"
        fi
    done < "$list"

    ok "DMS plugins done"
}

# ─── Phase 7c: Install scripts ───────────────────────────
run_install_scripts() {
    local list="$DOTS_DIR/.install-scripts.list"
    [[ -f "$list" ]] || { warn ".install-scripts.list not found — skipping"; return; }

    info "Running install scripts..."
    while IFS= read -r cmd; do
        [[ -z "$cmd" || "$cmd" == \#* ]] && continue
        info "Running: $cmd"
        bash -c "$cmd" && ok "done: $cmd" || warn "failed: $cmd"
    done < "$list"
}

# ─── Phase 7e: Fish plugins (tide prompt) ────────────────
# fish_variables is NOT tracked (tide writes a per-session prompt cache that
# would churn git endlessly), so the prompt is reproduced here instead.
setup_fish() {
    command -v fish &>/dev/null || { warn "fish not installed — skipping fish setup"; return; }
    if ! fish -c 'functions -q fisher' 2>/dev/null; then
        warn "fisher not found — add 'fisher' to .paru-S-common.list; skipping"
        return
    fi

    info "Installing fish plugins (tide)..."
    fish -c 'fisher install IlanCosman/tide@v6' >/dev/null 2>&1 \
        && ok "fish plugin: tide" \
        || warn "tide install failed — run manually: fisher install IlanCosman/tide@v6"

    # Configure only on first setup so later manual tweaks aren't overwritten.
    if fish -c 'set -q _tide_left_items' 2>/dev/null; then
        ok "tide already configured"
    else
        info "Applying tide rainbow preset..."
        fish -c "tide configure --auto --style=Rainbow --prompt_colors='True color' --show_time='24-hour format' --rainbow_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='One line' --prompt_connection=Disconnected --powerline_right_prompt_frame=No --prompt_connection_andor_frame_color=Lightest --prompt_spacing=Sparse --icons='Many icons' --transient=No" \
            && ok "tide configured (rainbow)" \
            || warn "tide configure failed — run manually: tide configure"
    fi

    # Apply theme colors — idempotent, runs every bootstrap so colors
    # survive tide reconfigures. Source: dank-theme.toml blue/steel palette.
    info "Applying blue/steel tide colors..."
    fish -c "
        set -U tide_os_bg_color                  1c2430
        set -U tide_os_color                     9dcbfb
        set -U tide_context_bg_color             101e2c
        set -U tide_context_color_default        839fbc
        set -U tide_pwd_bg_color                 124a73
        set -U tide_pwd_color_anchors            e0e2e8
        set -U tide_pwd_color_dirs               e0e2e8
        set -U tide_pwd_color_truncated_dirs     5c6370
        set -U tide_git_bg_color                 1a3a28
        set -U tide_git_color_branch             e0e2e8
        set -U tide_git_color_dirty              e0e2e8
        set -U tide_git_color_staged             e0e2e8
        set -U tide_git_color_untracked          e0e2e8
        set -U tide_git_color_upstream           e0e2e8
        set -U tide_git_bg_color_unstable        3a3010
        set -U tide_git_bg_color_urgent          3a1010
        set -U tide_character_color              9dcbfb
        set -U tide_character_color_failure      d75a59
        set -U tide_status_bg_color              101e2c
        set -U tide_status_color                 8ed88c
        set -U tide_status_color_failure         d75a59
        set -U tide_prompt_color_frame_and_connection 124a73
        set -U tide_prompt_color_separator_same_color 4087bc
    " && ok "tide colors: blue/steel" \
      || warn "tide color set failed — run manually: set -U tide_pwd_bg_color 124a73"
}

# ─── Phase 8: Claude Code ────────────────────────────────
setup_claude() {
    if ! command -v claude &>/dev/null; then
        warn "claude-code not in PATH — skipping plugin setup"
        return
    fi

    info "Setting up Claude Code plugins..."
    # settings.json is already stowed and sets enabledPlugins.
    # These commands install the plugin assets (skills, hook scripts).
    claude plugin marketplace add JuliusBrussee/caveman 2>/dev/null || true
    claude plugin install caveman --scope user 2>/dev/null \
        && ok "plugin: caveman" \
        || warn "caveman plugin install failed — run manually: claude plugin marketplace add JuliusBrussee/caveman && claude plugin install caveman --scope user"

    claude plugin install superpowers@claude-plugins-official --scope user 2>/dev/null \
        && ok "plugin: superpowers" \
        || warn "superpowers plugin install failed — run manually: claude plugin install superpowers@claude-plugins-official --scope user"

    claude plugin marketplace add safishamsi/graphify 2>/dev/null || true
    claude plugin install graphify --scope user 2>/dev/null \
        && ok "plugin: graphify" \
        || warn "graphify plugin install failed — run manually: claude plugin marketplace add safishamsi/graphify && claude plugin install graphify --scope user"
}

# ─── Phase 8: Projects ───────────────────────────────────
clone_projects() {
    local list="$DOTS_DIR/projects.list"
    [[ -f "$list" ]] || { warn "projects.list not found — skipping"; return; }

    info "Cloning projects into ~/Projects/..."
    mkdir -p "$HOME/Projects"
    while IFS= read -r repo; do
        [[ -z "$repo" || "$repo" == \#* ]] && continue
        local name; name=$(basename "$repo" .git)
        if [[ -d "$HOME/Projects/$name" ]]; then
            ok "already exists: $name"
        else
            git clone "$repo" "$HOME/Projects/$name" && ok "cloned: $name" || warn "failed: $repo"
        fi
    done < "$list"
}

# ─── Maintenance: swap broken packages ───────────────────
_swap_pkg() {
    local old="$1" new="$2"
    if pacman -Qi "$old" &>/dev/null; then
        info "Swapping $old → $new..."
        sudo pacman -Rdd --noconfirm "$old" 2>/dev/null || true
        paru -S --needed --noconfirm "$new"
        ok "swapped: $old → $new"
    fi
}

# ─── Maintenance: system update ──────────────────────────
system_update() {
    info "Swapping known broken/replaced packages..."
    _swap_pkg spotify            spotify-launcher
    _swap_pkg libreoffice-fresh  libreoffice-still

    refresh_mirrors

    info "Updating all packages..."
    paru -Syuu --noconfirm
    ok "System up to date"
}

# ─── Maintenance: cache cleanup ──────────────────────────
clean_caches() {
    info "Cleaning package caches..."
    sudo paccache -rk2
    sudo paccache -ruk0
    rm -rf "$HOME/.cache/paru/clone" "$HOME/.cache/paru" "$HOME/.cache/yay"
    ok "Caches cleaned"
}

# ─── Maintenance: foreign packages + orphan removal ──────
check_foreign_orphans() {
    info "Checking foreign (AUR) packages..."
    local foreign
    foreign=$(pacman -Qm 2>/dev/null || true)
    if [[ -n "$foreign" ]]; then
        echo "$foreign"
        echo "$foreign" > "$HOME/foreign-pkgs.txt"
        ok "Saved to ~/foreign-pkgs.txt"
    else
        ok "No foreign packages"
    fi

    info "Checking for orphaned packages..."
    local orphans
    orphans=$(paru -Qdtq 2>/dev/null || true)
    if [[ -z "$orphans" ]]; then
        ok "No orphans found"
        return
    fi
    echo "$orphans"
    if ! $INTERACTIVE; then warn "Skipped orphan removal (non-interactive)"; return; fi
    read -rp "Remove the above orphans? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { warn "Skipped"; return; }
    echo "$orphans" | sudo pacman -Rns -
    ok "Orphans removed"
}

# ─── Maintenance: python rebuild check ───────────────────
check_python_rebuilds() {
    info "Checking Python packages needing rebuild..."
    local current_version
    current_version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    ok "Current Python: $current_version"

    local old_dirs
    old_dirs=$(ls -d /usr/lib/python3.* 2>/dev/null | grep -v "python${current_version}" || true)
    if [[ -z "$old_dirs" ]]; then
        ok "No old Python directories found"
        return
    fi

    local all_packages=""
    for dir in $old_dirs; do
        local dir_packages
        dir_packages=$(pacman -Qoq "$dir" 2>/dev/null || true)
        if [[ -n "$dir_packages" ]]; then
            warn "Packages with files in $dir:"
            echo "$dir_packages"
            all_packages="$all_packages $dir_packages"
        fi
    done

    local unique_packages
    unique_packages=$(echo "$all_packages" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs 2>/dev/null || true)
    if [[ -z "$unique_packages" ]]; then
        ok "No packages need rebuilding"
        return
    fi

    warn "Packages needing Python rebuild: $unique_packages"
    if ! $INTERACTIVE; then warn "Skipped Python rebuild (non-interactive)"; return; fi
    read -rp "Rebuild? [y/N]: " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { warn "Skipped"; return; }
    paru -S --noconfirm $unique_packages
    ok "Python rebuild done"
}

# ─── Maintenance: rebuild check ──────────────────────────
check_rebuilds() {
    if ! command -v checkrebuild &>/dev/null; then
        warn "checkrebuild not found — install rebuild-detector"
        return
    fi
    info "Checking for packages needing rebuild..."
    local out
    out=$(checkrebuild 2>/dev/null || true)
    if [[ -z "$out" ]]; then
        ok "No rebuilds needed"
    else
        warn "Packages needing rebuild:"
        echo "$out"
    fi
}

# ─── Maintenance: kernel management ─────────────────────
manage_kernels() {
    info "Installed kernels:"
    pacman -Q | grep "^linux-cachyos" || echo "  (none)"
    echo ""
    info "Available CachyOS kernels:"
    pacman -Ss "^linux-cachyos" 2>/dev/null \
        | grep "^cachyos" \
        | grep -v "headers\|docs\|nvidia\|zfs\|virtualbox" \
        || echo "  (run 'pacman -Ss linux-cachyos' to see all)"
    echo ""

    read -rp "Install a kernel? [y/N]: " ic
    if [[ "$ic" =~ ^[Yy]$ ]]; then
        read -rp "Package name (e.g. linux-cachyos-lts): " kernel_pkg
        [[ -n "$kernel_pkg" ]] && sudo paru -S "$kernel_pkg" "${kernel_pkg}-headers"
    fi

    read -rp "Remove a kernel? [y/N]: " rc
    if [[ "$rc" =~ ^[Yy]$ ]]; then
        read -rp "Package name to remove: " remove_pkg
        if [[ -n "$remove_pkg" ]]; then
            local running_kernel; running_kernel=$(uname -r)
            if pacman -Q "$remove_pkg" 2>/dev/null | grep -q "$running_kernel"; then
                warn "Cannot remove running kernel ($running_kernel) — reboot first"
            else
                sudo pacman -R "$remove_pkg" "${remove_pkg}-headers" 2>/dev/null \
                    || sudo pacman -R "$remove_pkg"
            fi
        fi
    fi
    ok "Kernel management done"
}

# ─── Maintenance: pacnew files ───────────────────────────
check_pacnew() {
    info "Checking for pacnew files..."
    if command -v pacdiff &>/dev/null; then
        pacdiff -o || true
    else
        warn "pacdiff not found — install pacman-contrib"
    fi
}

# ─── Maintenance: firmware updates ───────────────────────
check_firmware() {
    if ! command -v fwupdmgr &>/dev/null; then
        warn "fwupdmgr not found — install fwupd"
        return
    fi
    info "Checking firmware updates..."
    fwupdmgr refresh --force 2>/dev/null || true
    fwupdmgr get-updates 2>/dev/null || ok "No firmware updates available"
}

# ─── Phase 9: Summary ────────────────────────────────────
print_manual_steps() {
    echo ""
    echo -e "${YEL}════════════════════════════════════════════${NC}"
    echo -e "${YEL}  Manual steps required after this script   ${NC}"
    echo -e "${YEL}════════════════════════════════════════════${NC}"
    echo ""
    echo "  1. Git identity:"
    echo "       git config --global user.name 'Viridjan'"
    echo "       git config --global user.email 'viridjan@users.noreply.github.com'"
    echo ""
    echo "  2. SSH key:"
    echo "       ssh-keygen -t ed25519 -C viridjan"
    echo "       # Add ~/.ssh/id_ed25519.pub to GitHub"
    echo ""
    echo "  3. Fingerprint (if fprintd is installed):"
    echo "       fprintd-enroll"
    echo ""
    echo "  4. DankMaterialShell init (required before starting niri):"
    echo "       dms setup"
    echo "       # This generates ~/.config/niri/dms/*.kdl"
    echo "       # Without it niri will fail to start (missing dms includes)"
    echo "       # Then overlay repo overrides (binds, layout, etc.):"
    echo "       vjupdate --dms-import"
    echo ""
    echo "  5. Bitwarden: log in via the app or browser extension"
    echo ""
    echo "  6. YubiKey: set PIN if not already configured"
    echo "       ykman fido access change-pin"
    echo ""
    if [[ "${MACHINE:-}" == surface ]]; then
        echo "  7. Surface Secure Boot:"
        echo "       # Enroll linux-surface MOK key to allow the kernel to boot"
        echo "       # Follow: https://github.com/linux-surface/linux-surface/wiki/Installation-and-Setup"
        echo ""
    fi
    echo "  8. Open Notebook (if needed):"
    echo "       cd ~/Projects/Open_notebook && docker compose up -d"
    echo ""
    echo "  9. Maintenance (update, cache, orphans):"
    echo "       vjupdate --update"
    echo ""
    echo -e "${GRN}  Bootstrap complete for: $MACHINE${NC}"
    echo ""
}

# ─── Main ────────────────────────────────────────────────
bootstrap() {
    echo ""
    echo -e "${BLU}╔═════════════════════════════════════╗${NC}"
    echo -e "${BLU}║      vjupdate — CachyOS setup       ║${NC}"
    echo -e "${BLU}╚═════════════════════════════════════╝${NC}"
    echo ""

    detect_machine
    _ensure_dots_repo
    if $INTERACTIVE; then
        local _phases=(
            paru keyrings surface-repo mirrors packages dotfiles dms-import
            flatpaks services snapper extra-disks keyboard greeter dms-plugins
            install-scripts fish claude projects
            system-update clean-caches orphans rebuilds python-rebuilds pacnew firmware
        )
        echo -e "${BLU}  #   Phase${NC}"
        echo    "  ──────────────────────"
        local _i=1
        for _p in "${_phases[@]}"; do
            printf "  %2d) %s\n" "$_i" "$_p"
            (( _i++ ))
        done
        echo ""
        read -rp "Skip phases (numbers, space-separated, q to quit, Enter to run all): " _skip_nums
        [[ "$_skip_nums" =~ ^[qQ] ]] && { warn "Aborted."; exit 0; }
        SKIP_PHASES=""
        for _n in $_skip_nums; do
            local _idx=$(( _n - 1 ))
            [[ $_idx -ge 0 && $_idx -lt ${#_phases[@]} ]] && SKIP_PHASES+="${_phases[$_idx]} "
        done
        echo ""
    fi
    _run_phase "paru"            install_paru
    _run_phase "keyrings"        reset_keyrings
    _run_phase "surface-repo"    setup_linux_surface_repo
    _run_phase "mirrors"         refresh_mirrors
    _run_phase "packages"        install_packages
    _run_phase "dotfiles"        deploy_dotfiles
    _run_phase "dms-import"      dms_import
    _run_phase "flatpaks"        install_flatpaks
    _run_phase "services"        enable_services
    _run_phase "snapper"         setup_snapper
    _run_phase "extra-disks"     setup_extra_disks
    _run_phase "keyboard"        setup_keyboard
    _run_phase "greeter"         setup_greeter
    _run_phase "dms-plugins"     install_dms_plugins
    _run_phase "install-scripts" run_install_scripts
    _run_phase "fish"            setup_fish
    _run_phase "claude"          setup_claude
    _run_phase "projects"        clone_projects
    _run_phase "system-update"   system_update
    _run_phase "clean-caches"    clean_caches
    _run_phase "orphans"         check_foreign_orphans
    _run_phase "rebuilds"        check_rebuilds
    _run_phase "python-rebuilds" check_python_rebuilds
    _run_phase "pacnew"          check_pacnew
    _run_phase "firmware"        check_firmware
    print_manual_steps
}

maintenance() {
    echo ""
    echo -e "${BLU}╔═════════════════════════════════════╗${NC}"
    echo -e "${BLU}║      vjupdate — maintenance         ║${NC}"
    echo -e "${BLU}╚═════════════════════════════════════╝${NC}"
    echo ""

    system_update
    clean_caches
    check_foreign_orphans
    check_rebuilds
    check_python_rebuilds
    check_pacnew
    check_firmware
}

usage() {
    echo "Usage: vjupdate [--yes | --update | --kernels | --dms-export | --dms-import | --help]"
    echo ""
    echo "  (no args)           Full run (bootstrap + maintenance), interactive"
    echo "  --interactive, -i   Same as no args (explicit)"
    echo "  --yes, -y           Full run, non-interactive (skip all prompts)"
    echo "  --update, -u        Maintenance only: update, caches, orphans, rebuilds, firmware"
    echo "  --kernels           Interactively install or remove CachyOS kernels"
    echo "  --dms-export        Copy live ~/.config/niri/dms/*.kdl → repo (then commit)"
    echo "  --dms-import        Copy repo dms overrides → live (skips auto-generated files)"
    echo "  --help              Show this message"
}

case "${1:-}" in
    --interactive|-i) INTERACTIVE=true;  bootstrap ;;
    --yes|-y)         INTERACTIVE=false; bootstrap ;;
    --update|-u)      maintenance ;;
    --kernels)        manage_kernels ;;
    --dms-export)     dms_export ;;
    --dms-import)     dms_import ;;
    --help|-h)        usage ;;
    "")               bootstrap ;;
    *)                die "Unknown option: $1. Use --help." ;;
esac
