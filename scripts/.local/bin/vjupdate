}
phase_install()  { install_all; }
phase_dotfiles() { deploy_dotfiles; dms_import; }
# _multiselect HEADER ITEM...
# Items prefixed with ':' are non-selectable group headers.
# Items prefixed with '+' are pre-selected ('+' stripped from display and output).
# Prints newline-separated selected items to stdout. All TUI output goes to /dev/tty.
# Returns 1 if user cancels (esc / q / ctrl-c).
_multiselect() {
    local _header="$1"; shift
    local -a _items=("$@")
    local _n=${#_items[@]}
    local -a _sel=()
    local _cursor=0 _i _key _esc

    for (( _i=0; _i<_n; _i++ )); do
        if [[ "${_items[$_i]}" == +* ]]; then
            _sel+=( true )
            _items[$_i]="${_items[$_i]:1}"
        else
            _sel+=( false )
        fi
    done

    # Position cursor on first selectable item
    for (( _i=0; _i<_n; _i++ )); do
        [[ "${_items[$_i]}" != :* ]] && { _cursor=$_i; break; }
    done

    _ms_draw() {
        tput cup 3 0 >/dev/tty
        for (( _i=0; _i<_n; _i++ )); do
            local _item="${_items[$_i]}"
            if [[ "$_item" == :* ]]; then
                printf "\033[36m  %s\033[0m\n" "${_item:1}" >/dev/tty
            else
                local _pfx="  " _chk
                [[ $_i -eq $_cursor ]] && _pfx="\033[36m❯ \033[0m"
                ${_sel[$_i]} && _chk="\033[32m●\033[0m" || _chk="\033[90m○\033[0m"
                printf " %b %b %s\n" "$_pfx" "$_chk" "$_item" >/dev/tty
            fi
        done
        printf "\n\033[90m  ↑↓ navigate · space toggle · enter confirm · q abort\033[0m\n" >/dev/tty
    }

    tput civis >/dev/tty
    tput clear >/dev/tty
    printf "  \033[34m%s\033[0m\n\n" "$_header" >/dev/tty
    _ms_draw

    while true; do
        IFS= read -rsn1 _key </dev/tty
        if [[ "$_key" == $'\x1b' ]]; then
            IFS= read -rsn1 -t 0.1 _esc </dev/tty
            if [[ "$_esc" == '[' ]]; then
                IFS= read -rsn1 -t 0.1 _key </dev/tty
                case "$_key" in
                A) for (( _i=_cursor-1; _i>=0; _i-- )); do
                       [[ "${_items[$_i]}" != :* ]] && { _cursor=$_i; break; }
                   done ;;
                B) for (( _i=_cursor+1; _i<_n; _i++ )); do
                       [[ "${_items[$_i]}" != :* ]] && { _cursor=$_i; break; }
                   done ;;
                esac
            else
                tput cnorm >/dev/tty; return 1
            fi
        elif [[ "$_key" == ' ' ]]; then
            ${_sel[$_cursor]} && _sel[$_cursor]=false || _sel[$_cursor]=true
        elif [[ "$_key" == '' ]]; then
            break
        elif [[ "$_key" == 'q' || "$_key" == $'\x03' ]]; then
            tput cnorm >/dev/tty; return 1
        fi
        _ms_draw
    done

    tput cnorm >/dev/tty
    local _out=""
    for (( _i=0; _i<_n; _i++ )); do
        ${_sel[$_i]} && _out+="${_items[$_i]}"$'\n'
    done
    printf '%s' "$_out"
}

_configure_items_multiselect() {
    _multiselect "additional configuration" \
        ":── System ──────────────────────────────────" \
        "services — Enable system services (NetworkManager, bluetooth, etc.)" \
        "snapper — Configure btrfs snapshots" \
        "automount — Detect and add partitions to /etc/fstab" \
        "keyboard — Set X11 keyboard layout (us intl)" \
        "keyring-pam — Configure gnome-keyring PAM integration" \
        ":── DMS ─────────────────────────────────────" \
        "greeter — Configure DMS greeter (greetd)" \
        "dms-plugins — Install DMS plugins" \
        ":── Shell & tools ───────────────────────────" \
        "fish — Set up fish shell and tide theme" \
        "install-scripts — Run custom install scripts" \
        "claude — Install Claude Code plugins" \
        "caveman-code — Install caveman-code npm tool" \
        ":── AI & VMs ────────────────────────────────" \
        "ollama — Pull ollama AI model (desktop only)" \
        "vms — Pull VM Docker images (Windows/macOS)" \
        ":── Maintenance ─────────────────────────────" \
        "orphan-removal — Remove orphaned packages (audit)" \
        "python-rebuild — Rebuild Python packages needing rebuild (audit)"
}

_bootstrap_multiselect() {
    _multiselect "vjupdate — CachyOS setup" \
        ":── Essentials ──────────────────────────────" \
        "+sources — paru · keyrings · mirror ranking · flathub remote · clone repos" \
        "+install — conflict removal · full upgrade · pacman/flatpak/AUR · cache cleanup" \
        "+dotfiles — stow symlinks · DMS config import" \
        "+audit — orphan pkgs · flatpak cleanup · rebuild check · pacnew · firmware" \
        ":── One-time configs ────────────────────────" \
        ":  System ─────────────────────────────────" \
        "services — Enable system services (NetworkManager, bluetooth, etc.)" \
        "snapper — Configure btrfs snapshots" \
        "automount — Detect and add partitions to /etc/fstab" \
        "keyboard — Set X11 keyboard layout (us intl)" \
        "keyring-pam — Configure gnome-keyring PAM integration" \
        ":  DMS ─────────────────────────────────────" \
        "greeter — Configure DMS greeter (greetd)" \
        "dms-plugins — Install DMS plugins" \
        ":  Shell & tools ───────────────────────────" \
        "fish — Set up fish shell and tide theme" \
        "install-scripts — Run custom install scripts" \
        "claude — Install Claude Code plugins" \
        "caveman-code — Install caveman-code npm tool" \
        ":  AI & VMs ────────────────────────────────" \
        "ollama — Pull ollama AI model (desktop only)" \
        "vms — Pull VM Docker images (Windows/macOS)" \
        ":  Maintenance ─────────────────────────────" \
        "orphan-removal — Remove orphaned packages (audit)" \
        "python-rebuild — Rebuild Python packages needing rebuild (audit)"
}

phase_configure() {
    local _selected

    if $CONFIGURE_PROMPTED; then
        _selected="$CONFIGURE_ITEMS"
    elif ! $INTERACTIVE; then
        run_install_scripts
        setup_fish
        return
    else
        _selected=$(_configure_items_multiselect) || { warn "cancelled: configure"; return; }
    fi

    _sel() { echo "$_selected" | grep -q "^$1 —"; }

    _sel "services"        && enable_services
    _sel "snapper"         && setup_snapper
    _sel "automount"       && automount_disks
    _sel "keyboard"        && setup_keyboard
    _sel "greeter"         && setup_greeter
    _sel "keyring-pam"     && setup_keyring_pam
    _sel "install-scripts" && run_install_scripts
    _sel "fish"            && setup_fish
    _sel "dms-plugins"     && install_dms_plugins
    _sel "claude"          && setup_claude
    _sel "caveman-code"    && setup_caveman_code
    _sel "ollama"          && setup_ollama
    _sel "vms"             && setup_vms
    _sel "orphan-removal"  && AUDIT_ORPHAN_REMOVAL=true
    _sel "python-rebuild"  && AUDIT_PYTHON_REBUILD=true
}
phase_update()   { system_update; flatpak_update; clean_caches; }
phase_audit()    { check_foreign_orphans; check_flatpak_orphans; check_rebuilds; check_python_rebuilds; check_pacnew; check_firmware; }

# ─── Main ────────────────────────────────────────────────
bootstrap() {
    echo ""
    echo -e "${BLU}╔═════════════════════════════════════╗${NC}"
    echo -e "${BLU}║      vjupdate — CachyOS setup       ║${NC}"
    echo -e "${BLU}╚═════════════════════════════════════╝${NC}"
    echo ""

    detect_machine
    _ensure_dots_repo
    if $INTERACTIVE; then
        SKIP_PHASES=""
        local _selected
        _selected=$(_bootstrap_multiselect) || { warn "Aborted."; exit 0; }

        local _phase_keys=(sources install dotfiles audit)
        for _p in "${_phase_keys[@]}"; do
            echo "$_selected" | grep -q "^$_p —" || SKIP_PHASES+="$_p "
        done

        CONFIGURE_ITEMS=$(echo "$_selected" | grep -vE "^(sources|install|dotfiles|audit) —" || true)
        if [[ -n "$CONFIGURE_ITEMS" ]]; then
            CONFIGURE_PROMPTED=true
        else
            SKIP_PHASES+="configure "
        fi

        echo -e "${BLU}  essentials:${NC}"
        echo "$_selected" | grep -E "^(sources|install|dotfiles|audit) —" | sed 's/^/    /' || true
        if [[ -n "$CONFIGURE_ITEMS" ]]; then
            echo -e "${BLU}  one-time configs:${NC}"
            echo "$CONFIGURE_ITEMS" | sed 's/^/    /'
        fi
        echo ""
    fi
    _run_phase "sources"   phase_sources
    _run_phase "install"   phase_install
    _run_phase "dotfiles"  phase_dotfiles
    _run_phase "configure" phase_configure
    _run_phase "audit"     phase_audit
    print_recap
    print_manual_steps
}

update() {
    echo ""
    echo -e "${BLU}╔═════════════════════════════════════╗${NC}"
    echo -e "${BLU}║      vjupdate — update              ║${NC}"
    echo -e "${BLU}╚═════════════════════════════════════╝${NC}"
    echo ""

    detect_machine
    system_update
    flatpak_update
    check_flatpak_orphans
    clean_caches
    print_recap
}

check() {
    echo ""
    echo -e "${BLU}╔═════════════════════════════════════╗${NC}"
    echo -e "${BLU}║      vjupdate — check               ║${NC}"
    echo -e "${BLU}╚═════════════════════════════════════╝${NC}"
    echo ""

    check_foreign_orphans
    check_rebuilds
    check_python_rebuilds
    check_pacnew
    check_firmware
    print_recap
}

usage() {
    echo "Usage: vjupdate [OPTION]"
    echo ""
    echo "  (no args)           Full bootstrap, interactive"
    echo "  --interactive, -i   Same as no args (explicit)"
    echo "  --yes, -y           Full bootstrap, non-interactive"
    echo "  --update, -u        Update packages + clean caches"
    echo "  --check, -c         Audit: orphans, rebuilds, pacnew, firmware"
    echo "  --kernels           Interactively install or remove CachyOS kernels"
    echo "  --automount         Detect internal partitions and add to /etc/fstab
  --keyring-pam       Add pam_gnome_keyring.so to /etc/pam.d/greetd (idempotent)"
    echo "  --dms-export        Copy live ~/.config/niri/dms/*.kdl → repo (then commit)"
    echo "  --dms-import        Copy repo dms overrides → live (skips auto-generated files)"
    echo "  --help              Show this message"
}

case "${1:-}" in
    --interactive|-i) INTERACTIVE=true;  bootstrap ;;
    --yes|-y)         INTERACTIVE=false; bootstrap ;;
    --update|-u)      update ;;
    --check|-c)       check ;;
    --kernels)        manage_kernels ;;
    --automount)      detect_machine; automount_disks ;;
    --keyring-pam)    setup_keyring_pam ;;
    --dms-export)     dms_export ;;
    --dms-import)     dms_import ;;
    --help|-h)        usage ;;
    "")               bootstrap ;;
    *)                die "Unknown option: $1. Use --help." ;;
esac
