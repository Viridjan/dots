#!/bin/bash
set -euo pipefail

# Re-execute as root if not already, preserving the calling user
if [[ $EUID -ne 0 ]]; then
    exec sudo VJUPD_USER="$USER" "$0" "$@"
fi

REAL_USER="${VJUPD_USER:-${SUDO_USER:-root}}"
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
STAMP_DIR="/var/lib/vjupd"
mkdir -p "$STAMP_DIR"

_needs_run() {
    local stamp="$STAMP_DIR/$1"
    [[ ! -f "$stamp" ]] && return 0
    local age=$(( $(date +%s) - $(date -r "$stamp" +%s) ))
    (( age > 172800 ))
}
_mark_done() { touch "$STAMP_DIR/$1"; }

# Action flags
DO_CLEAN=false
DO_ORPHANS=false
DO_UPDATE=false
DO_REBUILDS=false
DO_PYTHON_REBUILD=false
DO_PACNEW=false
DO_FIRMWARE=false
DO_KERNEL=false
RUN_ALL=false

# Modifier flags
USE_PACMAN=false
AUTO_REBUILD=false

# =============================================================================
# Helper Functions
# =============================================================================

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

CachyOS system update and maintenance script.

Options:
  -c, --clean          Clean package and build caches
  -o, --orphans        List foreign (AUR) packages and remove orphans
  -u, --update         Full system update including AUR (uses paru)
  -r, --rebuilds       List packages that need rebuilding
  -y, --python-rebuild Check Python packages needing rebuild after version upgrade
  -p, --pacnew         List pacnew files needing attention
  -f, --firmware       Check for firmware updates (fwupd)
  -k, --kernel         Manage CachyOS kernels (list, install, remove)
  -a, --all            Run all actions (default if no options given, excludes -k)
  -h, --help           Show this help message

Modifiers:
  -P, --pacman         Use pacman only (official repos, no AUR)
  -R, --auto-rebuild   Rebuild packages with outdated dependencies (with confirmation)

Examples:
  $(basename "$0")           # Run all actions
  $(basename "$0") -u        # Update only
  $(basename "$0") -c -u     # Clean caches and update
  $(basename "$0") -u -P     # Update official repos only (pacman)
  $(basename "$0") -r -R     # Check and rebuild outdated packages
  $(basename "$0") -k        # Manage kernels
EOF
}

print_section() {
    echo ""
    echo "$1"
    echo "----------------------------------------------"
}

# =============================================================================
# Core Functions
# =============================================================================

clean_caches() {
    print_section "Cleaning Package and Build Caches..."

    # Remove stale pacman lock
    rm -f /var/lib/pacman/db.lck

    # Clear pacman cache (keep last 2 versions for rollback)
    paccache -rk2
    paccache -ruk0

    # Clear paru build/clone cache
    rm -rf "$USER_HOME/.cache/paru/clone"

    # Clear old yay cache if present
    rm -rf "$USER_HOME/.cache/yay" 2>/dev/null || true

    echo "Caches cleaned."
}

check_foreign_orphans() {
    print_section "Checking for foreign and orphaned packages..."

    # List AUR/foreign packages
    local foreign_pkgs
    foreign_pkgs=$(pacman -Qm)

    if [[ -n "$foreign_pkgs" ]]; then
        echo "Foreign (AUR) packages:"
        echo "$foreign_pkgs"
        echo ""
        echo "Saved to $USER_HOME/foreign-pkgs.txt"
        echo "$foreign_pkgs" > "$USER_HOME/foreign-pkgs.txt"
    else
        echo "No foreign packages found."
    fi

    # Remove true orphans
    local orphans
    orphans=$(sudo -u "$SUDO_USER" paru -Qdtq 2>/dev/null || true)

    if [[ -n "$orphans" ]]; then
        echo ""
        echo "Orphaned packages:"
        echo "$orphans"
        echo ""
        read -r -p "Remove orphans? (y/n): " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            echo "$orphans" | xargs paru -Rns --noconfirm
        fi
    else
        echo "No orphaned packages found."
    fi
}

_swap_pkg() {
    local old="$1" new="$2"
    if pacman -Qi "$old" &>/dev/null; then
        echo "Swapping $old → $new..."
        sudo -u "$SUDO_USER" paru -Rdd --noconfirm "$old" 2>/dev/null || true
        sudo -u "$SUDO_USER" paru -S --needed --noconfirm "$new"
        echo "Swapped: $old → $new"
    fi
}

perform_update() {
    print_section "Performing update..."

    # Swap known broken/replaced packages before update
    _swap_pkg spotify            spotify-launcher
    _swap_pkg libreoffice-fresh  libreoffice-still

    # Refresh mirrors (rate-mirrors bundled with CachyOS) — gated to 48h
    if command -v rate-mirrors &>/dev/null; then
        if _needs_run mirrors; then
            echo "Refreshing mirrors..."
            rate-mirrors --allow-root --protocol https cachyos \
                | tee /etc/pacman.d/cachyos-mirrorlist > /dev/null || true
            rate-mirrors --allow-root --protocol https arch \
                | tee /etc/pacman.d/mirrorlist > /dev/null || true
            _mark_done mirrors
            echo "Mirrors refreshed."
        else
            echo "Mirror refresh skipped (< 48h ago)."
        fi
    fi

    if $USE_PACMAN; then
        echo "Updating official repos only (pacman)..."
        pacman -Syuu --noconfirm
    else
        echo "Updating all packages including AUR (paru)..."
        # paru must run as non-root
        sudo -u "$SUDO_USER" paru -Syuu --noconfirm
    fi
}

check_rebuilds() {
    print_section "Packages that may need rebuilding:"

    if ! command -v checkrebuild &>/dev/null; then
        echo "checkrebuild not found — install rebuild-detector"
        return 0
    fi

    local rebuild_output
    rebuild_output=$(checkrebuild 2>/dev/null || true)

    if [[ -z "$rebuild_output" ]]; then
        echo "No packages need rebuilding."
        return 0
    fi

    echo "$rebuild_output"

    if $AUTO_REBUILD; then
        local packages
        packages=$(echo "$rebuild_output" | awk '{print $2}')
        echo ""
        echo "Packages to rebuild: $packages"
        read -r -p "Rebuild? (y/n): " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            sudo -u "$SUDO_USER" paru -S --noconfirm $packages
        fi
    fi
}

check_python_rebuilds() {
    print_section "Checking for Python packages needing rebuild..."

    local current_version
    current_version=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    echo "Current Python: $current_version"

    local old_dirs
    old_dirs=$(ls -d /usr/lib/python3.* 2>/dev/null | grep -v "python${current_version}" || true)

    if [[ -z "$old_dirs" ]]; then
        echo "No old Python directories found."
        return 0
    fi

    echo "Old Python directories:"
    echo "$old_dirs"
    echo ""

    local all_packages=""
    for dir in $old_dirs; do
        local dir_packages
        dir_packages=$(pacman -Qoq "$dir" 2>/dev/null || true)
        if [[ -n "$dir_packages" ]]; then
            echo "Packages with files in $dir:"
            echo "$dir_packages"
            all_packages="$all_packages $dir_packages"
        fi
    done

    local unique_packages
    unique_packages=$(echo "$all_packages" | tr ' ' '\n' | sort -u | tr '\n' ' ' | xargs)

    if [[ -z "$unique_packages" ]]; then
        echo "No packages need rebuilding."
        return 0
    fi

    if $AUTO_REBUILD; then
        echo "Packages to rebuild for Python $current_version:"
        echo "$unique_packages" | tr ' ' '\n'
        read -r -p "Rebuild? (y/n): " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            sudo -u "$SUDO_USER" paru -S --noconfirm $unique_packages
        fi
    fi
}

check_pacnew() {
    print_section "Pacnew files that may require attention:"
    pacdiff -o
}

check_firmware() {
    print_section "Checking for firmware updates (fwupd)..."
    fwupdmgr refresh --force
    fwupdmgr get-updates || echo "No firmware updates available."
}

manage_kernels() {
    print_section "CachyOS Kernel Management"

    echo "Installed kernels:"
    pacman -Q | grep "^linux-cachyos" || echo "  (none matching linux-cachyos*)"
    echo ""

    echo "Available CachyOS kernels:"
    # Query available kernel packages from the CachyOS repo
    pacman -Ss "^linux-cachyos" 2>/dev/null \
        | grep "^cachyos" \
        | grep -v "headers\|docs\|nvidia\|zfs\|virtualbox" \
        || echo "  (run 'pacman -Ss linux-cachyos' to see all)"
    echo ""

    read -r -p "Install a kernel? (y/n): " install_confirm
    if [[ "$install_confirm" =~ ^[Yy]$ ]]; then
        read -r -p "Package name (e.g. linux-cachyos-lts, linux-cachyos-bore): " kernel_pkg
        if [[ -n "$kernel_pkg" ]]; then
            paru -S "$kernel_pkg" "${kernel_pkg}-headers"
        fi
    fi

    echo ""
    read -r -p "Remove a kernel? (y/n): " remove_confirm
    if [[ "$remove_confirm" =~ ^[Yy]$ ]]; then
        echo "Installed kernels:"
        pacman -Q | grep "^linux-cachyos"
        echo ""
        read -r -p "Package name to remove: " remove_pkg
        if [[ -n "$remove_pkg" ]]; then
            local running_kernel
            running_kernel=$(uname -r)
            if pacman -Q "$remove_pkg" 2>/dev/null | grep -q "$running_kernel"; then
                echo "Warning: cannot remove currently running kernel ($running_kernel). Reboot first."
            else
                pacman -R "$remove_pkg" "${remove_pkg}-headers" 2>/dev/null || pacman -R "$remove_pkg"
            fi
        fi
    fi

    echo ""
    echo "Kernel management complete."
}

# =============================================================================
# Main
# =============================================================================

main() {
    echo ""
    echo "╔════════════════════════════════╗"
    echo "║   CachyOS system maintenance   ║"
    echo "╚════════════════════════════════╝"

    $RUN_ALL || $DO_CLEAN         && clean_caches
    $RUN_ALL || $DO_ORPHANS       && check_foreign_orphans
    $RUN_ALL || $DO_UPDATE        && perform_update
    $RUN_ALL || $DO_REBUILDS      && check_rebuilds
    $RUN_ALL || $DO_PYTHON_REBUILD && check_python_rebuilds
    $RUN_ALL || $DO_PACNEW        && check_pacnew
    $RUN_ALL || $DO_FIRMWARE      && check_firmware
    # Kernel management excluded from --all (requires user decisions)
    $DO_KERNEL                    && manage_kernels

    echo ""
    echo "Done."
}

# =============================================================================
# Argument Parsing
# =============================================================================

if [[ $# -eq 0 ]]; then
    RUN_ALL=true
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clean)          DO_CLEAN=true ;;
        -o|--orphans)        DO_ORPHANS=true ;;
        -u|--update)         DO_UPDATE=true ;;
        -r|--rebuilds)       DO_REBUILDS=true ;;
        -y|--python-rebuild) DO_PYTHON_REBUILD=true ;;
        -p|--pacnew)         DO_PACNEW=true ;;
        -f|--firmware)       DO_FIRMWARE=true ;;
        -k|--kernel)         DO_KERNEL=true ;;
        -a|--all)            RUN_ALL=true ;;
        -P|--pacman)         USE_PACMAN=true ;;
        -R|--auto-rebuild)   AUTO_REBUILD=true ;;
        -h|--help)           usage; exit 0 ;;
        *) echo "Unknown option: '$1'" >&2; usage >&2; exit 1 ;;
    esac
    shift
done

main
