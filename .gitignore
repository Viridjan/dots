# Fish runtime state
fish/.config/fish/fish_history
# Universal vars — tide writes a per-session prompt cache here; the prompt is
# reproduced by vjupdate's setup_fish instead. Don't track.
fish/.config/fish/fish_variables*


# VSCodium — binary caches and Chromium session state (volatile, machine-specific)
VSCodium/.config/VSCodium/Cache/
VSCodium/.config/VSCodium/CachedData/
VSCodium/.config/VSCodium/Code Cache/
VSCodium/.config/VSCodium/Crashpad/
VSCodium/.config/VSCodium/DawnGraphiteCache/
VSCodium/.config/VSCodium/DawnWebGPUCache/
VSCodium/.config/VSCodium/Dictionaries/
VSCodium/.config/VSCodium/GPUCache/
VSCodium/.config/VSCodium/Local Storage/
VSCodium/.config/VSCodium/Session Storage/
VSCodium/.config/VSCodium/Shared Dictionary/
VSCodium/.config/VSCodium/Cookies
VSCodium/.config/VSCodium/Cookies-journal
VSCodium/.config/VSCodium/DIPS
VSCodium/.config/VSCodium/DIPS-wal
VSCodium/.config/VSCodium/Network Persistent State
VSCodium/.config/VSCodium/TransportSecurity
VSCodium/.config/VSCodium/Trust Tokens
VSCodium/.config/VSCodium/Trust Tokens-journal

# VM storage (Docker volumes — disk images, not config)
windows/storage/
macos/storage/

# Vesktop runtime state
vesktop/.config/vesktop/Crashpad/
vesktop/.config/vesktop/sessionData/
vesktop/.config/vesktop/Singleton*
vesktop/.config/vesktop/state.json
vesktop/.config/vesktop/themes/

# Ghostty backups
ghostty/.config/ghostty/config.backup.*

# graphify — knowledge graph output (generated, not config)
graphify-out/

# Claude Code — credentials only (never commit API keys)
claude/.claude/.credentials.json

# caveman-code — runtime state and credentials
cave/.cave/agent/auth.json
cave/.cave/agent/sessions/
