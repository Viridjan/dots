# ─────────────────────────────────────────────────────────
# Secrets only. Everything else is tracked on purpose so a
# fresh clone carries maximum config/state. Audited 2026-06-21:
# no tokens/keys found in any other tracked file.
# ─────────────────────────────────────────────────────────

# Credentials / API keys
claude/.claude/.credentials.json
cave/.cave/agent/auth.json

# Session / auth tokens
cave/.cave/agent/sessions/
gomuks/.config/gomuks/config.yaml
vesktop/.config/vesktop/sessionData/

# VSCodium — cookie / token / web-storage stores (hold auth for logged-in webviews)
VSCodium/.config/VSCodium/Cookies
VSCodium/.config/VSCodium/Cookies-journal
VSCodium/.config/VSCodium/Local Storage/
VSCodium/.config/VSCodium/Session Storage/
VSCodium/.config/VSCodium/Trust Tokens
VSCodium/.config/VSCodium/Trust Tokens-journal

# Shell history — may contain secrets typed at the prompt
fish/.config/fish/fish_history

# Crash dumps — can contain credentials lifted from process memory
vesktop/.config/vesktop/Crashpad/
VSCodium/.config/VSCodium/Crashpad/

# Single-instance runtime lock (socket/symlink) — a stale copy breaks vesktop launch on clone
vesktop/.config/vesktop/Singleton*
