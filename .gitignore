# ─────────────────────────────────────────────────────────
# Secrets only. Everything else is tracked on purpose so a
# fresh clone carries maximum config/state. Audited 2026-07-28
# after an OpenVSX token leaked via workspaceStorage/state.vscdb.
# ─────────────────────────────────────────────────────────

# Credentials / API keys
claude/.claude/.credentials.json
cave/.cave/agent/auth.json

# Session / auth tokens
cave/.cave/agent/sessions/
vesktop/.config/vesktop/sessionData/

# VSCodium — cookie / token / web-storage stores (hold auth for logged-in webviews)
VSCodium/.config/VSCodium/Cookies
VSCodium/.config/VSCodium/Cookies-journal
VSCodium/.config/VSCodium/Local Storage/
VSCodium/.config/VSCodium/Session Storage/
VSCodium/.config/VSCodium/Trust Tokens
VSCodium/.config/VSCodium/Trust Tokens-journal

# VSCodium — per-workspace SQLite state; extensions (e.g. OpenVSX marketplace)
# store access tokens in here (caused a leaked-secret incident 2026-07-28)
VSCodium/.config/VSCodium/User/workspaceStorage/

# Shell history — may contain secrets typed at the prompt
fish/.config/fish/fish_history

# Crash dumps — can contain credentials lifted from process memory
vesktop/.config/vesktop/Crashpad/
VSCodium/.config/VSCodium/Crashpad/

# Single-instance runtime lock (socket/symlink) — a stale copy breaks vesktop launch on clone
vesktop/.config/vesktop/Singleton*

# Window bounds — churns every session, no clone value
vesktop/.config/vesktop/state.json

# Large vendored binaries — installed by their own installer/updater, not
# tracked in git (bloats history permanently for no clone value)
scripts/.local/bin/uv
scripts/.local/bin/uvx
scripts/.local/bin/claude-science

# VSCodium Chromium/Electron caches — regenerated on every launch, so they
# rewrote 24 files per commit and grew history forever (41.5MB of ~60MB, 68%).
# Not config: User/ keeps settings, keybindings, snippets and globalStorage.
VSCodium/.config/VSCodium/Cache/
VSCodium/.config/VSCodium/CachedData/
VSCodium/.config/VSCodium/CachedProfilesData/
VSCodium/.config/VSCodium/CachedExtensionVSIXs/
VSCodium/.config/VSCodium/GPUCache/
VSCodium/.config/VSCodium/DawnGraphiteCache/
VSCodium/.config/VSCodium/DawnWebGPUCache/
VSCodium/.config/VSCodium/Code Cache/

# vesktop — same Electron/Chromium V8 code cache, rewritten every launch
vesktop/.config/vesktop/Code Cache/
