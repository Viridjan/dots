// ────────────── Waybar Configuration ──────────────
// Waybar is a highly customizable Wayland status bar.
// Reference: https://github.com/Alexays/Waybar/wiki
// Note: waybar is not auto-started (commented out in autostart.kdl).
// DMS provides its own bar — enable waybar there if you prefer it.
// Waybar supports JSONC (JSON with // and /* */ comments).

{
  // Which layer to render on: "top" | "bottom" | "overlay"
  "layer": "top",

  // Screen edge to anchor the bar to: "top" | "bottom" | "left" | "right"
  "position": "top",

  // Bar height in pixels. 0 = auto-size to font.
  "height": 34,

  // Pixel gap between modules.
  "spacing": 6,

  // Modules rendered on the left, center, and right sections.
  // Full module list: https://github.com/Alexays/Waybar/wiki/Module:-Clock etc.
  "modules-left": ["niri/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],

  // ── Workspace indicator ────────────────────────────────────────────────────
  "niri/workspaces": {
    // Display format for each workspace button. {name} = workspace name/number.
    "format": "{name}",
    // Click a workspace button to focus it.
    "on-click": "activate",
    // Show workspaces from all outputs, not just the current one.
    "all-outputs": true
  },

  // ── Clock ─────────────────────────────────────────────────────────────────
  "clock": {
    // strftime format. Common tokens: %H hour, %M minute, %d day, %m month, %Y year.
    "format": "{:%H:%M  %d/%m}",
    // Show a tooltip on hover (displays the full date/time).
    "tooltip": true
  },

  // ── CPU usage ─────────────────────────────────────────────────────────────
  "cpu": {
    // {usage} = total CPU usage %. {load} = 1-min load average.
    "format": " {usage}%",
    // Update interval in seconds.
    "interval": 2
  },

  // ── Memory usage ──────────────────────────────────────────────────────────
  "memory": {
    // {} = used memory %. {total} = total RAM. {used} = used in GiB.
    "format": " {}%",
    "interval": 5
  },

  // ── Network ───────────────────────────────────────────────────────────────
  "network": {
    // Format strings for each connection state.
    // {signalStrength} = Wi-Fi signal %. {essid} = network name. {ipaddr} = IP.
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀 connected",
    "format-disconnected": "⚠ offline"
  },

  // ── Audio (PulseAudio / PipeWire) ─────────────────────────────────────────
  "pulseaudio": {
    // {volume} = volume %. {desc} = sink description. {format_source} = mic.
    "format": "  {volume}%",
    "format-muted": " muted",
    // Command to open volume mixer on click.
    "on-click": "pavucontrol"
  },

  // ── System tray ───────────────────────────────────────────────────────────
  "tray": {
    // Pixel gap between tray icons.
    "spacing": 10
  }
}
